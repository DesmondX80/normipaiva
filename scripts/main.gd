## Näkyvän maanpinnan nosto hahmon kohdalla (Character.ground_lift): tiet ja pihat piirretään maaston yläpuolelle, ja
## seisova hahmo nostetaan sen verran. Saloisissa world.surface_lift, Vaalassa vaala.gd surface_lift (Vaalan koordinaatit).
## Vain maaston korkeudella olevat hahmot: sisätilat ja minipelien lavasteet ovat muualla, eivätkä ne nouse.
func _ground_lift(pos: Vector3) -> float:
	if _in_vaala and mopo_trip != null and is_instance_valid(mopo_trip.vaala):
		var vl: Node3D = mopo_trip.vaala
		var lp := vl.to_local(pos)
		if absf(lp.y - float(vl.h(lp.x, lp.z))) > 0.3:
			return 0.0
		return vl.surface_lift(lp)
	if world == null or absf(pos.y - Terrain.h(pos.x, pos.z)) > 0.3:
		return 0.0
	return world.surface_lift(pos)


## Koulukeskuksen ovi: perjantai-iltana disko, muulloin kyltti kertoo ajan. Palauttaa true, kun ovella.
func _koulu_disko_logic() -> bool:
	if world.koulu_ovi_pos == Vector3.ZERO:
		return false
	var p := player.global_position
	if Vector2(p.x - world.koulu_ovi_pos.x, p.z - world.koulu_ovi_pos.z).length() > 2.8:
		return false
	tilat.first("koulu_disko_kuultu", 0.0)
	if _weekday() != DISKO_VIIKONPAIVA or not _between(clock_min, DISKO_AIKA):
		_hint.text = "Koulukeskus. Ovessa lappu: KOULUDISKO perjantaisin 18–21, DJ kadoksissa – vapaaehtoisia kaivataan!"
		return true
	if _disko_day == day:
		_hint.text = "Koulun disko on soitettu tältä illalta. Lapset kertovat siitä vielä maanantaina."
		return true
	_hint.text = "[E] Koulun disko: DJ puuttuu! Lupaudu kasettien pyörittäjäksi"
	if Input.is_action_just_pressed("interact"):
		_start_koulu_disko()
	return true


func _start_koulu_disko() -> void:
	_mokki_prev = state
	state = "cutscene"
	player.controls_enabled = false
	player.speed = 0.0
	_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	_hud.visible = false
	Sfx.play("door", -6.0)
	var anchor := Node3D.new()
	add_child(anchor)
	anchor.global_position = world.koulu_ovi_pos
	var g := KouluDisko.new()
	g.anchor = anchor
	g.sun = _sun
	g.player_look = Looks.player()
	g.maine = maine
	g.finished.connect(func(r: Dictionary) -> void:
		anchor.queue_free()
		_koulu_disko_done(r))
	add_child(g)


func _koulu_disko_done(r: Dictionary) -> void:
	state = _mokki_prev
	player.activate_camera()
	player.controls_enabled = true
	_hazards.process_mode = Node.PROCESS_MODE_INHERIT
	_hud.visible = true
	_disko_day = day
	if r.get("luovutti", false):
		maine = clampf(maine - 1.0, 0.0, 100.0)
		_show_message("Lähdit diskosta kesken. Opettaja joutui laittamaan radion soimaan. Maine −1.", 4.0)
		_save_game()
		return
	_advance_clock(DISKO_KESTO)
	tilat.first("koulun_disko", 0.4)
	var rep := int(r.get("rep", 0))
	maine = clampf(maine + rep, 0.0, 100.0)
	tilat.add("moraali", 0.1 if rep > 0 else 0.0)
	tilat.add("stressi", 0.1 if rep > 0 else -0.05)
	tilat.add("stamina", -0.1)
	var ope := ""
	if r.get("opettaja") == true:
		ope = "  Opettaja sai polkkansa."
	elif r.get("opettaja") == false:
		ope = "  Opettaja jäi ilman polkkaa."
	_show_message("Koulun disko: \"%s\". Tanssilattia keskimäärin %.1f/%d.%s%s" % [r.get("title", ""), float(r.get("lattia", 0.0)),
		KouluDisko.KIDS, "   Maine %+d." % rep if rep != 0 else "", ope], 5.0)
	_save_game()


func _start_pingis_nuoret() -> void:
	_mokki_prev = state
	state = "cutscene"
	player.controls_enabled = false
	player.speed = 0.0
	_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	_hud.visible = false
	Sfx.play("pickup", -6.0, 1.3)
	var game := PingisGame.new()
	game.position = PINGIS_POS
	game.venue = "koulu"
	game.opp_name = "KYLÄN NUORET"
	game.opp_title = ""
	game.opp_look = NUORET_LOOK
	game.opp_skill = minf(0.72 + 0.06 * _pingis_nuoret_voitot, 0.96)
	game.opp_lines = PINGIS_NUORET_LINES
	game.finished.connect(func(won: bool, me: int, him: int) -> void:
		game.queue_free()
		state = _mokki_prev
		player.activate_camera()
		player.controls_enabled = true
		_hazards.process_mode = Node.PROCESS_MODE_INHERIT
		_hud.visible = true
		tilat.first("pingis", 0.3)
		tilat.add("stamina", -0.1)
		tilat.add("nalka", -0.05)
		var first_today := _pingis_nuoret_day != day
		_pingis_nuoret_day = day
		if won:
			_pingis_nuoret_voitot += 1
			tilat.first("pingis_nuoret_voitto", 0.3)
			if first_today:
				maine = clampf(maine + 3.0, 0.0, 100.0)
				tilat.add("moraali", 0.15)
				tilat.add("stressi", 0.1)
			_show_message("Voitit nuoret %d–%d! Nuoret tarjoavat limut. Maine nousee: \"Setä on ihan ok.\"" % [me, him], 4.0)
		else:
			var paid := money >= LIMU_HINTA
			if paid:
				money -= LIMU_HINTA
			elif first_today:
				maine = clampf(maine - 2.0, 0.0, 100.0)
			tilat.add("stressi", 0.05)
			_show_message("Hävisit nuorille %d–%d. %s" % [me, him, "Tarjoat limut (%s €)." % _eur(LIMU_HINTA) if paid else "Rahat ei riitä limuihin, nuoret naureskelevat."], 4.0)
		_save_game())
	add_child(game)


## Pieneläintuhkaamo Lemmikki Enkelit (#148): muistolehto (penkki, lyhdyt, nimikyltit), Pörrön muistokyltti pojille ja Pekan
## hetki portilla. Lämmin ja kunnioittava sävy.
func _lemmikki_tasks() -> Array:
	if lemmikki.stage != "kerrottu":
		return []
	return [["Pörrön muistokyltti: maalaa kyltti Lemmikki Enkelien muistolehtoon (kylän länsiosa)", false]]


func _lemmikki_logic() -> void:
	if lemmikki == null or world == null or world.lehto_pos == Vector3.ZERO:
		return
	if is_instance_valid(boys):
		boys.calm = lemmikki.valmis()
	if world.lehto_plate != null:
		world.lehto_plate.visible = lemmikki.valmis()
	if _hint.text != "" or player != walker_out or player.is_stunned():
		return
	var p := player.global_position
	var near := func(at: Vector3, r: float) -> bool: return Vector2(p.x - at.x, p.z - at.z).length() < r
	# Pekka käy illalla portilla vaan katsomassa (kerran).
	if not lemmikki.pekka and near.call(world.lehto_portti_pos, 5.0) and _between(clock_min, LemmikkiEnkelit.PEKKA_AIKA):
		lemmikki.pekka = true
		tilat.first("lemmikki_pekka", 0.3)
		tilat.add("moraali", 0.1)
		_save_game()
		_queue_message("Pekka seisoo portilla. \"Onko tuolla yleinen sauna? Piippu savuaa. ...Aha. Ei ole. Anteeks, perkele, anteeksi.\"", 5.5)
		_queue_message("Pekka: \"Mää tulin vaan katsomaan. Väinö on jo vanha, ja mää pelkään, että se karkaa taas. Tai että... no. Täällä on rauhallista.\"", 6.0)
		_queue_message("Pekka: \"Mutta se on kotona. Se on kunnossa. Se on vaan vanha koira. Mene sää vaan, mää istun hetken.\"", 5.5)
	if near.call(world.lehto_penkki_pos, 2.0):
		tilat.first("lemmikki_enkelit", 0.2)
		_hint.text = "[E] Istu penkille hetkeksi%s" % ("  (kalja jää laukkuun, täällä ei avata)" if beers > 0 else "")
		if Input.is_action_just_pressed("interact"):
			if lemmikki.penkki_day != day:
				lemmikki.penkki_day = day
				tilat.add("stressi", 0.25)
				tilat.add("moraali", 0.05)
				_advance_clock(20.0)
				_show_message("Penkillä on hiljaista. Kynttilät lepattavat, nimikylteissä lemmikkien nimiä. Ei täällä. Stressi hellittää.", 4.5)
			else:
				_show_message("Istut hetken hiljaa. Tänään on jo riittänyt.", 2.5)
			_save_game()
		return
	if near.call(world.lehto_pos, 2.8):
		if lemmikki.stage == "kerrottu":
			_hint.text = "[E] Maalaa muistokyltti Pörrölle (pojat odottavat)"
			if Input.is_action_just_pressed("interact"):
				_start_muistokyltti()
		else:
			_hint.text = "Muistolehto: kynttilälyhtyjä ja nimikylttejä (Misu, Rekku, Nalle%s)." % (", Pörrö" if lemmikki.valmis() else "")


func _start_muistokyltti() -> void:
	player.controls_enabled = false
	player.speed = 0.0
	_hud.visible = false
	CamCtl.free_mouse = true
	var g := MuistokylttiGame.new()
	g.finished.connect(func(done: bool) -> void:
		CamCtl.free_mouse = false
		player.controls_enabled = true
		player.activate_camera()
		_hud.visible = true
		if not done:
			_show_message("Lauta jäi kesken. Pojat odottavat vielä.", 3.0)
			return
		lemmikki.stage = "valmis"
		maine = clampf(maine + 5.0, 0.0, 100.0)
		tilat.first("lemmikki_kyltti", 0.5)
		tilat.add("moraali", 0.3)
		tilat.add("stressi", 0.2)
		_ending("porron_kyltti")
		Sfx.play("win", -4.0)
		_save_game()
		_show_message("Pörrön muistokyltti seisoo lehdossa. Pojat lupaavat, etteivät heitä enää koskaan kiviä: \"Setä on ihan ok.\" Maine +5.", 6.0))
	add_child(g)


func _talk_lemmikki(id: String) -> void:
	match id:
		"lemmikki_kysy":
			lemmikki.stage = "kerrottu"
			tilat.first("lemmikki_pojat", 0.2)
			_save_game()
			_talk_box.reply("Pikkuveljen hamsteri Pörrö kuoli viime viikolla. Veli itkee, ja me ollaan oltu ihan kovaäänisiä, ettei kukaan huomaa. "
				+ "Lemmikki Enkelit hoiti sen. Ne antoi meille luvan tehdä muistokyltin lehtoon, mutta me ei osata maalata nimeä.", _talk_options(),
				"Pörrön muistokyltti: maalaa se Lemmikki Enkelien muistolehtoon (kylän länsiosassa, Pirtin lähellä).")
		"lemmikki_muistuta":
			_talk_box.reply("Lemmikki Enkelien pihalla, lehdossa. Siellä on jo Misun ja Rekun kyltit. Tarvitaan vaan nimi: Pörrö.", _talk_options())


func _kanttori_tasks() -> Array:
	if not kanttori.heard or kanttori.choice != "":
		return []
	var step := "vie nuotit Sinikan kuorolle tai Veksille"
	if not kanttori.savel:
		step = "käy yöllä (22–4) Kanttorilan pihalla kuuntelemassa"
	elif not kanttori.harmooni:
		step = "voita harmooni seuraintalon huutokaupassa (nuottiarkki palkeessa)"
	elif not kanttori.arkisto:
		step = "kysy toista nuottipuolikasta Saloisten Pirtistä"
	return [["Kanttorilan yösävel: " + step, false]]


func _kt_stream(kind: String) -> AudioStreamWAV:
	if not _kt_wav.has(kind):
		_kt_wav[kind] = KanttoriLegenda.tune(kind)
	return _kt_wav[kind]


func _kt_stop() -> void:
	if _kt_player != null and _kt_player.playing:
		_kt_player.stop()
	_kt_phase = 0


func _kanttori_logic() -> void:
	if kanttori == null or world == null or world.kanttorila_pos == Vector3.ZERO:
		return
	if _kt_player == null:
		_kt_player = AudioStreamPlayer3D.new()
		_kt_player.unit_size = 8.0
		_kt_player.max_distance = 70.0
		_kt_player.volume_db = -4.0
		add_child(_kt_player)
		_kt_player.global_position = world.kanttorila_pos + Vector3(0, 2.0, 2.0)
		_kt_choir = AudioStreamPlayer.new()
		add_child(_kt_choir)
	var p := player.global_position
	var kp: Vector3 = world.kanttorila_pos
	var dist := Vector2(p.x - kp.x, p.z - kp.z).length()
	var night := _between(clock_min, KanttoriLegenda.NIGHT)
	var active: bool = kanttori.heard and night and not kanttori.silent() and state == "ulkona" and dist < 60.0
	if not active:
		if _kt_phase != 0:
			_kt_stop()
		return
	_kt_t += get_process_delta_time()
	if _kt_phase == 0:
		_kt_t = 0.0
		if not kanttori.teinit:
			_kt_phase = 1
			_kt_player.stream = _kt_stream("kaiutin")
			_kt_player.play()
		else:
			_kt_phase = 2
			_kt_player.stream = _kt_stream("urut")
			_kt_player.play()
	elif _kt_phase == 1 and not _kt_player.playing:
		kanttori.teinit = true
		tilat.first("kanttori_teinit", 0.2)
		_save_game()
		_show_message("Kanttorilan ikkunan alla teinien kaiutin... Teinit kyllästyvät ja lähtevät. Mutta sävel jatkuu: urkuja, vaikka talossa ei ole urkuja.", 6.0)
		_kt_phase = 2
		_kt_player.stream = _kt_stream("urut")
		_kt_player.play()
	elif _kt_phase == 2:
		if not _kt_player.playing:
			_kt_player.play()
		if not kanttori.savel and dist < 25.0 and _kt_t > 3.0:
			kanttori.savel = true
			tilat.first("kanttori_savel", 0.3)
			_save_game()
			_show_message("Oikea yösävel: hitaat urut Kanttorilan seinien sisältä. Kanttorin kadonnut virsi? Nuotit pitää löytää: huutokaupan harmooni ja Pirtin arkisto.", 7.0)
	if _hint.text == "" and dist < 6.0 and kanttori.savel:
		_hint.text = "Urut soivat talon sisällä. Ei ketään ikkunassa."


func _kanttori_pirtti() -> void:
	if kanttori == null or not kanttori.heard or kanttori.arkisto or _hint.text != "":
		return
	if not _near_xz(world.museum_door, 3.0):
		return
	_hint.text = "[E] Saloisten Pirtti: kysy kanttorin nuottiarkistoa"
	if Input.is_action_just_pressed("interact"):
		kanttori.arkisto = true
		_kertun_sync()
		tilat.first("kanttori_arkisto", 0.2)
		_save_game()
		_show_message("Pirtin arkistosta löytyy kanttorin nuottiarkin toinen puolikas, kellastunut ja ruskeapilkkuinen: virren loppu. %s" % (
			"Nuotit ovat nyt koossa: vie ne Sinikan kuorolle." if kanttori.nuotit() else "Ensimmäinen puolikas on vielä harmoonissa seuranmäen huutokaupassa."), 7.0)


