func _label(layer: CanvasLayer, size: int) -> Label:
	var l := Label.new()
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_outline_color", Color.BLACK)
	l.add_theme_constant_override("outline_size", 8)
	layer.add_child(l)
	return l


func _centered_label(layer: CanvasLayer, size: int, anchor_y: float, top: float, bottom: float) -> Label:
	var l := _label(layer, size)
	l.anchor_left = 0.0
	l.anchor_right = 1.0
	l.anchor_top = anchor_y
	l.anchor_bottom = anchor_y
	l.offset_top = top
	l.offset_bottom = bottom
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	return l


## Viesti jonoon: näytetään, kun edellinen on ehtinyt näkyä loppuun.
## max_age = peliminuutit, joiden jälkeen jonossa odottanut viesti on vanha eikä näy (esim. kellonaikaviesti junamatkan
## yli); -1 = näytetään aina.
func _queue_message(text: String, seconds: float, max_age := -1.0) -> void:
	if _msg_time <= 0.0 and _hud.visible:
		_show_message(text, seconds)
		_queued_shown_frame = Engine.get_process_frames()
	else:
		_msg_queue.append([text, seconds, _awake_min(), max_age])


## Jonosta juuri (samassa ruudussa) näytetty viesti ei katoa saman ruudun suoralla viestillä: se palaa jonon kärkeen
## (esim. "UUSI!"-saavutus ja heti perään tulosviesti).
var _queued_shown_frame := -1


func _show_message(text: String, seconds: float) -> void:
	if Engine.get_process_frames() == _queued_shown_frame and _msg_time > 0.0 and _msg.text != text and _msg.text != "":
		_msg_queue.push_front([_msg.text, _msg_time])
		_queued_shown_frame = -1
	_msg.text = text
	_msg_time = seconds


func _eur(v: float) -> String:
	return ("%.2f" % v).replace(".", ",")


## Kellonaika tekstinä "14.30".
func _clock_text() -> String:
	return "%d.%02d" % [int(clock_min) / 60, int(clock_min) % 60]


func is_open(place: String, at := -1.0) -> bool:
	return _between(clock_min if at < 0.0 else at, OPEN_HOURS[place])


## "K-Market on kiinni, aukeaa klo 7" (ja aukioloaika), tai "" jos auki.
func closed_text(place: String, at := -1.0) -> String:
	if is_open(place, at):
		return ""
	var span: Vector2 = OPEN_HOURS[place]
	var verb := "alkaa" if place == "lava" else "aukeaa"
	return "%s on kiinni: %s klo %d (auki %d–%02d)." % [OPEN_NAMES[place], verb, int(span.x / 60.0), int(span.x / 60.0),
		int(span.y / 60.0)] if place != "lava" else "Lavatanssit alkaa klo %d (tanssit %d–%02d)." % [int(span.x / 60.0),
		int(span.x / 60.0), int(span.y / 60.0)]


## Sisällä sulkemisaikaan: kehotus lähteä, ja baareista ja lavalta ulos CLOSE_GRACE minuutin kuluttua.
func _closing_logic(place: String, say: String, out: Callable) -> void:
	if is_open(place):
		_closing_at = -1.0
		return
	if _closing_at < 0.0:
		_closing_at = clock_min
		_closing_nag = 0.0
		Sfx.play("alert", -10.0, 0.9)
		_show_message(say, 4.0)
		return
	var past := fposmod(clock_min - _closing_at, 1440.0)
	_closing_nag += get_process_delta_time()
	if out.is_valid() and past >= CLOSE_GRACE and not _talk_box.is_open():
		_closing_at = -1.0
		out.call()
	elif _closing_nag > 25.0:
		_closing_nag = 0.0
		_show_message(say, 3.0)


func _between(t: float, span: Vector2) -> bool:
	return t >= span.x and t < span.y if span.x < span.y else (t >= span.x or t < span.y)


## Auringon korkeus (astetta) kellonajasta: huippu klo 13.30 (n. 56°), alimmillaan klo 1.30 (n. −4°): kesäyö.
func _sun_elevation(t: float) -> float:
	return 26.0 + 30.0 * cos((t - 13.5 * 60.0) / 1440.0 * TAU)


## Aurinko, taivas, ympäristövalo, usva ja katuvalot kellon mukaan; Päivi ja naapurit.
func _day_rhythm() -> void:
	var t := clock_min
	if not cutscene.busy:
		var e := _sun_elevation(t)
		var day := clampf(e / 20.0, 0.0, 1.0)  # 0 = hämärä, 1 = täysi päivä
		var low := 1.0 - clampf(absf(e - 4.0) / 14.0, 0.0, 1.0)  # matala aurinko: oranssi
		_sun.rotation_degrees = Vector3(-maxf(e, 2.0), 145.0 + (t - 15.0 * 60.0) / 4.0, 0)
		_sun.light_color = Color(1.0, 0.93, 0.82).lerp(Color(1.0, 0.62, 0.35), low * 0.8).lerp(Color(0.55, 0.62, 0.9), 1.0 - clampf(e / 4.0 + 0.5, 0.0, 1.0))
		_sun.light_energy = lerpf(0.18, 1.35, smoothstep(-4.0, 16.0, e))
		var top := Color(0.08, 0.12, 0.3).lerp(Color(0.22, 0.42, 0.78), day)
		var hor := Color(0.32, 0.36, 0.52).lerp(Color(0.8, 0.85, 0.9), day).lerp(Color(0.98, 0.62, 0.42), low * 0.6)
		_sky_mat.set_shader_parameter("top_color", top)
		_sky_mat.set_shader_parameter("horizon_color", hor)
		_sky_mat.set_shader_parameter("cloud_light", Color(0.38, 0.4, 0.55).lerp(Color.WHITE, day).lerp(Color(1.0, 0.75, 0.6), low * 0.5))
		_env.ambient_light_energy = lerpf(0.45, 1.0, day)
		_env.fog_light_color = Color(0.74, 0.8, 0.88).lerp(hor, 0.6)
		_env.tonemap_exposure = lerpf(1.2, 1.05, day)
		# Sade mökin seudulla (Kaisuan sadepäivä): harmaa pilvikatto, himmeä aurinko ja sakeampi usva.
		var rain: float = mokki.kaisua.rain_amount if mokki != null and mokki.kaisua != null else 0.0
		if altaan != null:
			rain = maxf(rain, altaan.rain_amount)
		if _fog_density0 < 0.0:
			_fog_density0 = _env.fog_density
		_env.fog_density = lerpf(_fog_density0, maxf(_fog_density0, 0.55), rain)
		if rain > 0.0:
			var grey := Color(0.5, 0.53, 0.57) * lerpf(0.5, 1.0, day)
			_sun.light_energy *= 1.0 - 0.7 * rain
			_sky_mat.set_shader_parameter("top_color", top.lerp(grey * 0.85, rain * 0.9))
			_sky_mat.set_shader_parameter("horizon_color", hor.lerp(grey, rain * 0.9))
			_sky_mat.set_shader_parameter("cloud_light", Color(0.62, 0.64, 0.68).lerp(Color(0.35, 0.37, 0.42), 1.0 - day))
			_env.fog_light_color = _env.fog_light_color.lerp(grey, rain * 0.8)
		_sky_mat.set_shader_parameter("cloud_coverage", lerpf(0.5, 0.97, rain))
	if world.lamps != null:
		world.lamps.visible = _between(t, LAMPS_ON)
	# Naapurit yöllä sisällä (piilossa ovella), aamulla taas pihalla.
	var inside := _between(t, NEIGHBORS_INSIDE)
	for n in [arto, pekka, sinikka]:
		var away: bool = inside or (n == sinikka and _sinikka_away())
		if n != null and n.visible == away:
			n.visible = not away
			n.process_mode = Node.PROCESS_MODE_DISABLED if away else Node.PROCESS_MODE_INHERIT
			if away:
				n.global_position = n.yard[0]
	_wife_rhythm(t)


## Päivin auton yöpaikka: oman autotallin edessä nosturioven vieressä (ei ovella, ettei se tuki tallin ovea).
func _wife_park_pos() -> Vector3:
	var out: Vector3 = world.garage_out
	var p: Vector3 = world.garage_door + out.cross(Vector3.UP) * 3.3 + out * 2.4
	return Vector3(p.x, Terrain.h(p.x, p.z), p.z)  # auton origo on renkaiden alapinnassa (wife_car.gd _drive)


## Päivin partiokohteet: [nimi, paikka (karttapikseli), perustodennäköisyys]. Kauppa painavampi: sinne pelaaja menee
## kaljalle joka päivä.
const WIFE_SPOTS := [["kauppa", M.SHOP_ZONE, 2.0], ["reippari", M.REIPPARI, 1.0], ["seo", M.SEO, 1.0],
	["kentta", M.KENTTA, 1.0], ["hongan", M.HONGAN_KENTTA, 1.0], ["seuraintalo", M.SEURAINTALO, 1.0],
	["uimaranta", M.UIMARANTA, 0.8], ["saastopiha", M.SAASTOPIHA, 0.8], ["seppo", M.SEPPO, 0.6], ["koti", M.HOME_ZONE, 1.0]]
const WIFE_RUMOR_R := 150.0  # tämän lähellä käynyt pelaaja "nähtiin siellä"
const WIFE_RUMOR_MIN := 90.0  # juoru elää pelimin.
var _wife_rumor := {}  # kohde -> pelimin. (päivä * 1440 + kello), jolloin pelaaja oli viimeksi lähellä
var _wife_rumor_t := 0.0


## Kirjaa, minkä partiokohteen lähellä pelaaja on (kerran sekunnissa): kylällä puhutaan, ja juoru kulkee Päiville.
func _wife_note_player(p: Vector3) -> void:
	_wife_rumor_t -= get_process_delta_time()
	if _wife_rumor_t > 0.0:
		return
	_wife_rumor_t = 1.0
	for s in WIFE_SPOTS:
		var q := M.w2(s[1])
		if Vector2(p.x - q.x, p.z - q.y).length() < WIFE_RUMOR_R:
			_wife_rumor[s[0]] = day * 1440.0 + clock_min


## Päivin seuraava partiokohde: painotettu arvonta. Paikka, jossa pelaaja on käynyt viime aikoina, on moninkertaisesti
## todennäköisempi (juoru haalistuu WIFE_RUMOR_MIN:ssä); juuri käytyyn ei palata heti.
func _wife_dest() -> Vector3:
	var now := day * 1440.0 + clock_min
	var cur: Vector3 = wife.dest
	var total := 0.0
	var ws: Array[float] = []
	for s in WIFE_SPOTS:
		var q := M.w(s[1])
		var w: float = s[2]
		if _wife_rumor.has(s[0]):
			w += 5.0 * clampf(1.0 - (now - float(_wife_rumor[s[0]])) / WIFE_RUMOR_MIN, 0.0, 1.0)
		if cur != Vector3.ZERO and Vector2(q.x - cur.x, q.z - cur.z).length() < 60.0:
			w = 0.0
		ws.append(w)
		total += w
	var r := randf() * total
	for i in WIFE_SPOTS.size():
		r -= ws[i]
		if r <= 0.0:
			return M.w(WIFE_SPOTS[i][1])
	return M.w(WIFE_SPOTS[0][1])


## Päivi: koko päivän teillä (partio), kotona vain nukkumassa WIFE_HOME (auto pihassa, ei jahtaa). Vaihtuu vain,
## kun Päivi ei ole jahtaamassa. Anna-Liisan hälytys vie hänet heti kaupalle (_on_busted, _wife_bust_arrive).
## Luku 6 (#326): kun Päivi tutkii, hän ajaa iltaisin "jumppaan" seuraintalolle (rikos/paivi_tutkii.gd jumppa_aika).
func _wife_rhythm(t: float) -> void:
	if wife == null or not is_instance_valid(wife):
		return
	var want := "koti" if _between(t, WIFE_HOME) else "partio"
	var pt := rikos_osa("paivi_tutkii")
	if want == "partio" and pt != null and pt.jumppa_aika(t):
		want = "jumppa"
	var pakko := _kesaheila_wife()  # luku 6: auto kotona mittauksen ajan tai poissa, kun Päivi on äidillään
	if pakko != "":
		want = pakko
	if want == _wife_phase or (wife.mode == "chase" and pakko == ""):
		return
	var prev := _wife_phase
	_wife_phase = want
	if prev == "jumppa" and want == "partio":
		wife.end_jumppa()
	match want:
		"jumppa":
			wife.parked = false
			wife.visible = true
			wife.process_mode = Node.PROCESS_MODE_INHERIT
			wife.go_jumppa(_jumppa_parkki())
			if state == "ulkona" and not _at_mokki() and not _in_vaala:
				_queue_message("Päivi lähti \"jumppaan\" seuraintalolle. Hyundai ei nyt jahtaa, joten perään voi ajaa, kunhan pysyy kaukana.", 4.5)
		"koti":
			wife.reset_to(world.nearest_node(home_zone))
			wife.global_position = _wife_park_pos()
			wife.rotation.y = B.yaw_to(-world.garage_out)  # nokka talliin
			wife.parked = true
			wife.visible = true
			wife.process_mode = Node.PROCESS_MODE_INHERIT
		"poissa":
			wife.reset_to(world.nearest_node(home_zone))
			wife.global_position = _wife_park_pos()
			wife.parked = true
			wife.visible = false
			wife.process_mode = Node.PROCESS_MODE_DISABLED
		"partio":
			wife.parked = false
			if prev == "":
				wife.reset_to(wife.farthest_node_from(player.global_position))
			wife.visible = true
			wife.process_mode = Node.PROCESS_MODE_INHERIT
			if prev == "koti" and state == "ulkona" and not _at_mokki() and not _in_vaala:  # Vaalaan Päivi ei tule
				_queue_message("Päivi lähti liikkeelle. Punainen Hyundai on teillä!", 3.0)


## Valveilla oloa päivän alusta (min): yli puolenyön kello jatkaa yli 1440:n.
func _awake_min() -> float:
	var a := clock_min - DAY_START
	return a + 1440.0 if a < 0.0 else a


## Nukahtamisraja valveilla oloaikana: klo 2 + kahvin ja alkoholin siirto (enintään klo 4).
func _pass_out_limit() -> float:
	var extra := minf(NIGHT_EXTRA_MAX, _night_coffee * NIGHT_COFFEE + _humala_peak * NIGHT_DRUNK)
	return (PASS_OUT_AT + 1440.0 - DAY_START) + extra


## Kyydin valintaan varoitus, jos perillä ollaan lähellä nukahtamisrajaa (hop = matkan kesto minuutteina).
func _late_note(hop: float) -> String:
	var at := _awake_min() + hop
	if at < _pass_out_limit() - 30.0:
		return ""
	var arr := fmod(clock_min + hop, 1440.0)
	return " · perillä klo %d.%02d, %s" % [int(arr) / 60, int(arr) % 60,
		"nukahdat heti" if at >= _pass_out_limit() else "sammut pian"]


func _pass_out_text() -> String:
	var lim := fmod(_pass_out_limit() + DAY_START, 1440.0)
	return "%d.%02d" % [int(lim) / 60, int(lim) % 60]


## Kahvikuppi siirtää nukahtamista (kodin ja mökin kahvit, baarien kahvit).
func _coffee() -> void:
	_night_coffee += 1


const NIGHT_STATES := ["ulkona", "in_shop", "in_home", "in_garage", "in_mokki", "in_siitari", "in_raahe", "in_asema", "in_kirppis", "in_varasto", "in_retki"]


func _night_tick(delta: float) -> void:
	_humala_base = minf(_humala_base, tilat.value("humala"))
	_humala_peak = maxf(_humala_peak, tilat.value("humala") - _humala_base)
	if not state in NIGHT_STATES or cutscene.busy or get_tree().paused:
		return
	var awake := _awake_min()
	if awake >= EVENING_AT - DAY_START:
		tilat.add("vasymys", -0.004 * delta)  # ilta painaa
		if _night_warned < 1:
			_night_warned = 1
			# Vain klo 22–23: välikuvan (esim. junamatka) jälkeen myöhemmin ei enää kerrota kymmenestä.
			if awake < EVENING_AT - DAY_START + 60.0:
				_queue_message("Kello on kymmenen illalla. Alkaa olla myöhä – kahdelta silmät painuu kiinni, kahvi ja viina pitää hereillä.", 4.0, 45.0)
	var limit := _pass_out_limit()
	if awake >= limit - 30.0 and _night_warned < 2:
		_night_warned = 2
		if awake < limit:
			_queue_message("Silmät painuu kiinni... (nukahdat n. klo %s). Sänkyyn ajoissa, tai kahvia!" % _pass_out_text(), 3.5, 25.0)
	if awake >= limit - 30.0:
		tilat.add("vireys", -0.01 * delta)
	if awake >= limit and not _minigame_open():  # kesken minipelin (pajatso, saunakorjaus...) sammutaan sen jälkeen
		_pass_out()


## Piirretty tai 3D-minipeli (scripts/*_game.gd, finished-signaali) on auki main-solmun alla. Osa minipeleistä
## (saunakorjaus, Siitarin pelit) ei vaihda tilaa "minigame":ksi, joten tila ei yksin kerro sitä.
func _minigame_open() -> bool:
	for c in get_children():
		var sc: Script = c.get_script()
		if sc != null and sc.resource_path.ends_with("_game.gd") and c.has_signal("finished"):
			return true
	return false


## Yön raja: sammutaan siihen missä ollaan. Kotona ja mökillä sänkyyn kuten nukkumaan mentäessä, muualla herätys
## paikan mukaan (piha tai oja, autotallin lattia, baarin jälkeen koti tai mökki).
func _pass_out() -> void:
	var drunk := _humala_peak > 0.4
	var spawn := Vector3.ZERO
	var intro := ""
	_day_end = "koti" if state in ["in_home", "in_garage"] else ("raahe" if state == "in_raahe" else "ulko")
	Sfx.play("body_fall", -4.0)
	match state:
		"in_home":
			home_int.leave()
			state = _home_prev
			spawn = home_zone + Vector3(0, 0, 4)
			intro = "Sammuit sohvalle vaatteet päällä. Päivi: \"No niin, taas.\"\n"
		"in_mokki":
			mokki_int.leave()
			state = _mokki_prev
			spawn = mokki.porch_pos(0.9) - Vector3(0, 0.3, 0)
			intro = "Sammuit tuvan penkille. Santtu oli peitellyt sut torkkupeitolla.\n"
		"in_garage":
			garage_int.leave()
			state = _garage_prev
			spawn = world.garage_door + world.garage_out * 1.0
			intro = "Heräsit autotallin lattialta SLN-73:n vierestä. Radio soi vieläkin.\n"
		"in_varasto":
			varasto_int.leave()
			state = _varasto_prev
			spawn = world.varasto_door
			intro = "Nukahdit Tokolan varaston säkkien päälle. Hiiret kävivät tutkimassa taskut.\n"
		"in_kirppis":
			kirppis_int.leave()
			state = _kirppis_prev
			spawn = world.kirppis_door
			intro = "Nukahdit seuraintalon kahvipöydän ääreen. Hilkka peitteli virkkuuliinalla.\n"
		"in_raahe":
			raahe_int.leave()
			spawn = home_zone + Vector3(0, 0, 4)
			intro = "Sammuit Kapteenin Kulman nurkkapöytään. Baarimikko soitti taksin, ja Päivi maksoi sen.\n"
		"in_retki":
			_retki_close()
			spawn = home_zone + Vector3(0, 0, 4)
			var sam: String = str(Retket.LISTA.get(_retki_id, {}).get("sammuit", "retkipaikan penkille"))
			intro = (sam.trim_prefix("!") if sam.begins_with("!") else "Sammuit " + sam) + ". Taksikuski kuljetti sut kotiin eikä sanonut mitään.\n"
		"in_asema":
			asema_int.leave()
			if _asema_town == "vaala":
				_mopo_end_quiet()  # matka on jo pysähdyksissä sisällä: Vaala-tila ja Santun kyyti nollattava silti
				spawn = mokki.porch_pos(0.9) - Vector3(0, 0.3, 0)
			else:
				state = _asema_prev
				spawn = world.station_pos
			intro = "Sammuit aseman penkille. Rane oli peitellyt sut sanomalehdellä ja juonut loput kaljoista.\n"
		"in_siitari":
			siitari_int.leave()
			_mopo_end_quiet()
			spawn = mokki.porch_pos(0.9) - Vector3(0, 0.3, 0)
			intro = "Sammuit Siitarin terassille. Santtu haki sut autolla ja kirosi koko matkan.\n"
		"in_shop":
			interior.leave()
			if _shop_vaala:
				interior.vaala = false
				_shop_vaala = false
				_mopo_end_quiet()
				spawn = mokki.porch_pos(0.9) - Vector3(0, 0.3, 0)
				intro = "Sammuit Tervaportin kassajonoon. Santtu haki sut autolla ja kirosi koko matkan.\n"
			else:
				spawn = shop_door + Vector3(0, 0, 2)
				intro = "Sammuit K-Marketin penkille. Mummot herättivät kettukarkeilla.\n"
		_:
			if _in_vaala:
				_mopo_end_quiet()
				spawn = mokki.porch_pos(0.9) - Vector3(0, 0.3, 0)
				intro = "Sammuit mopon selkään tien varteen. Santtu haki sut traktorilla Paapeliin.\n"
			else:
				spawn = Vector3(player.global_position.x, 0, player.global_position.z)
				var at_m := _at_mokki_pos(spawn)
				intro = ("Heräsit mökin pihalta mustikanvarvuista. Santtu: \"Sängyt on sisällä.\"\n" if at_m
					else "Heräsit ojanpientareelta kaste vaatteissa. Joku oli asetellut kaljatölkin tyynyksi.\n")
				if not at_m and money > 5.0 and randf() < 0.4:
					money -= 5.0
					intro += "Lompakosta puuttuu vitonen.\n"
	state = "cutscene"
	player.controls_enabled = false
	_hazards.set_deferred("process_mode", Node.PROCESS_MODE_INHERIT)
	_new_day(spawn, false, intro + ("Krapula jyskyttää ohimoilla.\n" if drunk else "Selkä on jumissa ja silmät rähmällä.\n"))
	clock_min = PASS_OUT_WAKE
	for k in ["vireys", "keskittyminen"]:
		tilat.add(k, -0.4)


## Matka tai välianimaatio: kello hyppää eteenpäin.
func _advance_clock(minutes: float) -> void:
	clock_min = fmod(clock_min + minutes, 1440.0)


# --- Debug -------------------------------------------------------------------
# `godot --path . -- --shot=/polku/kuva.png [--scene=shop|juntti|wife] [--nohud]`
# ottaa kuvakaappauksen n. 1,5 s jälkeen ja sulkee pelin. --nohud piilottaa HUDin (lappu, minikartta, palkit)
# julisteen kuvia varten; minipelien omat kerrokset jäävät näkyviin.

## Testaus: --scene=vaanto_pelaa avaa kädenväännön heti (pelattava), ja ottelun jälkeen alkaa uusi.
func _play_wrestle_loop() -> void:
	_hud.visible = false
	var bar := BarGame.new()
	bar.position = BAR_POS
	add_child(bar)
	bar.finished.connect(func(_won: bool) -> void:
		bar.queue_free()
		_play_wrestle_loop.call_deferred())


## Testien hiiren nappi (painallus tai vapautus) kohdassa pos.
static func _mb(pos: Vector2, pressed: bool, button := MOUSE_BUTTON_LEFT) -> InputEventMouseButton:
	var ev := InputEventMouseButton.new()
	ev.position = pos
	ev.global_position = pos
	ev.button_index = button
	ev.pressed = pressed
	return ev


## Testikohtausten ryhmät (tools/testit/kohtaukset/), järjestyksessä: sama nimi kahdesti -> ensimmäinen voittaa.
const KOHTAUSRYHMAT := ["muut_a_k", "muut_k_o", "muut_s_u", "muut_p_s", "kolmio_vaala", "kartta_kota", "kauppa", "muut_k_k", "muut_u_y", "ajoneuvot", "muut_o_p", "mokki_2", "mokki_1", "kaisua", "legendat"]


func _maybe_screenshot() -> void:
	var path := ""
	var scene := ""
	var nohud := false
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--shot="):
			path = arg.substr(7)
		elif arg.begins_with("--scene="):
			scene = arg.substr(8)
		elif arg == "--nohud":
			nohud = true
	if scene == "vaanto_pelaa":
		_play_wrestle_loop()  # kädenvääntö suoraan pelattavaksi (ilman taksia), uusi ottelu aina edellisen jälkeen
		return
	if path.is_empty():
		return
	if nohud:
		get_tree().process_frame.connect(func() -> void: _hud.visible = false)
	# Testikohtaukset ovat tiedostoissa tools/testit/kohtaukset/<ryhmä>.gd (KOHTAUKSET-lista kertoo, mitkä). Ryhmä ladataan
	# ennen ensimmäistä ruutua, samassa ruudussa kuin maailman rakennus: kesken pelin lataus antaisi seuraavalle ruudulle
	# ison deltan, fysiikkaruudut kasautuisivat ja kohtauksen alku (esim. vessa: ovella 10 fysiikkaruutua) ajoittuisi toisin.
	var kohtaukset: Node = null
	if scene != "" and scene != "kohtaustarkistus":
		var t_lataus := Time.get_ticks_msec()
		for ryhma: String in KOHTAUSRYHMAT:
			var kohtaus_skripti: GDScript = load("res://tools/testit/kohtaukset/%s.gd" % ryhma)
			if scene in (kohtaus_skripti.KOHTAUKSET as Array):
				kohtaukset = kohtaus_skripti.new()
				break
		print("KOHTAUS ryhmä ladattu %d ms" % (Time.get_ticks_msec() - t_lataus))
	await get_tree().process_frame
	# Traileri (tools/traileri/renderoi.gd): --trailer=otos1,otos2 kuvaa otokset ja sulkee pelin.
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--trailer="):
			var ohjaaja: Node = load("res://tools/traileri/ohjaaja.gd").new(self, arg.substr(10).split(","),
				"--trailer-preview" in OS.get_cmdline_user_args(), path.get_base_dir())
			add_child(ohjaaja)
			await ohjaaja.run()
			get_tree().quit()
			return
	if scene.begins_with("mokki") or scene == "kuisti":
		var tb := Time.get_ticks_msec()
		mokki.ensure_built()  # testikohtaukset menevät mökille ilman taksia
		print("MOKKI rakennettu %d ms" % (Time.get_ticks_msec() - tb))
	if scene == "kohtaustarkistus":
		# Kaikkien testikohtausryhmien käännöstarkistus: jokainen tools/testit/kohtaukset/-tiedosto ladataan (logiikkakohtaus).
		for ryhma: String in KOHTAUSRYHMAT:
			var tarkistettava: GDScript = load("res://tools/testit/kohtaukset/%s.gd" % ryhma)
			var kaantyy := tarkistettava != null and tarkistettava.can_instantiate()
			print("KOHTAUSTARKISTUS %s: %s" % [ryhma, "OK" if kaantyy else "TESTI VIKA ei käänny"])
		# Muut testiskriptit (tools/testit/*.gd): pelin sisällä, jotta autoloadit (Settings, Sfx) ovat olemassa.
		var rikki := 0
		var tiedostot := DirAccess.get_files_at("res://tools/testit")
		for tiedosto: String in tiedostot:
			if tiedosto.get_extension() != "gd":
				continue
			var testi: GDScript = load("res://tools/testit/" + tiedosto)
			if testi == null or not testi.can_instantiate():
				rikki += 1
				print("KOHTAUSTARKISTUS tools/testit/%s: TESTI VIKA ei käänny" % tiedosto)
		print("KOHTAUSTARKISTUS testiskriptit: %d tiedostoa, %d ei käänny" % [Array(tiedostot).filter(func(t: String) -> bool: return t.get_extension() == "gd").size(), rikki])
		get_tree().quit()
		return
	if kohtaukset != null:
		kohtaukset.main = self
		add_child(kohtaukset)
		if await kohtaukset.aja(scene, path, nohud) == 2:
			return
	for i in 90:
		await get_tree().process_frame
	if DisplayServer.get_name() != "headless":  # headlessissa ei piirretä: frame_post_draw ei tulisi (tools/testit/kuva.gd)
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png(path)
	get_tree().quit()
