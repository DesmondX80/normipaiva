## Vaatekaappi (koti: tuulipuku tai farkut ja verkkopaita; Paapeli: työvaatteet tai tuulipuku): valikko asuista.
func _open_wardrobe(ids: Array, title: String) -> void:
	_interior_busy(true)
	_active_walker().controls_enabled = false
	_menu_mode = "asu"
	var items := []
	for id in ids:
		if id == "hattu":  # päähine erikseen: Stetson lippiksen tilalle tai takaisin
			items.append([id, "Lippis takaisin päähän" if Looks.hat == "stetson" else "Stetson päähän"])
			continue
		if id == "koppa":
			items.append([id, "Lippis takaisin päähän" if Looks.hat == "koppa" else "Karhu-koppa päähän"])
			continue
		if id == "slabarit":  # jalkineet erikseen: släbärit ja villasukat asun kenkien tilalle tai takaisin
			items.append([id, "Asun omat kengät jalkaan" if Looks.feet == "slabarit" else "Släbärit ja villasukat jalkaan"])
			continue
		items.append([id, Looks.OUTFITS[id].name + ("  (päällä)" if id == Looks.outfit else "")])
	_item_menu.open(items, title)


func _on_wardrobe(id: String) -> void:
	_menu_mode = "give"
	_interior_busy(false)
	_active_walker().controls_enabled = true
	if id == "hattu":
		_set_hat("" if Looks.hat == "stetson" else "stetson")
		Sfx.play("cloth", -2.0)
		_show_message("Stetson päähän. Saloisten kovin cowboy." if Looks.hat == "stetson" else "Lippis takaisin päähän.", 3.0)
		_save_game()
		return
	if id == "slabarit":
		if Looks.feet != "slabarit" and Looks.outfit == "hiihtohaalari":
			_show_message("Hiihtohaalarissa pidetään kuukengät. Släbärit odottaa kaapissa.", 3.0)
			return
		if Looks.feet != "slabarit" and Looks.boots != "":
			_show_message("Kumisaappaat on jalassa: riisu ne ensin eteisen matolle.", 3.0)
			return
		_set_feet("" if Looks.feet == "slabarit" else "slabarit")
		Sfx.play("cloth", -2.0)
		_show_message("Villasukat ja släbärit jalkaan. Kolme raitaa ja harmaa kanta: kesä on täällä." if Looks.feet == "slabarit"
			else "Omat kengät takaisin jalkaan. Villasukat kaappiin.", 3.0)
		_save_game()
		return
	if id == "koppa":
		_set_hat("" if Looks.hat == "koppa" else "koppa")
		Sfx.play("cloth", -2.0)
		_show_message("Karhu-koppa päähän. Täyttä olutta, tosi vahva." if Looks.hat == "koppa" else "Lippis takaisin päähän.", 3.0)
		_save_game()
		return
	if id == Looks.outfit:
		return
	_set_outfit(id)
	Sfx.play("cloth", -2.0)
	_show_message({"tuulipuku": "Tuulipuku päälle ja Karhu-lippis päähän. Normipäivän univormu.",
		"farkut": "Repaleinen verkkopaita, henkselit ja työhousut. Tukka pystyssä, naama noessa. Kyntömiehen asu.",
		"tyovaatteet": "Työhousut, flanelli ja Karjala-lippis. Nyt kelpaa tehdä Paapelin hommia.",
		"hiihtohaalari": "Neonpinkki hiihtohaalari, kuukengät ja otsapanta. Kasari palasi, ja koko kylä näkee sen.",
		"nahkaliivi": "Pentin nahkaliivi paljaalle rinnalle, farkut ja bootsit. Penkit on lämpimät, sanoo liivi."}[id], 3.5)
	_save_game()


## Pelaajan asu (Looks.outfit): kaikki pelaajan mallit (pyörä, kävely, sisätilat, mopo) vaihtavat ulkonäön paikallaan.
func _set_outfit(id: String) -> void:
	if not Looks.OUTFITS.has(id):
		id = "tuulipuku"
	if id == Looks.outfit:
		return
	Looks.outfit = id
	var bodies := get_tree().root.find_children("*", "Node3D", true, false).filter(func(n: Node) -> bool:
		return n.has_meta("player_body"))  # ensin lista: restyle vapauttaa mallien solmuja
	for n in bodies:
		Looks.restyle_player(n)


