func _renew_shop_interior() -> void:
	var old := interior
	_spawn_interior()
	old.queue_free()


## Kaupan kori tyhjäksi seuraavaa käyntiä varten (sama sisätila kuin kylän K-Marketissa).
func _reset_shop_visit() -> void:
	interior.has_beer = false
	interior.has_paid = false
	interior.stolen = false
	interior.cart.clear()
	interior.bag.clear()
	interior.walker.set_carrying(false)


func _on_shop_exited(bought: bool) -> void:
	# Jokainen käynti alkaa puhtaalta pöydältä (kauppaan saa palata saman päivän aikana): kori, maksu, kalja kädessä,
	# Päivin kassi, kassajono ja juoksukaljat nollautuvat, kun sisätila rakennetaan uudelleen tämän käsittelyn jälkeen.
	_renew_shop_interior.call_deferred()
	if _shop_vaala:
		_on_vaala_shop_exited(bought)
		return
	interior.leave()
	Sfx.play("door_close", -3.0)
	_shop_exit_frame = Engine.get_process_frames()
	player.global_position = shop_door + Vector3(0, 0.3, 1.6)  # ovelta pari askelta pihalle
	player.rotation.y = PI
	player.controls_enabled = true
	player.activate_camera()
	_hazards.process_mode = Node.PROCESS_MODE_INHERIT
	_wife_bust_arrive()
	if interior.has_paid:
		has_sausage = has_sausage or interior.cart.has("makkara")
		has_matches = has_matches or interior.cart.has("tikut")
		has_chocolate = has_chocolate or interior.cart.has("suklaa")
		has_turbo = has_turbo or interior.cart.has("turbohiiva")
		has_sugar = has_sugar or interior.cart.has("sokeri")
		for k in ShopInterior.BAKERY:
			if interior.cart.has(k):
				food[k] = food.get(k, 0) + 1
		_ebike_cart(interior.cart)
		for k in interior.bag:
			paivi_bag[k] = interior.bag[k]
		if not interior.bag.is_empty() and not bought and not interior.stolen:
			_show_message("Päivin ostokset kassissa. Vie ne kotiin.", 2.5)
	if interior.stolen:
		_chase_loot = {"kalja": bought, "cart": interior.cart.keys(), "bag": interior.bag.duplicate()}
	if not bought:
		state = _shop_prev  # aiemmin tänään ostettu kuutonen pysyy ostettuna
		if interior.stolen:
			_show_message("MAKSAMATTA ULOS! Kauppias juoksee perään – se on nopeampi kuin pyörä!\nTaksiin tai pakoon!", 4.0)
			_start_shop_chase(shop_door, true)
		return
	beers += 6
	state = "ulkona"
	_kuutonen_day = day  # ei tehtävä: kotiin tai kauppaan voi mennä milloin vain
	player.set_carrying(true)
	if interior.stolen and not wife_alerted:
		_show_message("JUOKSUKALJAT! Kauppias juoksee perään – se on nopeampi kuin pyörä!\nTaksiin, tai heitä kaljoja päin!", 4.0)
	if interior.stolen:
		_start_shop_chase(shop_door, true)
	else:
		_show_message("Kuutonen kassissa!", 2.5)
		_koppa_first()


func _on_paid(total: float) -> void:
	money -= total


func _on_busted() -> void:
	wife_alerted = true
	if _wife_bust.is_empty() and wife != null and is_instance_valid(wife):
		_wife_bust = [Time.get_ticks_msec(), wife.global_position]
	_show_message("Naapurin Anna-Liisa näki sinut ja soitti Päiville!\nPäivi lähti jo autolla tänne...", 3.0)


## Ulos kaupasta hälytyksen jälkeen: Päivi on ajanut kaupalle sen ajan, minkä olit sisällä (kaupassa vaarat ovat
## pysähdyksissä). Perillä hän odottaa pihassa; muuten hän on matkalla jossain kodin ja kaupan välillä. Kummassakin
## tapauksessa hän tietää, missä olet, ja jahtaa heti (alerted).
func _wife_bust_arrive() -> void:
	if _wife_bust.is_empty() or wife == null or not is_instance_valid(wife):
		return
	var secs: float = (Time.get_ticks_msec() - int(_wife_bust[0])) / 1000.0
	var from: Vector3 = _wife_bust[1]
	_wife_bust = []
	var left := maxf(0.0, Vector2(from.x - shop_door.x, from.z - shop_door.z).length() - secs * WIFE_BUST_SPEED)
	var at := shop_door
	if left > 15.0:
		var dir := Vector3(from.x - shop_door.x, 0, from.z - shop_door.z).normalized()
		at = shop_door + dir * left
	wife.reset_to(world.nearest_node(at))
	wife.parked = false
	wife.visible = true
	wife.process_mode = Node.PROCESS_MODE_INHERIT
	wife.alerted = true
	wife.mode = "chase"
	_wife_phase = "partio"
	if left <= 15.0:
		_show_message("PÄIVI ODOTTAA JO KAUPAN PIHASSA!\nPakoon!", 3.5)
	else:
		_show_message("Päivi on matkalla tänne, %d metrin päässä.\nPÄIVI TIETÄÄ MISSÄ OLET!" % (roundi(left / 10.0) * 10), 3.5)


func _on_wife_spotted() -> void:
	if state == "ulkona" and mowing and _mow_lawn == sinikka_lawn and _once_today("sinikka_nurmi_nahty"):
		# Tarina: Päivi näki leikkaamassa Sinikan nurmikkoa. Suuttuu ja lähtee jahtiin; leikkuuta voi jatkaa karkuun päästyä.
		tilat.add("moraali", -0.1)
		tilat.add("stressi", -0.1)
		_show_message("PÄIVI NÄKI SINUT! \"SINIKAN nurmikkoa sää leikkaat?!\"\nPakoon, ja jatka kun pääset karkuun!", 3.5)
		return
	if state == "ulkona" and not wife.alerted:
		_show_message("PÄIVI NÄKI SINUT!\nPakoon!", 2.0)


func _on_wife_caught() -> void:
	if state != "ulkona":
		return
	if not paivi_credit.is_empty():
		# Kotihommista hyvitys: Päivi päästää tämän kerran (vanhin hyvitys ensin).
		var why: String = paivi_credit.pop_front()
		wife_alerted = false
		_wife_bust = []
		wife.forgive(12.0)
		Sfx.play("horn", -6.0, 0.8)
		var left := "Hyvityksiä jäljellä %d." % paivi_credit.size() if not paivi_credit.is_empty() else "Seuraavalla kerralla ei armoa."
		_show_message("Päivi: \"%s\"\n%s" % [PAIVI_FORGIVE[why].pick_random(), left], 4.0)
		_save_game()
		return
	_lose("Päivi nappasi kiinni!", "wife")


## Päivin kotihommat: tehty homma antaa yhden hyvityksen, joka pyyhkii yhden kiinnijäämisen (_on_wife_caught).
## Hyvitykset säilyvät päivästä toiseen (enintään PAIVI_CREDIT_MAX); kauppalista ja kukat lasketaan, kun Päivi ne näkee.
const PAIVI_CREDIT_MAX := 3
const PAIVI_FORGIVE := {
	"nurmikko": ["No... sää sentään leikkasit nurmikon. Mee nyt.", "Nurmikko on hieno, sen myönnän. Tämän kerran päästän."],
	"pensasaita": ["Aita on suora ku viivotin. Hyvä on, mee.", "Sen aidan takia päästän. Mutta kotiin ennen pimeää!"],
	"kauppalista": ["Ostokset oli oikein... Hyvä on, tämän kerran.", "Muistit värit oikein. Mee nyt, ennen ku kaduttaa."],
	"kukat": ["Kukat oli kauniita. Mutta tää on viimenen kerta!", "Niiden kukkien takia... no, mee."],
}
var paivi_credit: Array = []  # ansaitut hyvitykset (homman id), vanhin ensin


func _paivi_credit_add(why: String) -> void:
	_rikos_event("paivi_hyvitys", {"why": why})  # Päivin epäluulo (#326) ennen kattoa
	if paivi_credit.size() >= PAIVI_CREDIT_MAX:
		return
	paivi_credit.append(why)
	_queue_message("Päivi muistaa tämän: yksi kiinnijääminen anteeksi (%d)." % paivi_credit.size(), 3.0)


