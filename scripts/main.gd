## Jukeboksi (siitari_interior.gd "jukeboksi"): iskelmät (iskelmat.gd), Saloisten Saapasjalat (tanssibiisit.gd) ja
## ysärit (kuulokkeiden soittolista, headphones.gd). Lauantaina iskelmä suututtaa Raahen jätkät, ja ysäri suututtaa aina hedelmäpelin miehen:
## riita ratkaistaan Street Fighter -tappelulla pihalla (kerran päivässä). Häviäjä maksaa vitosen, voittaja saa kaljan.
const JUKEBOX_PRICE := 0.5
var _jukebox_songs := {}  # valikon id -> [polku, nimi, laji]
var _jukebox_on := false


func _jukebox_list() -> Dictionary:
	var out := {}
	for sg in Iskelmat.available():
		out["isk_%s" % sg.file] = [sg.path, "%s – %s" % [sg.title, sg.artist], "iskelma"]
	for sg in Iskelmat.saapasjalat():
		out["saa_%s" % sg.file] = [sg.path, sg.title, "saapasjalat"]
	for f in Headphones.TITLES:
		for ext in ["mp3", "ogg"]:
			var p: String = Headphones.MUSIC_DIR.path_join("%s.%s" % [f, ext])
			if ResourceLoader.exists(p):
				out["ysa_%s" % f] = [p, Headphones.TITLES[f], "ysari"]
				break
	return out


func _jukebox_menu() -> void:
	_jukebox_songs = _jukebox_list()
	if _jukebox_songs.is_empty():
		_show_message("Jukeboksi on tyhjä. Joku on vienyt levytkin.", 2.5)
		return
	if money < JUKEBOX_PRICE:
		_show_message("Biisi maksaa 50 senttiä. Rahat ei riitä.", 2.5)
		return
	var items := []
	for id in _jukebox_songs:
		var sg: Array = _jukebox_songs[id]
		items.append([id, {"iskelma": "Iskelmä: ", "saapasjalat": "Saapasjalat: "}.get(sg[2], "Ysäri: ") + sg[1]])
	if _jukebox_on:
		items.append(["hiljaa", "Hiljaa (pysäytä biisi)"])
	_interior_busy(true)
	_active_walker().controls_enabled = false
	_menu_mode = "jukeboksi"
	_item_menu.open(items, "Jukeboksi: biisi 50 snt")


func _on_jukebox(id: String) -> void:
	_menu_mode = "give"
	_interior_busy(false)
	_active_walker().controls_enabled = true
	if id == "hiljaa":
		_jukebox_stop()
		_show_message("Jukeboksi hiljeni.", 2.0)
		return
	var sg: Array = _jukebox_songs[id]
	money -= JUKEBOX_PRICE
	Sfx.play("coin" if Sfx.FILES.has("coin") else "glass", -6.0)
	Sfx.music_play(1.0, 0.0, sg[0])
	_jukebox_on = true
	_show_message("Kolikko sisään, levy vaihtuu: %s" % sg[1], 3.0)
	var fought := "siitari_tappelu" in _today
	if sg[2] == "iskelma" and siitari_int.raahe_on:
		siitari_int.raahe_say("Mitä mummojen polkkaa tää on?!", 0)
		siitari_int.raahe_say("Vaihda tai pihalle, äijä!", 1)
		if fought:
			return
		_quarrel_foe = "raahelainen"
		_quarrel_cause = "jukeboksi"
		await get_tree().create_timer(1.2).timeout
		if state == "in_siitari" and not siitari_int.busy:
			_quarrel_menu([["tappele", "\"Pihalle siitä, ni katotaan kuka valitsee biisit!\""],
				["anna", "Pysäytä polkka"]], "Raahen jätkät suuttui iskelmästä")
	elif sg[2] == "ysari":
		siitari_int.hedelma_say("Mitä tümpsytystä tää on? Tää on iskelmäilta!", 1)
		if fought:
			return
		_quarrel_foe = "hedelmamies"
		_quarrel_cause = "jukeboksi"
		await get_tree().create_timer(1.2).timeout
		if state == "in_siitari" and not siitari_int.busy:
			_quarrel_menu([["tappele", "\"Pihalle, ni katotaan, mikä täällä soi!\""],
				["anna", "Pysäytä ysäri"]], "Hedelmäpelin mies suuttui ysäristä")


func _jukebox_stop() -> void:
	if _jukebox_on:
		_jukebox_on = false
		Sfx.music_stop(1.0)


## Street Fighter -tappelu Siitarin pihalla (fight.gd: lavastus "siitari", vastustaja "raahelainen").
func _start_siitari_fight(foe := "raahelainen") -> void:
	_today.append("siitari_tappelu")
	_quarrel_foe = foe
	_jukebox_stop()
	_fight_source = "siitari"
	var hp := 120.0 if tilat.effect("kipu") > 0 else 100.0
	var dmg := 1.2 if tilat.effect("humala") > 0 else 1.0
	tilat.add("stressi", -0.15)
	tilat.add("kipu", -0.3)
	tilat.add("stamina", -0.2)
	tilat.first("tappelu_" + foe, 0.3)
	_fight_prev = state
	state = "fight"
	siitari_int.busy = true
	_hud.visible = false
	fight.set_stage("siitari")
	fight.start(beers, foe, hp, dmg)


## Oulujoen uintikilpailu ponkkarilta (#183, uinti_game.gd): hyppy, vuorotellen A ja D, kaksi nuorta vastaan.
func _start_uinti() -> void:
	if mopo_trip == null or _uinti_game != null:
		return
	_uinti_day = day
	mopo_trip.stop()
	_mopo_foot_inside()
	state = "uinti"
	_hud.visible = false
	_mopo_label.visible = false
	_compass.visible = false
	CamCtl.free_mouse = true
	tilat.first("uintikilpailu", 0.3)
	var g := UintiGame.new()
	g.drunk = tilat.value("humala")
	g.finished.connect(_on_uinti_finished)
	_uinti_game = g
	add_child(g)


func _on_uinti_finished(place: int, time: float) -> void:
	_uinti_game = null
	CamCtl.free_mouse = false
	state = _vaala_state
	_hud.visible = true
	_mopo_label.visible = true
	_compass.visible = true
	_mopo_resume()
	if mopo_trip != null:
		mopo_trip._resume_frame = Engine.get_process_frames()
	if place == 0:
		_uinti_day = -1  # keskeytys ei kuluta yritystä
		_show_message("Jätit kisan kesken. Nuoret nauraa rannalla.", 2.5)
		return
	_advance_clock(30.0)
	tilat.add("stamina", -0.2)
	tilat.add("nalka", -0.05)
	if place == 1:
		maine = clampf(maine + 4.0, 0.0, 100.0)
		tilat.add("moraali", 0.2)
		tilat.first("uinti_voitto", 0.4)
		if _uinti_best <= 0.0 or time < _uinti_best:
			_uinti_best = time
		_show_message("Voitit Oulujoen uintikilpailun ajalla %.1f s (ennätys %.1f s)! Nuoret hurraa: \"Setä on joen kuningas!\" Maine +4." % [time, _uinti_best], 5.0)
	elif place == 2:
		maine = clampf(maine + 1.0, 0.0, 100.0)
		_show_message("Toinen sija (%.1f s). Maine +1. Ponkkarilta hyppäämistä kannattaa harjoitella." % time, 4.0)
	else:
		_show_message("Kolmas sija (%.1f s). Nuoret tarjoaa limut: \"Ensi kerralla paremmin, setä.\"" % time, 4.0)
	_save_game()


## Järkkärit ja lavatappelu (#183): Street Fighter -tappelu Oulujärven lavan pihalla (fight.gd: vastustaja "jarkkari", lavasteena Siitarin piha).
## Myytävät huumeet repussa (oksikodoni ja pervitiini, kaikki jatkoasteet): lisää valikkoon myyntirivit.
func _teini_myynti_valinnat(o: Array) -> void:
	for k in _laake_keys():
		if laake.get(k, 0) <= 0 or not LAAKE_JATKE.has(_laake_base(k)):
			continue
		var risk := _teini_riski(k)
		o.append(_opt("myy_" + k, "Myy %s (%s €)%s" % [_laake_label(k), _eur(_teini_hinta(k)), ", kiinnijäämisriski %d %%" % roundi(risk * 100.0) if risk > 0.0 else ""]))


func _teini_hinta(key: String) -> float:
	return APTEEKKI_MENU[_laake_base(key)][1] * APTEEKKI_TAKA_MULT


## Paljastumisriski annokselle: TEINI_KIINNI[aste], hoitajan lääkelaukulla jatkettu (puhdas) erä porrasta alempi (hs.porras).
func _teini_riski(key: String) -> float:
	return TEINI_KIINNI[mini(hs.porras(_laake_tier(key), key, laake.get(key, 0)), TEINI_KIINNI.size() - 1)]


## Annoksen myynti: sama hinta heikkoudesta riippumatta, mutta jatkettu annos paljastuu todennäköisyydellä _teini_riski
## (roll: testissä kiinteä arpa, muuten satunnainen). fight: paljastuksen tappelu (tyhjä = Vaalan _start_teini_fight);
## caught: paljastusrepliikki ja lines: [hyvän kaman repliikit, miedon repliikit] (tyhjä = Vaalan omat).
func _teini_myy(key: String, roll := -1.0, fight := Callable(), caught := "", lines: Array = []) -> void:
	if laake.get(key, 0) <= 0:
		return
	var kiinni := _teini_riski(key)
	if (randf() if roll < 0.0 else roll) < kiinni:
		_talk_box.close()
		_show_message(caught if caught != "" else "Teini: \"Hetkinen... toi on jauhoa! Toi on JATKETTUA! Sää yritit huijata mua?!\"", 2.0)
		get_tree().create_timer(1.4).timeout.connect(fight if fight.is_valid() else _start_teini_fight)
		return
	hs.myyty(key)
	laake[key] -= 1
	if laake[key] <= 0:
		laake.erase(key)
	var price := _teini_hinta(key)
	money += price
	Sfx.play("coin", -4.0)
	_rikos_event("myynti", {"key": key, "paikka": "vaala" if _in_vaala else "saloinen"})
	var pot := _laake_pot(key)
	var line: String = "Hyvää kamaa! Ei kysytä mistä." if pot >= 1.0 else ["Hmm, aika mietoa... mut ok.", "Vähän laimeeta, mut kelpaa.", "Joo joo, ota rahat."].pick_random()
	if lines.size() == 2:
		line = (lines[0] if pot >= 1.0 else lines[1]).pick_random()
	_talk_box.reply(line, _talk_options(), "+%s €. Rahaa %s €." % [_eur(price), _eur(money)])


func _start_teini_fight() -> void:
	if mopo_trip == null or state == "fight":
		return
	mopo_trip.stop()
	_mopo_foot_inside()
	_fight_source = "teini"
	var hp := 120.0 if tilat.effect("kipu") > 0 else 100.0
	var dmg := 1.2 if tilat.effect("humala") > 0 else 1.0
	tilat.add("stressi", -0.15)
	tilat.add("stamina", -0.2)
	tilat.first("tappelu_teini_diili", 0.3)
	_fight_prev = _vaala_state
	state = "fight"
	_hud.visible = false
	_mopo_label.visible = false
	_compass.visible = false
	fight.set_stage("siitari")
	fight.start(beers, "teini_diili", hp, dmg)


## Voitto: teini pakenee ja kamat jäävät. Häviö: teini ryöstää kaikki lääkkeet ja rahat.
func _teini_fight_end(won: bool, bags_used: int, thrown: int) -> void:
	state = _fight_prev
	_hud.visible = true
	_mopo_label.visible = true
	_compass.visible = true
	fight.set_stage("kmarket")
	beers = maxi(0, beers - bags_used - thrown)
	_mopo_resume()
	if mopo_trip != null:
		mopo_trip._resume_frame = Engine.get_process_frames()
	if _rikos_fight != null:  # huumekaupan riskin tappelu (esim. velan perintä): osa kertoo lopputuloksen
		var rf: Object = _rikos_fight
		_rikos_fight = null
		_show_message(rf.fight_end(won), 5.0)
		return
	_show_message(_teini_tulos(won), 4.0 if won else 5.0)


## Diilitappelun lopputulos (Vaala ja Saloinen): voitto antaa maineen, häviö vie rahat ja lääkkeet ja tunnin. Palauttaa viestin.
func _teini_tulos(won: bool) -> String:
	if won:
		tilat.add("moraali", 0.15)
		tilat.add("kokemus", 0.1)
		maine = clampf(maine + 2.0, 0.0, 100.0)
		Sfx.play("win_small", -4.0)
		return "K.O.! Teini pakeni itkien, eikä enää osta mitään. Lääkkeet ja rahat jäi sulle. Maine +2."
	var took := money
	var pills := 0
	for k in laake:
		pills += laake[k]
	money = 0.0
	laake.clear()
	hs.laukku_erat.clear()
	perv_until = -1.0
	tilat.add("kipu", -0.3)
	tilat.add("moraali", -0.2)
	maine = clampf(maine - 5.0, 0.0, 100.0)
	_advance_clock(KO_MINUTES)
	Sfx.play("glass", -6.0, 0.8)
	return "Hävisit! Teini ryösti kaiken: %s € ja %d annosta lääkkeitä. Heräsit tunnin päästä. Maine −5." % [_eur(took), pills]


# --- Huumekaupan riskit (scripts/rikos/, osa.gd) -----------------------------------------------------------------
# Jokainen riski on oma osansa (velka, valeostaja, epäluulo, yliannos, huijari, autovarkaus). Tämä on niiden yhteinen
# pistorasia: osat ladataan nimen mukaan, jos tiedosto on olemassa, ja niiltä kysytään puheessa, logiikassa, uutena
# päivänä, tallennuksessa ja päiväkirjassa. Osat eivät koske main.gd:hen; tapahtumat kulkevat _rikos_eventin kautta.
## pentti: sivujuoni (#299) samalla rajapinnalla. paivi*: luku 6 "Päivi epäilee" (#326) ennen Penttiä, jotta Pentin
## Päivi-vihje (paivi_tutkii.hello) voittaa Pentin oman tervehdyksen.
const RIKOS_OSAT := ["velka", "valeostaja", "epaluulo", "yliannos", "huijari", "autovarkaus",
	"paivi", "paivi_puhe", "paivi_hyvitys", "paivi_tutkii", "pentti"]
const RIKOS_PIDATYS_MAINE := 10.0
var rikos: Array = []  # osien instanssit (osa.gd)
var _rikos_fight: Object = null  # osa, joka aloitti diilitappelun (_start_teini_fight): fight_end antaa loppuviestin


func _rikos_init() -> void:
	rikos.clear()
	for n in RIKOS_OSAT:
		var path := "res://scripts/rikos/%s.gd" % n
		if ResourceLoader.exists(path):
			_rikos_add(load(path).new(), n)


## Osa listaan (myös testin oma osa, tools/testit/rikos_koe_osa.gd).
func _rikos_add(o: Object, n: String) -> void:
	o.game = self
	o.nimi = n
	rikos.append(o)
	o.setup()


## Osa nimellä (esim. rikos_osa("yliannos").naloksoni); null, jos osaa ei ole.
func rikos_osa(n: String) -> Object:
	for r in rikos:
		if r.nimi == n:
			return r
	return null


func _rikos_event(ev: String, data := {}) -> void:
	for r in rikos:
		r.on_event(ev, data)


func _rikos_tick(e: bool) -> void:
	for r in rikos:
		r.tick(e)


## Ensimmäisen osan vihje, jos jokin osa pitää Saloisten apteekin luukun kiinni; "" = auki.
func _rikos_luukku_kiinni() -> String:
	for r in rikos:
		var t: String = r.luukku_kiinni()
		if t != "":
			return t
	return ""


## Päiväkirjan Riskit-sivun osiot (journal.gd _draw_risks): [{"otsikko", "rivit"}], tyhjät osat pois.
func _rikos_riskit() -> Array:
	var out: Array = []
	for r in rikos:
		var d: Dictionary = r.riskit()
		if not d.is_empty():
			out.append(d)
	return out


## Huumekaupan riski päättää päivän: cause "pidatys" (PIDÄTETTY) tai "yliannos" (ELVYTETTY), reason näkyy otsikon alla.
## Pidätys takavarikoi lääkkeet ja puolet rahoista ja vie mainetta. Vaalassa herätys kuten mopon kuolemassa (Päivi soittaa),
## Saloisissa _lose (Päivi motkottaa pihalla).
func _rikos_loppu(cause: String, reason: String) -> void:
	if state == "cutscene" or trailer_safe:
		return
	if cause == "pidatys":
		laake.clear()
		hs.laukku_erat.clear()
		perv_until = -1.0
		money = floorf(money / 2.0)
		maine = clampf(maine - RIKOS_PIDATYS_MAINE, 0.0, 100.0)
	_rikos_fight = null
	if _in_vaala and mopo_trip != null and mopo_trip.active:
		_on_mopo_killed(cause, reason)
	else:
		_lose(reason, cause)


# --- Huumekauppa Saloisissa (huume_saloinen.gd) ------------------------------------------------------------------
# Ostajat: kaukalon iltateinit (saloinen_teinit.gd, klo 20–01) ja laavun teinijengi (laavu_guard.gd peaceful, kun repussa
# on myytävää). Myynti, riski ja lopputulos ovat Vaalan (_teini_myynti_valinnat, _teini_myy, _teini_tulos); paljastus
# vie tappeluun K-Marketin lavasteessa (fight.gd "teini_diili", _fight_source "teini_saloinen").
const HS_TALKERS := ["kaukalo_teinit", "laavu_teinit"]
const HS_TALK_R := 3.2  # puheväli ringin keskeltä tai laavun pomosta


func _hs_setup() -> void:
	hs_teens = SaloinenTeinit.new()
	hs_teens.target = player
	_hazards.add_child(hs_teens)  # paikka kaukalon kehyksestä (saloinen_teinit.gd _ready)
	hs_teens.set_on(SaloinenTeinit.on_time(clock_min))


## Saloisten huumekaupan pisteet (kutsutaan _pohjoiset_logicin jälkeen).
func _huume_saloinen_logic() -> void:
	if world == null or player.is_stunned():
		return
	var e := Input.is_action_just_pressed("interact")
	_hs_door_logic(e)
	_hs_laukku_logic(e)
	_hs_laavu_logic(e)
	_hs_teens_logic(e)
	_rikos_tick(e)


## Apteekin takaovi (apteekki_saloinen.gd, ovi Makasiini._build_door): E koputuspisteessä avaa luukun ja hoitaja
## myy Vaalan takaluukun hinnoin (_on_apteekki taka). Ovi on aina auki; luukku sulkeutuu keskustelun päättyessä
## (_talk_end). Lukitulla etuovella vain vihje.
const HS_KNOCK_R := 1.3
const HS_FRONT_R := 1.8
var _hs_tween: Tween


func _hs_door_logic(e: bool) -> void:
	var ap: Dictionary = world.apteekki_s
	if ap.is_empty() or _hint.text != "" or _talk_box.is_open() or player == bike:
		return
	if _near_xz(ap.knock, HS_KNOCK_R):
		var kiinni := _rikos_luukku_kiinni()
		if kiinni != "":
			_hint.text = kiinni  # epäluulo (rikos/epaluulo.gd): Raili ei avaa tänään
			if e:
				Sfx.play("door", -8.0, 1.4)
			return
		_hint.text = "[%s] Koputa takaoveen" % Settings.action_key("interact")
		if e and Engine.get_process_frames() != _talk_end_frame:
			Sfx.play("door", -3.0, 0.8)
			_hs_hatch(true)
			_talk_open("apteekki_hoitaja", null)
		return
	var root: Node3D = ap.root
	if _near_xz(root.global_transform * Vector3(0, 0, ApteekkiSaloinen.D / 2.0 + 1.2), HS_FRONT_R):
		_hint.text = ApteekkiSaloinen.LUKOSSA
		if e:
			Sfx.play("door", -8.0, 1.4)


## Luukku auki/kiinni (kuten _taka_hatch); komeron valo palaa vain luukun ollessa auki.
func _hs_hatch(open: bool) -> void:
	var ap: Dictionary = world.apteekki_s if world != null else {}
	if ap.is_empty():
		return
	var d: Node3D = ap.back
	var fill: OmniLight3D = ap.fill
	if _hs_tween != null:
		_hs_tween.kill()
	if open:
		fill.visible = true
	_hs_tween = create_tween()
	_hs_tween.tween_property(d.get_node("Ovi/Luukku"), "position:x", -0.5 + (Makasiini.HATCH_TRAVEL if open else 0.0), 0.35)
	if not open:
		_hs_tween.tween_callback(func() -> void: fill.visible = false)


## Luukkuosto: Vaalan takaluukun hinta ja kirjaus (_on_apteekki taka), hoitajan omat repliikit.
func _hs_osta(id: String) -> void:
	var m0 := money
	var ar := _on_apteekki(id, true)
	var line: String = ApteekkiSaloinen.EI_RAHAA
	if money < m0:
		line = ApteekkiSaloinen.LAUKKU if _hs_ostettu() else ApteekkiSaloinen.OSTO.pick_random()
	_talk_box.reply(line, _talk_options(), ar[1] + "   Rahaa %s €." % _eur(money))


## Onnistunut luukkuosto hoitajalta (_hs_osta kutsuu, kun raha väheni): laskuri, päiväkirja ja kolmannen oston
## jälkeen lääkelaukku portaalle (luukku on laukulle liian pieni). true = laukku annettiin nyt (LAUKKU-repliikki).
func _hs_ostettu() -> bool:
	tilat.first("hs_ensiosto", 0.2)
	var bag := hs.osto()
	_rikos_event("luukkuosto", {})
	_save_game()
	return bag


var _hs_laukku_prop: Node3D


## Laukku portaalla: oven vierellä, saranan puolta vastapäätä (oven paikallinen -X), oven heilahdusalueen ulkopuolella;
## +Z = ulos (oven etusuunta). E poimii sen reppuun.
func _hs_laukku_logic(e: bool) -> void:
	var on_stoop: bool = hs.laukku == "portaalla" and world.apteekki_s.has("stoop_top")
	if not on_stoop:
		if _hs_laukku_prop != null:
			_hs_laukku_prop.queue_free()
			_hs_laukku_prop = null
		return
	if _hs_laukku_prop == null:
		var back: Node3D = world.apteekki_s.back
		var b := back.global_basis.orthonormalized()
		_hs_laukku_prop = Laakelaukku.build_prop()
		world.add_child(_hs_laukku_prop)
		_hs_laukku_prop.global_position = world.apteekki_s.stoop_top \
			- b.x * (ApteekkiSaloinen.STOOP.x / 2.0 - Laakelaukku.PROP_L / 2.0 - 0.05) + b.z * 0.15
		_hs_laukku_prop.global_rotation = Vector3(0, back.global_rotation.y, 0)
	if _hint.text != "" or player == bike or not _near_xz(_hs_laukku_prop.global_position, 1.6):
		return
	_hint.text = "[%s] Ota hoitajan lääkelaukku" % Settings.action_key("interact")
	if e:
		hs.laukku = "repussa"
		tilat.first("hs_laukku", 0.3)
		Sfx.play("pickup", -4.0, 0.8)
		_show_message("Hoitajan lääkelaukku! Avaa se reppuvalikosta tai T:llä: laukulla jatketut annokset ovat puhtaampia ja paljastuvat porrasta harvemmin.", 5.5)
		_save_game()


func _hs_group_of(who: String) -> String:
	return "kaukalo" if who == "kaukalo_teinit" else "laavu"


## Myytävää repussa (oksikodoni tai pervitiini, mikä tahansa jatkoaste; sama ehto kuin _teini_myynti_valinnat).
func _hs_has_sellable() -> bool:
	for k in laake:
		if laake[k] > 0 and LAAKE_JATKE.has(_laake_base(k)):
			return true
	return false


## Kaukalon iltateinit näkyvät klo 20–01; lähellä puhevihje (myynti ja juttelu).
func _hs_teens_logic(_e: bool) -> void:
	if hs_teens == null:
		return
	var on := SaloinenTeinit.on_time(clock_min)
	if hs_teens.visible != on:
		hs_teens.set_on(on)
	if not on or _hint.text != "" or _talk_box.is_open():
		return
	if _near_xz(hs_teens.center(), HS_TALK_R):
		_talk_hint("kaukalo_teinit", hs_teens, player != bike)


## Laavun teinijengi: kun repussa on myytävää eikä jengi ole kieltäytynyt tänään, pomo tulee juttelemaan (peaceful)
## eikä haasta tappeluun; pomon luona puhevihje. Akka ja vallattu laavu eivät muutu.
func _hs_laavu_logic(_e: bool) -> void:
	if guard == null or guard.kind != "teens" or guard.mode == "gone":
		return
	guard.peaceful = _hs_has_sellable() and int(hs.ei_osta.get("laavu", -1)) != day
	if not guard.peaceful or _hint.text != "" or _talk_box.is_open():
		return
	if _near_xz(guard.boss_pos(), HS_TALK_R):
		_talk_hint("laavu_teinit", null, player != bike)


func _hs_hello(who: String) -> String:
	var kaukalo := who == "kaukalo_teinit"
	if int(hs.ei_osta.get(_hs_group_of(who), -1)) == day:
		return (SaloinenTeinit.KAUKALO_EI_OSTA if kaukalo else SaloinenTeinit.LAAVU_EI_OSTA).pick_random()
	if kaukalo and not _hs_has_sellable():
		return SaloinenTeinit.KAUKALO_EI_KAMAA.pick_random()
	return (SaloinenTeinit.KAUKALO_HELLO if kaukalo else SaloinenTeinit.LAAVU_HELLO).pick_random()


func _hs_options(who: String, o: Array) -> void:
	if who == "kaukalo_teinit" and "korkki" in tilat.firsts:
		o.append(_opt("korkkilapsy", "Korkkiläpsyä kaukalolla (panos 3 tuplaa)", korkit.tuplat() >= 3 and _lapsy_day != day,
			"läpsit jo tänään" if _lapsy_day == day else "tarvitset 3 tuplakorkkia", true))
	if int(hs.ei_osta.get(_hs_group_of(who), -1)) == day:
		o.append(_opt("myy", "Myy kamaa", false, "eivät osta sulta enää tänään"))
	elif not _hs_has_sellable():
		o.append(_opt("myy", "Myy kamaa", false, "repussa ei oksikodonia eikä pervitiiniä"))
	else:
		_teini_myynti_valinnat(o)
	if who == "laavu_teinit":
		o.append(_opt("haasta", "Haasta jengin pomo tappeluun laavusta", true, "", true))


func _hs_choose(id: String) -> void:
	var who := _talk_who
	if id == "haasta":
		_talk_box.close()
		var d: Vector3 = player.global_position - guard.boss_pos()
		d.y = 0.0
		_start_fight("teens", "laavu", d.normalized() if d.length() > 0.1 else Vector3.RIGHT)
		return
	_hs_group = _hs_group_of(who)
	var kaukalo := who == "kaukalo_teinit"
	var m0 := money
	_teini_myy(id.trim_prefix("myy_"), -1.0, _hs_fight_start,
		"%s: \"%s\"" % [TALKERS[who][0], SaloinenTeinit.KAUKALO_KIINNI if kaukalo else SaloinenTeinit.LAAVU_KIINNI],
		[SaloinenTeinit.KAUKALO_HYVA, SaloinenTeinit.KAUKALO_MIETO] if kaukalo else [SaloinenTeinit.LAAVU_HYVA, SaloinenTeinit.LAAVU_MIETO])
	if money > m0:
		tilat.first("hs_ensimyynti", 0.2)


## Paljastus: tappelu ostajaryhmän kanssa (Saloisissa tavallinen _start_fight, vaarat tauolla).
func _hs_fight_start() -> void:
	if state != "ulkona":
		return
	var c: Vector3 = hs_teens.center() if _hs_group == "kaukalo" else guard.boss_pos()
	var d := player.global_position - c
	d.y = 0.0
	_start_fight("teini_diili", "teini_saloinen", d.normalized() if d.length() > 0.1 else Vector3.RIGHT)


## Diilitappelun loppu Saloisissa: voitto -> ryhmä ei osta tänään; häviö kuten Vaalassa (ryöstö ja tunti).
func _hs_fight_end(won: bool, note: String) -> void:
	if _rikos_fight != null:  # huumekaupan riskin tappelu: osa kertoo lopputuloksen
		var rf: Object = _rikos_fight
		_rikos_fight = null
		if not won and player.has_method("stun"):
			player.stun(_fight_dir)
		_show_message(rf.fight_end(won) + note, 5.0)
		player.set_carrying(beers > 0)
		_save_game()
		return
	if won:
		hs.ei_osta[_hs_group] = day
		if _hs_group == "laavu":
			guard.defeat()  # jengi pakenee metsään (LAAVU_PAKO); laavu_conquered jää asettamatta (ei tallennu vapaaksi)
		_teini_tulos(true)
		_show_message("K.O.! %s Lääkkeet ja rahat jäi sulle. Maine +2.%s" % [
			SaloinenTeinit.KAUKALO_PAKO if _hs_group == "kaukalo" else SaloinenTeinit.LAAVU_PAKO, note], 4.0)
	else:
		if player.has_method("stun"):
			player.stun(_fight_dir)
		_show_message(_teini_tulos(false) + note, 5.0)
	player.set_carrying(beers > 0)
	_save_game()


func _start_lava_tappelu() -> void:
	if mopo_trip == null or state == "fight":
		return
	_lava_tappelu_day = day
	mopo_trip.stop()
	_mopo_foot_inside()
	_fight_source = "lava"
	var hp := 120.0 if tilat.effect("kipu") > 0 else 100.0
	var dmg := 1.2 if tilat.effect("humala") > 0 else 1.0
	tilat.add("stressi", -0.15)
	tilat.add("kipu", -0.3)
	tilat.add("stamina", -0.2)
	tilat.first("tappelu_jarkkari", 0.3)
	_fight_prev = _vaala_state
	state = "fight"
	_hud.visible = false
	_mopo_label.visible = false
	_compass.visible = false
	fight.set_stage("siitari")
	fight.start(beers, "jarkkari", hp, dmg)


func _lava_tappelu_end(won: bool, bags_used: int, thrown: int) -> void:
	state = _fight_prev
	_hud.visible = true
	_mopo_label.visible = true
	_compass.visible = true
	fight.set_stage("kmarket")
	beers = maxi(0, beers - bags_used - thrown)
	_mopo_resume()
	if mopo_trip != null:
		mopo_trip._resume_frame = Engine.get_process_frames()
	if won:
		tilat.add("moraali", 0.2)
		tilat.add("kokemus", 0.1)
		mielihyva = clampf(mielihyva + 8.0, 0.0, 100.0)
		maine = clampf(maine + 3.0, 0.0, 100.0)
		Sfx.play("win_small", -4.0)
		_show_message("K.O.! Järkkäri istahti portaille pidelemään leukaansa. Pihan nuoret hurraa: \"Setä on legenda!\" Maine +3.", 4.5)
	else:
		var took := minf(5.0, money)
		money -= took
		tilat.add("kipu", -0.2)
		tilat.add("moraali", -0.1)
		maine = clampf(maine - 3.0, 0.0, 100.0)
		_show_message("Hävisit! Järkkäri vei %s ja käski lähteä ennen leimatarkastusta. Maine −3." % ("%s €" % _eur(took) if took > 0.0 else "ylpeyden"), 4.0)


func _siitari_fight_end(won: bool, bags_used: int, thrown: int) -> void:
	state = _fight_prev
	_hud.visible = true
	fight.set_stage("kmarket")
	beers = maxi(0, beers - bags_used - thrown)
	siitari_int.busy = false
	siitari_int._enter_frame = Engine.get_process_frames()
	siitari_int.walker.activate()
	var raahe := _quarrel_foe == "raahelainen"
	if won:
		if raahe:
			siitari_int.raahe_leave()
		else:
			siitari_int.hedelma_leave()
		# Voittajalle talo tarjoaa kaljan.
		tilat.add("humala", 0.08)
		tilat.add("moraali", 0.15)
		tilat.add("kokemus", 0.1)
		mielihyva = clampf(mielihyva + 10.0, 0.0, 100.0)
		maine = clampf(maine + 3.0, 0.0, 100.0)
		Sfx.play("pour" if Sfx.FILES.has("pour") else "glass", -6.0)
		siitari_int.bartender_say("Tuosta hyvästä talo tarjoaa! Kalja voittajalle.")
		_show_message(("K.O.! Raahen jätkät häipyi pihalta. Baarimikko tarjoaa voittajalle kaljan, ja pajatso on vapaa." if raahe
			else "K.O.! Hedelmäpelin mies istui seurueen pöytään nuolemaan haavojaan. Baarimikko tarjoaa voittajalle kaljan."), 4.0)
	else:
		var took := minf(5.0, money)
		money -= took
		tilat.add("kipu", -0.2)
		tilat.add("moraali", -0.1)
		maine = clampf(maine - 3.0, 0.0, 100.0)
		var lost := "%s €" % _eur(took) if took > 0.0 else "ylpeyden"
		if raahe:
			siitari_int.raahe_say("Pajatso on meiän, sanoin mää!", 0)
			_show_message("Hävisit! Raahen jätkät vei %s ja jatkaa pajatsoa." % lost, 3.5)
		else:
			siitari_int.hedelma_say("Ja nyt soi iskelmä. Kiitos vitosesta!", 1)
			_show_message("Hävisit! Hedelmäpelin mies vei %s ja jatkaa peliä." % lost, 3.5)


func _on_fight_finished(won: bool, bags_used: int, thrown := 0) -> void:
	if won:
		tilat.first("tappelu_voitto", 0.2)  # päiväkirjan "Nyrkit puhuu" (quests.gd)
	if _fight_source == "teini":
		_teini_fight_end(won, bags_used, thrown)
		return
	if _fight_source == "lava":
		_lava_tappelu_end(won, bags_used, thrown)
		return
	if _fight_source == "siitari":
		_siitari_fight_end(won, bags_used, thrown)
		return
	state = _fight_prev
	_hud.visible = true
	player.activate_camera()
	player.controls_enabled = true
	_hazards.process_mode = Node.PROCESS_MODE_INHERIT
	beers = maxi(0, beers - bags_used - thrown)
	var note := "\nKassi-iskut rikkoi %d kaljaa." % bags_used if bags_used > 0 else ""
	if thrown > 0:
		note += "\nHeitit %d kaljaa vastustajaa päin." % thrown
	if _fight_source == "kauppias":
		_kauppias_fight_end(won, note)
		return
	if _fight_source == "teini_saloinen":
		_hs_fight_end(won, note)
		return
	var loser_node: Node3D = {"juntti": juntti, "laavu": guard, "tractor": tractor}[_fight_source]
	if won:
		loser_node.defeat()
		tilat.add("moraali", 0.1)  # voitto kumoaa tappelun moraalimenetyksen
		tilat.add("kokemus", 0.1)
		var who := "Juntti lähti itkien kotiin."
		if _fight_source == "tractor":
			who = "Jyväjemmari ajoi murjottamaan. Pelto on nyt vapaata riistaa!"
		elif _fight_source == "laavu":
			laavu_conquered = true
			_save_game()
			who = "Akka lähti nostamaan meteliä muualle. Laavu on vapaa!" if guard.kind == "akka" else "Teinit pakenivat. Laavu on vapaa!"
		_show_message("K.O.! %s%s" % [who, note], 3.0)
	else:
		loser_node.gloat()
		player.stun(_fight_dir)
		var foe := "Juntti"
		if _fight_source == "tractor":
			foe = "Jyväjemmari"
		elif _fight_source == "laavu":
			foe = "Akka" if guard.kind == "akka" else "Teinit"
		_advance_clock(KO_MINUTES)
		tilat.add("kipu", -0.2)
		tilat.add("moraali", -0.1)
		maine = clampf(maine - 3.0, 0.0, 100.0)
		var ko := "\nHeräsit ojasta tunnin päästä. Kylki on kipeä."
		if beers > 0:
			beers = maxi(0, beers - 2)
			Sfx.play("glass", -3.0)
			_show_message("Hävisit! %s potkaisi kassia, 2 kaljaa rikki.%s%s" % [foe, note, ko], 3.5)
		else:
			var took := minf(5.0, money)
			money -= took
			var what := "vitosen \"lainaksi\"" if took >= 5.0 else "viimeiset %s €" % _eur(took)
			_show_message(("Hävisit! %s vei %s.%s" % [foe, what, ko]) if took > 0.0 else
				"Hävisit! %s penkoi taskut, mutta ne oli tyhjät.%s" % [foe, ko], 3.5)
	player.set_carrying(beers > 0)


## Juoksukaljat: kauppias lähtee perään kaupan ovelta. Saloisissa (taxi = true) etumatka riittää juuri ja juuri
## taksille, kun juoksee suoraan; Vaalassa taksia ei ole, joten edessä on aina tappelu.
func _start_shop_chase(door: Vector3, taxi: bool) -> void:
	if is_instance_valid(_shop_chaser):
		_shop_chaser.queue_free()
	var c := ShopChaser.new()
	add_child(c)
	c.global_position = door
	c.target_fn = func() -> Node3D: return player
	if _in_vaala:
		var vl: Node3D = mopo_trip.vaala
		c.ground_fn = func(x: float, z: float) -> float:
			var lp: Vector3 = vl.to_local(Vector3(x, 0, z))
			return vl.to_global(Vector3(lp.x, vl.h(lp.x, lp.z), lp.z)).y
	if taxi:
		var d := Vector2(door.x - world.taxi_pos.x, door.z - world.taxi_pos.z).length() - TAXI_RADIUS
		c.delay = maxf(1.0, d / OnFoot.RUN - d / ShopChaser.SPEED + 0.6)
	else:
		c.delay = 2.0
	c.caught.connect(func(dir: Vector3) -> void:
		if state == "ulkona":
			_start_fight("kauppias", "kauppias", dir))
	_shop_chaser = c


func _chasing() -> bool:
	return is_instance_valid(_shop_chaser) and _shop_chaser.is_chasing()


## Tappelu kauppiaan kanssa ohi: voitolla kaljat jäävät (heitetyt menivät), tappiolla kauppias vie loput kaljat
## (Vaalassa myös juostut Koskenkorvat) takaisin hyllyyn, eikä kuutosta ole haettu.
## Kauppias otti varastetut takaisin (paitsi kaljat ja viinat, jotka käsitellään erikseen). Palauttaa nimet.
func _reclaim_loot() -> PackedStringArray:
	var out := PackedStringArray()
	for k in _chase_loot.get("cart", []):
		match String(k):
			"makkara":
				has_sausage = false
				out.append("makkarat")
			"tikut":
				has_matches = false
			"suklaa":
				has_chocolate = false
				out.append("suklaan")
			"turbohiiva":
				has_turbo = false
			"sokeri":
				has_sugar = false
			"teippi", "nippu", "sahkoteippi":
				ebike.supplies[k] = maxi(0, ebike.supplies[k] - ShopInterior.TARVIKE[k][2])
				out.append("tarvikkeet")
			"pulla", "piirakka":
				food[k] = food.get(k, 0) - 1
				if food[k] <= 0:
					food.erase(k)
				out.append("eväät")
	var bag: Dictionary = _chase_loot.get("bag", {})
	for prod in bag:
		paivi_bag.erase(prod)
	if not bag.is_empty():
		out.append("Päivin ostokset")
	return out


func _kauppias_fight_end(won: bool, note: String) -> void:
	var c := _shop_chaser
	_shop_chaser = null
	if won:
		if is_instance_valid(c):
			c.defeat()
		tilat.add("moraali", 0.1)
		tilat.add("kokemus", 0.1)
		_show_message("K.O.! Kauppias laahusti kassalle. Tavarat jäi sulle!%s" % note, 3.5)
		_chase_loot = {}
		# Kauppias soittaa poliisit: Saloisissa poliisiauto, Vaalassa nimismies jalan.
		get_tree().create_timer(3.0).timeout.connect(func() -> void:
			if state != "ulkona":
				return
			if _in_vaala or _at_mokki():
				_nimismies_shop_raid()
			else:
				_call_police("varkaus"))
	else:
		if is_instance_valid(c):
			c.gloat()
		if player.has_method("stun"):
			player.stun(_fight_dir)
		var took := beers if _chase_loot.get("kalja", true) else 0
		if _chase_loot.get("kalja", true):
			beers = 0
		viina_pullot = maxi(0, viina_pullot - _chase_viina)
		var back := _reclaim_loot()
		Sfx.play("glass", -6.0, 0.8)
		if not _in_vaala:
			_kuutonen_day = -1  # kuutonen palautui hyllyyn: ei haettu tänään
		var what := PackedStringArray()
		if took > 0:
			what.append("%d kaljaa" % took)
		what.append_array(back)
		_show_message("Hävisit! Kauppias vei %s takaisin hyllyyn ja kung fu -potkaisi perään.%s" % [
			", ".join(what) if not what.is_empty() else "tavarat", note], 3.5)
	_chase_viina = 0
	_chase_loot = {}
	player.set_carrying(beers > 0)


