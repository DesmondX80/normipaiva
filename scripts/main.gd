## Drakkar Noir: ensimmäinen suihkaus päivässä tuoksuttaa koko päivän (moraali, mielihyvä); lisäsuihkaukset samana
## päivänä ovat liikaa.
func _spray_drakkar() -> void:
	drakkar -= 1
	Sfx.play("whoosh", -8.0, 2.2)
	if drakkar_day != day:
		drakkar_day = day
		tilat.add("moraali", 0.15)
		tilat.add("stressi", 0.1)
		mielihyva = clampf(mielihyva + 3.0, 0.0, 100.0)
		tilat.first("drakkar", 0.2)
		_show_message(["Pssst. Drakkar Noiria kaulaan ja ranteisiin. Ysäri palasi.",
			"Pssst. Musta pullo, tumma tuoksu. Nyt kelpaa lavalle."].pick_random(), 2.5)
	else:
		tilat.add("stressi", -0.05)
		_show_message("Vielä yksi suihkaus... Nyt haisee koko Saloisiin.", 2.5)
	if drakkar <= 0:
		_queue_message("Drakkar Noir loppui. Railin pöydältä löytyy ehkä uusi pullo.", 2.5)
	_save_game()


## Tansseissa Drakkar Noir parantaa tulosta (sinä päivänä, kun on suihkaistu).
func _drakkar_dance(score: float) -> float:
	if drakkar_day != day or score <= 0.0:  # tanssimatta tai ilman yhtään osumaa tuoksu ei auta
		return score
	_queue_message("Drakkar Noir teki tehtävänsä: tanssipari painautui lähemmäs.", 2.5)
	return minf(1.0, score + DRAKKAR_DANCE)


## Omat juomat baarissa: baarimikko huomaa joka toisen kerran (OWN_DRINK_SEEN); ensin varoitus, toisella ulos.
const OWN_DRINK_SEEN := 0.5
const OWN_DRINK_WARN := ["Hei! Omia juomia ei täällä juoda.", "Pullo pois, tää on anniskeluravintola!",
	"Nähtiin kyllä. Vielä kerran niin lähdet."]
var _own_drink_warned := false  # nollataan baariin tullessa


func _own_drink_in_bar() -> void:
	if not state in ["in_raahe", "in_siitari"] or randf() >= OWN_DRINK_SEEN:
		return
	var bar = raahe_int if state == "in_raahe" else siitari_int
	if not _own_drink_warned:
		_own_drink_warned = true
		bar.bartender_say(OWN_DRINK_WARN.pick_random())
		tilat.add("stressi", -0.05)
		_show_message("Baarimikko huomasi omat juomat. Seuraavasta lentää ulos.", 2.5)
		return
	bar.bartender_say("Nyt riitti! Ulos, ja heti!")
	bar.walker.controls_enabled = false
	maine = clampf(maine - 5.0, 0.0, 100.0)
	tilat.add("moraali", -0.1)
	Sfx.play("lose", -4.0)
	_show_message("Baarimikko heitti sinut ulos omien juomien takia!", 3.0)
	tilat.first("baarista_ulos", 0.3)
	var where := state
	get_tree().create_timer(2.5).timeout.connect(func() -> void:
		if state != where:
			return
		if where == "in_raahe":
			_raahe.kicked = true
			_on_raahe_exited()
		else:
			_on_siitari("lahde")
			_show_message("Siitarista heitettiin ulos omien juomien takia. Mopo odottaa pihassa.", 3.5))


## Sisätilan toimintopisteet pois päältä valikon ajaksi: valikon valinta-E ei saa samalla avata ovea (ulos) tai
## toimia hyllyllä. Suljettaessa vielä saman ruudun yli (_enter_frame).
func _interior_busy(on: bool) -> void:
	var it: Node = {"in_home": home_int, "in_garage": garage_int, "in_mokki": mokki_int, "in_shop": interior,
		"in_raahe": raahe_int, "in_retki": retki_int, "in_siitari": siitari_int, "in_apteekki": apteekki_int, "in_asema": asema_int, "in_kirppis": kirppis_int, "in_varasto": varasto_int}.get(state)
	if it == null:
		return
	it.busy = on
	if not on:
		it._enter_frame = Engine.get_process_frames()


func _on_eat(id: String) -> void:
	_interior_busy(false)
	_active_walker().controls_enabled = true
	_mopo_menu(false)
	if id == "saappaat":
		_bag_boots()
		return
	if id == "klaffipoyta":
		if _journal.visible:
			_journal.toggle()
		_start_klaffipoyta.call_deferred()
		return
	if id == "laakelaukku":
		if _journal.visible:
			_journal.toggle()
		_start_laakelaukku.call_deferred()
		return
	if APTEEKKI_MENU.has(_laake_base(id)):
		if laake.get(id, 0) > 0:
			_take_laake(id)
		return
	match id:
		"pulla", "piirakka", "savukala", "savuriista", "karrella", "mustikkapiirakka", "makkaraperunat", "piirakka_kaikilla", "hampurilainen":
			if food.get(id, 0) <= 0:
				return  # valikossa vain omat eväät; varmistus, ettei tyhjää syödä
			food[id] -= 1
			if food[id] <= 0:
				food.erase(id)
		"suklaa":
			has_chocolate = false
		"drakkar":
			_spray_drakkar()
			return
		"kalja":
			beers -= 1
			player.set_carrying(beers > 0)
			_drink(1)
			tilat.first("syo_kalja", 0.1)
			Sfx.play("glass", -6.0, 1.2)
			_show_message(["Tsihh. Ah.", "Kylmää ja hyvää.", "Yks ei oo yhtään.", "Päivin ei tarvi tietää."].pick_random(), 1.8)
			_own_drink_in_bar()
			return
		"viina":
			viina_pullot -= 1
			tilat.add("humala", 0.25)
			tilat.add("kipu", 0.1)
			tilat.add("stressi", FOODS.viina.stressi)
			tilat.add("moraali", FOODS.viina.moraali)
			tilat.first("syo_viina", 0.1)
			Sfx.play("glass", -6.0, 0.9)
			_show_message(["Kurkkua polttaa.", "Metsän makua.", "Lämmittää mukavasti.", "Tätä ei Päivi näe."].pick_random(), 1.8)
			_own_drink_in_bar()
			return
		"pontikka":
			pontikka -= 1
			tilat.add("humala", 0.3)
			tilat.add("kipu", 0.1)
			tilat.add("stressi", 0.1)
			_lava_courage_day = day
			tilat.first("syo_pontikka", 0.1)
			Sfx.play("glass", -6.0, 0.8)
			_show_message(["Kurkku tulessa! Nyt uskaltaa vaikka lavalle.", "Korpi-Kallen tavaraa. Silmät vettyy.",
				"Rohkeutta pullosta. Varpaat kyllä kärsii."].pick_random(), 2.5)
			_own_drink_in_bar()
			return
		"puolukka", "mustikka":
			bucket[id] -= 1
			if bucket[id] <= 0:
				bucket.erase(id)
	var f: Dictionary = FOODS[id]
	_eat(f.nalka)
	for k in ["stressi", "moraali", "vireys"]:
		if f.has(k):
			tilat.add(k, f[k])
	tilat.first("syo_" + id, 0.1)
	Sfx.play("pickup", -6.0, 0.6)
	_show_message(["Nam.", "Maistuu!", "Ei paha.", "Hyvää eväsleipää parempi."].pick_random(), 1.5)


## Esine pojille: pallo = palkkio, kalja = pojat juoksevat nauraen pois, muu = heittävät takaisin ja kivisade.
## Pallosta palauttaa keskusteluikkunan inforivin (muut lopettavat keskustelun ja näkyvät viestinä).
func _on_give(id: String) -> String:
	match id:
		"pallo":
			has_ball = false
			_ball_quest = "done"
			money += BALL_REWARD
			var first: bool = not ("jalkapallo" in tilat.firsts)
			if first:
				tilat.firsts.append("jalkapallo")
			tilat.add("moraali", randf_range(0.1, 0.5))
			tilat.add("kokemus", randf_range(0.4, 0.6) if first else randf_range(0.1, 0.3))
			boys.play_ball()
			Sfx.play("win_small")
			return "Pallo palautettu! Pojat antoi %s €." % _eur(BALL_REWARD)
		"kalja":
			beers -= 1
			player.set_carrying(beers > 0)
			tilat.add("moraali", -0.2)
			boys.flee()
			_show_message("Pojat nappasi kaljan ja juoksi nauraen pois!", 3.0)
		_:
			boys.stone()
			_show_message("Pojat heitti sen takaisin ja alkoi heitellä kivillä!", 3.0)
	return ""


## Jatkuvat tilavaikutukset ulkona (sekunnissa). Arvot ovat -1..+1, joten 0,01/s = minuutissa 0,6.
func _stats_tick(delta: float) -> void:
	var t := tilat
	var moving := absf(player.speed) > 0.3
	var sprint: bool = (player == walker_out and absf(player.speed) > 3.0) or (player == bike and bike.sprinting)
	_still_t = 0.0 if moving else _still_t + delta
	var resting := _still_t > 3.0
	# Nälkä: aika ja liike kuluttavat.
	t.add("nalka", -(0.002 + (0.002 if moving else 0.0)) * delta)
	if wound_big:
		t.add("kipu", -0.004 * delta)  # karhun raapaisut kirveltävät pahemmin, kunnes hoidetaan
	# Väsymys ja stamina: sprintti kuluttaa, tauko palauttaa.
	if sprint:
		t.add("vasymys", -0.01 * delta)
		t.add("stamina", -0.01 * delta)
	elif resting:
		t.add("vasymys", 0.01 * delta)
		t.add("stamina", 0.01 * delta)
	if "nalka" in t.chosen and "vasymys" in t.chosen and t.value("nalka") < -0.5 and t.value("vasymys") < -0.5:
		t.add("stamina", -0.003 * delta)  # nälkä ja väsymys samana päivänä vievät voimat
	# Kipu hellittää ajan myötä.
	t.add("kipu", 0.003 * delta)
	# Stressi: jahti on aikapainetta, paikallaan olo mukavassa paikassa rauhoittaa.
	if wife.mode == "chase" or juntti.mode == "chase" or (is_instance_valid(police) and not police.is_leaving()):
		t.add("stressi", -0.012 * delta)
	if resting and _pleasant_spot():
		t.add("stressi", 0.02 * delta)
		t.add("vireys", 0.006 * delta)
	# Vireys: rauha luonnossa ja selvin päin nostaa, humala, nälkä ja väsymys laskevat.
	if resting and player.surface in ["forest", "meadow", "bog"]:
		t.add("vireys", 0.004 * delta)
	if t.value("humala") <= 0.0:
		t.add("vireys", 0.001 * delta)
	elif t.value("humala") > 0.5:
		t.add("vireys", -0.005 * delta)
	if t.value("nalka") < -0.5 or t.value("vasymys") < -0.5:
		t.add("vireys", -0.002 * delta)
	# Keskittyminen kärsii stressistä.
	if t.value("stressi") < -0.5:
		t.add("keskittyminen", -0.002 * delta)
	# Kokemus: pitkä paikallaan olo laskee, kova humala "opettaa".
	if _still_t > 10.0:
		t.add("kokemus", -0.002 * delta)
	if t.value("humala") > 0.7:
		t.add("kokemus", 0.003 * delta)
	# Humala haihtuu hitaasti.
	t.add("humala", -0.002 * delta)
	_stat_effects()


## Päivän kolmen tilan palkinnot ja haitat (day_stats.gd effect): päällä heti, kun palkki ylittää rajan
## (+0,5 / -0,5; humalatila 0,3–0,6 / yli 0,8). Muut tilat kuin päivän kolme eivät vaikuta. Ks. docs/tilat.md.
func _stat_effects() -> void:
	var t := tilat
	# Stressi: rauhallisena mummot suuttuvat hitaammin, kireänä Päivi ajaa lujempaa.
	var e: int = t.effect("stressi")
	mummot.anger_speed = _anger_base * (1.3 if e > 0 else 1.0)
	wife.speed_mult = _wife_speed_base + (0.1 if e < 0 else 0.0)
	# Nälkä: kylläisenä kulkee kevyemmin, nälkäisenä raskaammin (jalan ja pyörällä).
	e = t.effect("nalka")
	var perv: float = perv_mult if day * 1440.0 + clock_min < perv_until else 1.0  # pervitiini: kaikki liike +50 %
	walker_out.speed_mult = (1.0 + 0.1 * e) * perv
	bike.boost = perv
	if mopo_trip != null and mopo_trip.mopo != null:
		mopo_trip.mopo.boost = perv
	# Väsymys: virkeänä juoksu ja spurtti kuluttavat vähemmän, väsyneenä kunto palautuu hitaammin.
	e = t.effect("vasymys")
	walker_out.drain_mult = 0.7 if e > 0 else 1.0
	walker_out.recover_mult = 0.5 if e < 0 else 1.0
	# Kipu: kipeänä ontuu (juoksu ja hyppy). Palkinto (lisäkesto) tulee tappelun alussa (_start_fight).
	e = t.effect("kipu")
	walker_out.run_mult = 0.85 if e < 0 else 1.0
	walker_out.jump_mult = 0.75 if e < 0 else 1.0
	# Stamina: hyvissä voimissa spurtti on rajumpi, voimattomana ei juosta eikä spurtata.
	e = t.effect("stamina")
	bike.sprint_mult = 1.6 if e > 0 else PlayerBike.SPRINT
	walker_out.no_sprint = e < 0
	# Vireys: virkeänä tutka näkee kauemmas, tokkuraisena usva tihenee.
	e = t.effect("vireys")
	_minimap.range_m = Minimap.FAR_RANGE if e > 0 else Minimap.RANGE
	var far: float = Settings.view_far() * (0.5 if e < 0 else 1.0)
	_env.fog_depth_begin = 90.0 * far / 900.0
	_env.fog_depth_end = 700.0 * far / 900.0
	# Kovassa humalassa pyörän ja kävelyn ohjaus heittelee (drunk_wobble.gd), kuten mopolla: aina, vaikka humala
	# ei olisi päivän tila. Humalan palkinto (tappelun iskut) vaatii, että humala on päivän tiloissa.
	var drunk: float = t.value("humala")
	bike.drunk = drunk
	walker_out.drunk = drunk
	# Moraali (kaupan hinnat), keskittyminen (repun kauppalista), kokemus (minipelien käsi, _hand_shake) ja
	# humalan palkinto (tappelun iskut) luetaan siellä, missä niitä käytetään.


## Minipelien käden huojunta (game.drunk): humala, ja kokemus-tila vakauttaa (-0,15) tai horjuttaa (+0,15).
func _hand_shake() -> float:
	return clampf(tilat.value("humala") - 0.15 * tilat.effect("kokemus"), 0.0, 1.0)


var _today: Array = []  # tänään jo saadut kertabonukset (ettei E:n hakkaaminen kasvata tiloja loputtomiin)


## Kertabonus päivässä: palauttaa true vain ensimmäisellä kerralla tänään.
func _once_today(id: String) -> bool:
	if id in _today:
		return false
	_today.append(id)
	return true


## Mukava paikka: syttynyt nuotio laavulla, tuli kodassa, Kiilinlammen grillikatos tai mökin piha.
func _pleasant_spot() -> bool:
	var p := player.global_position
	if p.distance_to(mokki.global_position) < 35.0:
		return true
	if fire_lit and p.distance_to(M.w(M.LAAVU)) < 8.0:
		return true
	if world.kota != null and world.kota.fire_on and p.distance_to(world.kota.global_position) < 8.0:
		return true
	return p.distance_to(M.w(M.GRILLIKATOS)) < 7.0


## Kalja (tai useampi): humala nousee, kipu hellittää, mutta moraali ja keskittyminen kärsivät.
func _drink(n: int) -> void:
	for i in n:
		_korkki("kalja")
	tilat.add("humala", 0.12 * n)
	tilat.add("kipu", 0.05 * n)
	tilat.add("stamina", 0.05 * n)
	tilat.add("nalka", 0.04 * n)
	tilat.add("moraali", -0.04 * n)
	tilat.add("keskittyminen", -0.05 * n)


## Avatusta pullosta jää korkki (#290): ensimmäinen aloittaa kansion, uusi ja harvinainen korkki kerrotaan.
func _korkki(laji: String) -> void:
	_korkki_key(Korkit.roll(laji, _korkki_rng, _juhannus()))
	# Voittokorkki: korkin alla "VOITIT PULLON", kauppa vaihtaa uuteen kaljaan (lisätään suoraan reppuun).
	if laji == "kalja" and not "uusi_yritys" in tilat.firsts and _korkki_rng.randf() < 0.1:
		tilat.first("uusi_yritys", 0.0)
		_queue_message("Korkin alla lukee \"UUSI YRITYS\". Kampanjakorkkeja! Joskus siinä lukee \"VOITIT PULLON\".", 3.5)
	elif laji == "kalja" and _korkki_rng.randf() < Korkit.VOITTO_P:
		beers += 1
		tilat.first("voittokorkki", 0.1)
		Sfx.play("win_small", -8.0)
		_queue_message("Korkin alla lukee \"VOITIT PULLON\"! Kassalla vaihdettiin uuteen. Kalja +1.", 3.5)


## Korkki kansioon (juominen, pullonkeräys, kirppiksen korkkilaatikko). Palauttaa true, jos se oli uusi.
func _korkki_key(key: String) -> bool:
	var uusi: bool = korkit.add(key)
	if korkit.new_full(key.split(":")[0]):
		tilat.add("moraali", 0.2)
		maine = clampf(maine + 2.0, 0.0, 100.0)
		Sfx.play("win_small", -6.0)
		_queue_message("Korkkikansion aukeama täynnä: %s! Kiitostarra kulmaan. Maine +2." % Korkit.BRANDS[key.split(":")[0]].nimi, 4.0)
		return uusi
	if tilat.first("korkki", 0.1):
		_queue_message("Korkki jäi käteen. \"Tää korkki on harvinainen... vai onko?\" Korkkikansio alkaa tästä.", 4.0)
	elif uusi and not key.ends_with(":tavallinen"):
		Sfx.play("pickup", -8.0, 1.4)
		_queue_message("Korkkikansioon harvinainen: %s! (%d / %d)" % [Korkit.nimi(key), korkit.distinct(), Korkit.total_slots()], 3.5)
	return uusi


## Monta korkkia kerralla (pullonkeräys, laatikko): palauttaa lyhyen kuvauksen ilmoitukseen.
func _korkit_kasa(n: int) -> String:
	var uudet: Array = []
	for i in n:
		var key := Korkit.roll("kalja" if _korkki_rng.randf() < 0.5 else "limu", _korkki_rng, _juhannus())
		if _korkki_key(key):
			uudet.append(Korkit.nimi(key))
	return "%d korkkia%s" % [n, (", uusi: " + ", ".join(uudet)) if not uudet.is_empty() else ""]


var _korkki_rng := RandomNumberGenerator.new()
const KORKKI_VIRHE_HINTA := 15.0  # Korkki-Raimo ostaa tupla-virhepainoksen


## Korkkiläpsy (#290, korkki_game.gd): Vaalan lavan pihan teinit illalla 18–23 kerran päivässä. Kumpikin panee 3 tuplaa
## (pelaajalta vain tuplat, teiniltä muiden pitäjien korkkeja), voitetut korkit kansioon.
const KorkkiGame := preload("res://scripts/korkki_game.gd")
var _lapsy_day := -1
var _lapsy_game: Node3D


func _start_korkkilapsy() -> void:
	if mopo_trip == null or mopo_trip.vaala == null or _lapsy_game != null or korkit.tuplat() < 3:
		return
	var vl: Node3D = mopo_trip.vaala
	var out := Vector3(0, 0, 1)
	for d in vl.doors:
		if d.id == "pihanuoret":
			out = d.out
	var mine: Array = korkit.take_tuplat_keys(3)
	_lapsy_day = day
	var g := KorkkiGame.new()
	g.drunk = tilat.value("humala")
	for k in mine:
		g.stack.append({"key": k, "up": false})
		g.stack.append({"key": Korkit.roll("kalja" if randf() < 0.5 else "limu", _korkki_rng, _juhannus()), "up": false})
	# Pelipaikka teinien vierestä pihalle päin, asfaltin korkeudella; kävelijä piiloon (oma kyykkyhahmo pelissä).
	var spot: Vector3 = vl.yard_teens_pos + out * 3.0
	spot.y = vl.h(spot.x, spot.z)
	g.face = out
	g.position = spot
	mopo_trip.stop()
	if is_instance_valid(mopo_trip.on_foot):
		mopo_trip.on_foot.visible = false
	_hud.visible = false
	CamCtl.free_mouse = true
	tilat.first("korkkilapsy", 0.3)
	g.finished.connect(_on_korkkilapsy_finished)
	_lapsy_game = g
	vl.add_child(g)


## Saloisten kaukalo: sama peli kaukalon iltateinien vieressä (hs_teens), pelaaja piiloon pelin ajaksi.
func _start_korkkilapsy_kaukalo() -> void:
	if _lapsy_game != null or not is_instance_valid(hs_teens) or korkit.tuplat() < 3:
		return
	var mine: Array = korkit.take_tuplat_keys(3)
	_lapsy_day = day
	var g := KorkkiGame.new()
	g.drunk = tilat.value("humala")
	for k in mine:
		g.stack.append({"key": k, "up": false})
		g.stack.append({"key": Korkit.roll("kalja" if randf() < 0.5 else "limu", _korkki_rng, _juhannus()), "up": false})
	# Kaukalon asfaltilla laidan vieressä teinien kohdalla (world.gd: kaukalo leveys 24 m X:n suunnassa, kierto 0,35,
	# asfaltin pinta y 0,045; teinien ringin keskipiste laidan takana X 15,5). Kamera kaukalon keskeltä päin.
	var kc := M.w2(M.KAUKALO)
	var spot := Vector3(kc.x, Terrain.h(kc.x, kc.y) + 0.045, kc.y) + Vector3(9.5, 0, 2.5).rotated(Vector3.UP, SaloinenTeinit.RINK_YAW)
	g.face = Vector3(-1, 0, 0).rotated(Vector3.UP, SaloinenTeinit.RINK_YAW)
	g.position = spot
	g.opp_name = "Tuomas"
	g.opp_look = SaloinenTeinit.LOOKS[2]  # kaukalon teini: punainen paita ja lippis
	player.visible = false
	player.controls_enabled = false
	_hud.visible = false
	CamCtl.free_mouse = true
	tilat.first("korkkilapsy", 0.3)
	g.finished.connect(func(won: Array, quit: bool) -> void:
		player.visible = true
		player.controls_enabled = true
		player.activate_camera()
		_on_korkkilapsy_finished(won, quit))
	_lapsy_game = g
	_hazards.add_child(g)


func _on_korkkilapsy_finished(won: Array, quit: bool) -> void:
	_lapsy_game = null
	CamCtl.free_mouse = false
	_hud.visible = true
	if mopo_trip != null and is_instance_valid(mopo_trip.on_foot):
		mopo_trip.on_foot.visible = true
	if mopo_trip != null:
		_mopo_resume()
	var uudet: Array = []
	for k in won:
		if _korkki_key(k):
			uudet.append(Korkit.nimi(k))
	_advance_clock(20.0)
	if won.size() > 3:
		tilat.first("korkkilapsy_voitto", 0.3)
		tilat.add("moraali", 0.1)
	_save_game()
	_show_message(("Lopetit kesken. " if quit else "") + "Korkkiläpsystä %d korkkia (panos 3)%s." % [won.size(),
		(", uusi: " + ", ".join(uudet)) if not uudet.is_empty() else ""], 4.0)


## Kultainen MM-korkki (#290): Raimo kertoo legendan, Pekka muistaa heittäneensä korkin saunan takaa pihan
## kivikkoon (Pekan talon pääty, world.neighbor_yards.pekka[3]); siellä kiiltää, E nostaa kerran. Raimo tarjoaa 200 €.
const MMKORKKI_HINTA := 200.0


func _mmkorkki_pos() -> Vector3:
	var y: Array = world.neighbor_yards.get("pekka", [])
	return y[3] if y.size() > 3 else Vector3.ZERO


func _mmkorkki_logic() -> void:
	if korkit == null or world == null or not "mmkorkki_pekka" in tilat.firsts or korkit.owned.has("mmkorkki"):
		return
	if _hint.text != "" or player == bike or state != "ulkona":
		return
	var c := _mmkorkki_pos()
	var p := player.global_position
	if c == Vector3.ZERO or Vector2(p.x - c.x, p.z - c.z).length() > 2.2:
		return
	_hint.text = "[E] Jokin kiiltää kivien välissä"
	if Input.is_action_just_pressed("interact"):
		_mmkorkki_pick()


func _mmkorkki_pick() -> void:
	if korkit.owned.has("mmkorkki"):
		return
	korkit.owned["mmkorkki"] = 1
	tilat.first("mmkorkki", 0.5)
	maine = clampf(maine + 3.0, 0.0, 100.0)
	Sfx.play("win", -4.0)
	_save_game()
	_show_message("Kultainen korkki, kyljessä \"MM 1995\". Kolmekymmentä vuotta Pekan kivikossa. Korkkikansion kansilehteen! Maine +3.", 6.0)


## Päivi ja korkkikansio (#290): kerran päivässä kotiin tullessa, jos kansiossa on kaljakorkkeja yli viisi. Mitä
## enemmän kaljakorkkeja limukorkkeihin nähden, sitä enemmän moraali kärsii.
func _paivi_korkit() -> void:
	if korkit == null or korkit.piilossa:
		return
	var kalja := 0
	var limu := 0
	for k in korkit.owned:
		var b: String = k.split(":")[0]
		if Korkit.BRANDS.has(b):
			if Korkit.BRANDS[b].laji == "kalja":
				kalja += int(korkit.owned[k])
			else:
				limu += int(korkit.owned[k])
	if kalja < 6 or not _once_today("paivi_korkit"):
		return
	tilat.add("moraali", -0.03 * clampf(float(kalja) / maxf(1.0, limu + 1.0), 1.0, 4.0))
	_queue_message("Päivi selaa korkkikansiota: \"%d kaljankorkkia. Montako kaljaa tässä kansiossa on, häh? Ja limua %d.\"" % [kalja, limu], 5.0)


## Korkki-Raimo kirppiksellä (#290): vaihtaa kaksi tuplaa puuttuvaan (ei virhepainoksia), ostaa tupla-virhepainoksia
## ja kertoo kultaisen MM-korkin legendan.
func _talk_korkkiraimo(id: String) -> void:
	match id:
		"korkki_vaihda":
			var puuttuu: Array = korkit.missing()
			if puuttuu.is_empty() or not korkit.take_tuplat(2):
				_talk_box.reply("Ei oo mitään vaihdettavaa, poika.", _talk_options())
				return
			var key: String = puuttuu[_korkki_rng.randi() % puuttuu.size()]
			_korkki_key(key)
			Sfx.play("pickup", -6.0, 1.3)
			_talk_box.reply(["Kaks tuplaa yhestä. Reilu kauppa, sano pankinjohtaja.", "Tää on mulla kolmena. Ota sää.",
				"Pidä hyvänä. Korkki on kuin ihminen, ei kahta samanlaista. Paitsi tuplat."].pick_random(), _talk_options(),
				"Vaihdoit kaksi tuplaa: %s kansioon (%d / %d)." % [Korkit.nimi(key), korkit.distinct(), Korkit.total_slots()])
		"korkki_myy":
			if not korkit.take_tuplat(1, "virhe"):
				return
			money += KORKKI_VIRHE_HINTA
			Sfx.play("coin", -4.0)
			_talk_box.reply("Virhepainos! Logo väärin päin. Näitä mää etsin. Viistoista euroa, ja kiitos.", _talk_options(),
				"Myit tupla-virhepainoksen. Rahaa %s €." % _eur(money))
		"korkki_mm_myy":
			korkit.owned.erase("mmkorkki")
			tilat.first("mmkorkki_myyty", 0.2)
			money += MMKORKKI_HINTA
			Sfx.play("coin", -2.0)
			_talk_box.reply("Kultainen! Mää oon etsiny tätä kolkytä vuotta. Tässä, ja kiitos. Sää et tiä mitä tää mulle merkkaa.",
				_talk_options(), "Myit kultaisen MM-korkin. Rahaa %s €." % _eur(money))
		"korkki_legenda":
			tilat.first("mmkorkki_legenda", 0.2)
			_talk_box.reply("Keväällä 95, ku Suomi voitti kiekon MM-kultaa, Oulun panimo teki juhlaerän kultaisilla korkeilla. " +
				"Sanotaan, että viimeinen säilyny korkki on täällä pitäjässä. Pekka kuulemma joi sen kaljan saunan jälkeen... " +
				"Se korkki lens jonnekin. Jos löydät, mää maksan siitä hyvin.", _talk_options())
const KORKKI_LAATIKKO := 0.10  # kirppiksen korkkilaatikko, €/korkki
const KORKKI_POYTA_HINTA := 0.10  # tuplakorkit omalta kirppispöydältä, €/kpl
## Kiiltävät korkit maastosta (#290): uimaranta, laavu ja Viitajärven laavu, kerran päivässä paikkaa kohden, kun kansio
## on aloitettu. Paikka on kiinteä siirtymä alueen keskeltä (hiekka ja nuotiopaikan reuna).
const KORKKI_LOYDOT := {"laavu": [M.LAAVU, Vector3(2.5, 0, -2.0)],
	"viita": [M.VIITA_LAAVU, Vector3(-2.5, 0, 2.0)]}


## Uimarannalla löytö penkin vierestä (world.uimaranta_bench on varmasti hiekalla, ei vedessä).
func _korkki_loyto_ids() -> Array:
	return ["uimaranta"] + KORKKI_LOYDOT.keys()


func _korkki_loyto_pos(id: String) -> Vector3:
	if id == "uimaranta":
		return world.uimaranta_bench + Vector3(1.4, 0, 0.6)
	return M.w(KORKKI_LOYDOT[id][0]) + KORKKI_LOYDOT[id][1]


func _korkki_loydot() -> void:
