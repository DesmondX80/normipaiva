## Aseman takana makasiinin takaovi (makasiini.gd): koputus avaa kurkistusluukun (rasvanappi_game.gd). Vaalassa
## sama makasiini on aseman vieressä (vaala.gd _build_makasiini, ovi "makasiini" _on_vaala_door).
func _makasiini_logic() -> void:
	if _hint.text != "" or world.makasiini_door == Vector3.ZERO or _rasva_game != null or Settings.get_v("k18_pois"):
		return
	var p := player.global_position
	if Vector2(p.x, p.z).distance_to(Vector2(world.makasiini_door.x, world.makasiini_door.z)) > 2.2:
		return
	if player == bike:
		_hint.text = "[F] Pyörältä pois, niin voit koputtaa makasiinin takaoveen"
		return
	_hint.text = "[E] Koputa takaoveen (punainen lamppu palaa)"
	if Input.is_action_just_pressed("interact") and not player.is_stunned():
		_start_rasvanappi()


func _start_rasvanappi() -> void:
	_act_begin()
	if not _in_vaala:
		player.velocity = Vector3.ZERO
	var g := RasvanappiGame.new()
	g.drunk = _hand_shake()
	var mr: Node3D = mopo_trip.vaala.makasiini_root if _in_vaala else world.makasiini_root
	g.door = mr.get_node_or_null("Takaovi") if mr != null else null
	g.sun = _sun
	g.finished.connect(_rasvanappi_result)
	add_child(g)
	_rasva_game = g


func _rasvanappi_result(r: Dictionary) -> void:
	_rasva_game = null
	_act_end()
	if not r.got_in:
		_show_message("Luukku paukahtaa kiinni. Punainen lamppu palaa edelleen.", 3.0)
		return
	tilat.first("rasvanappi", 0.5)
	tilat.add("stressi", 0.1)
	tilat.add("moraali", 0.04 * r.hits - 0.03 * r.licks)
	if r.early:
		_show_message("Pukeuduit pimeässä. Toinen sukka jäi jonnekin makasiiniin.", 3.5)
	elif r.hits > 0:
		_show_message("Rasvanappi pelattu: arvasit oikein %d kertaa, nuolit sormia %d. Tästä ei puhuta K-Marketissa." % [r.hits, r.licks], 4.5)
	else:
		_show_message("Rasvanappi pelattu: nuolit sormia %d kertaa. Suussa maistuu margariini koko illan." % r.licks, 4.5)


# --- Kolmiomittaus (#255) --------------------------------------------------------------------------------------
# Sytkärin mätsi kertoo vain etäisyyden. Kaveri mittaa lähtöpaikalta, toinen tekstaa etämittauksen ja pelaaja mittaa
# lisää missä vain (E, kun muuta toimintoa ei ole). Ympyrät näkyvät paperikartalla (paper_map.gd kolmio_rings), ja
# leikkauksessa on naisen talo. Väärällä ovella avaa joku muu. Oma lahja ostetaan kaupan tiskiltä (kauppias), ilman
# sitä ovi ei aukea. Oikealla ovella erikoissääntöinen Rasvanappi ja aamu. Saloisissa Joni ja Esa kaupan pihassa,
# Vaalassa Tero ja Timo Sivikin vieressä aseman pihassa. Tila: kolmiomittaus.gd, Sytkäri: sytkari.gd, ovet ja aamu:
# kolmio_kohtaus.gd.

const Vehicles := preload("res://scripts/vehicles.gd")
## Mintun omakotitalo Saloisten keskustan laidalla ja väärät ovet viereisissä taloissa (map_osm.gd BUILDINGS).
const KOLMIO_MINTTU := Vector2(168.1, 810.8)
const KOLMIO_VAARAT := [Vector2(148.7, 822.7), Vector2(165.9, 783.1), Vector2(129.9, 811.5)]
## Joni ja Esa kaupan pihassa (karttapikseli), Esan etämittaus kirkon parkkipaikalta.
const KOLMIO_KAVERIT := Vector2(97, 572)
const KOLMIO_DOOR_R := 2.2
## Katjan rivitalo Vaalassa: pisin asuinrakennus tällä etäisyydellä asemalta (vaala.gd house_doors).
const KOLMIO_VAALA_MIN := 80.0
const KOLMIO_VAALA_MAX := 350.0

var _kolmio_joni: CharacterBody3D
var _kolmio_esa: CharacterBody3D
var _kolmio_vaala_npcs: Array = []  # Tero ja Timo (vaala.gd:n lapsia)
var _kolmio_doors := {}  # kohde -> [[ovi (x/z), indeksi (-1 = nainen, muuten väärä ovi)], ...]
var _kolmio_vaala_spots := {}  # Vaalan lähtöpiste (aseman piha) ja etämittauksen piste (Veturitalli), paikallinen x/z
var _kolmio_vaala_built: Node3D  # vaala.gd, johon kaverit ja ovet on lisätty
var _kolmio_civic: Node3D  # Timon Sivikki aseman pihassa (vaala.gd:n lapsi)
## Sivikki-ajo Timon mittauspisteeseen ja takaisin: path (vaalan paikalliset pisteet), d (ajettu matka), dir (1 meno,
## -1 paluu), v (vauhti), vtec (kytkeytyi tällä osuudella), cam (ajokamera). Tyhjä = ei ajossa.
var _kolmio_drive := {}
var _kolmio_ui: CanvasLayer  # Sytkäri tai kohtaus auki
var _kolmio_anchor: Node3D  # Rasvanapin halli tämän yläpuolelle


## Paperikartalle (paper_map.gd): käynnissä olevan mittauksen ympyrät (kylässä maailman x/z, Vaalassa vaala.gd x/z).
## Kylän kartta kysyy "saloinen": kesäheilan mittauksen aikana sen ympyrät (_kolmio_sal_site).
func kolmio_rings(site: String) -> Array:
	if site == "saloinen":
		site = _kolmio_sal_site()
	return kolmio.st(site).rings if kolmio.stage(site) == "mittaus" else []


## Jonin ja Esan kohde: "koti" (luku 6, Kesäheila -96), kun sen mittaus on käynnissä, muuten Mintun "saloinen".
## Molemmat ovat kylän maailman x/z:ssa, ja kaverit, etämittaus kirkolta ja mittaus missä vain ovat samat.
func _kolmio_sal_site() -> String:
	return "koti" if kolmio.stage("koti") == "mittaus" else "saloinen"


func _kolmio_site_of(who: String) -> String:
	return who.substr(7)  # "kolmio_saloinen" -> "saloinen"


## Kaverin omat repliikit (kolmiomittaus.gd LINES "Nimi: ...") puhekupliin ilman nimeä.
func _kolmio_lines(site: String, nimi: String) -> Array:
	var out: Array = []
	for l: String in Kolmio.LINES[site]:
		if l.begins_with(nimi + ":"):
			out.append(l.substr(nimi.length() + 1).strip_edges())
	return out


func _kolmio_spawn_saloinen() -> void:
	_kolmio_joni = _villager("Joni", Looks.JONI, _kolmio_lines("saloinen", "Joni"), "arto", KOLMIO_KAVERIT)
	_kolmio_esa = _villager("Esa", Looks.ESA, _kolmio_lines("saloinen", "Esa"), "pekka", KOLMIO_KAVERIT + Vector2(1.7, 0.6))
	_kolmio_joni.rotation.y = PI * 0.15
	_kolmio_esa.rotation.y = -PI * 0.2
	_kolmio_joni.gap = 2.0
	_kolmio_esa.gap = 3.3
	for v: Node3D in [_kolmio_joni, _kolmio_esa]:
		v.set_meta("home", v.transform)


## OSM-talon ulko-oven edusta (world.gd _house: ovi etuseinän keskimmäisessä ikkunavälissä, -Z = etuseinä).
func _kolmio_house_door(f: Dictionary) -> Vector2:
	var l: float = f.l
	var d: float = f.d
	var n := maxi(2, int(l / 3.6))
	var x := -l / 2.0 + l * (floori(n / 2.0) + 0.5) / n
	var q: Vector3 = Basis(Vector3.UP, float(f.yaw)) * Vector3(x, 0, -d / 2.0 - 1.0)
	return (f.c as Vector2) + Vector2(q.x, q.z)


## Ovet kohteittain: Saloisissa OSM-taloista, Vaalassa _kolmio_vaala_setup. Kodin (luku 6) kohde on pelaajan oma
## etuovi (koputus _home_door_logicissa, ettei ovi vie sisään), väärät ovet ovat Saloisten väärät ovet.
func _kolmio_door_list(site: String) -> Array:
	if site == "koti" and not _kolmio_doors.has("koti") and world != null and home_door != Vector3.ZERO:
		var koti: Array = [[Vector2(home_door.x, home_door.z), -1]]
		for dd: Array in _kolmio_door_list("saloinen"):
			if dd[1] >= 0:
				koti.append(dd)
		_kolmio_doors["koti"] = koti
	if site == "saloinen" and not _kolmio_doors.has("saloinen") and world != null:
		var list: Array = []
		var all: Array = [KOLMIO_MINTTU]
		all.append_array(KOLMIO_VAARAT)
		for i in all.size():
			var f: Dictionary = world._osm_fit_at(all[i])
			if not f.is_empty():
				list.append([_kolmio_house_door(f), i - 1])
		_kolmio_doors["saloinen"] = list
	return _kolmio_doors.get(site, [])


## Naisen ovi (x/z kohteen kehyksessä).
func _kolmio_target(site: String) -> Vector2:
	for dd: Array in _kolmio_door_list(site):
		if dd[1] == -1:
			return dd[0]
	return Vector2.INF


## Pelaajan paikka kohteen kehyksessä (Saloisissa maailma, Vaalassa vaala.gd).
func _kolmio_me(site: String) -> Vector2:
	var p := player.global_position
	if site == "vaala":
		p = mopo_trip.vaala.to_local(p)
	return Vector2(p.x, p.z)


func _kolmio_start_point(site: String) -> Vector2:
	if site == "vaala":
		return _kolmio_vaala_spots.get("start", Vector2.ZERO)
	return Vector2(_kolmio_joni.global_position.x, _kolmio_joni.global_position.z)


func _kolmio_remote_point(site: String) -> Vector2:
	if site == "vaala":
		return _kolmio_vaala_spots.get("remote", Vector2.ZERO)
	return M.w2(M.KIRKKO)


## Saloisten kaverit, ovet ja etämittaus joka ruutu (_outside_logic).
func _kolmio_logic() -> void:
	if not is_instance_valid(_kolmio_joni):
		return
	if _k18_hide([_kolmio_joni, _kolmio_esa]):
		return
	_kesaheila_notice()
	var site := _kolmio_sal_site()
	var going := kolmio.stage(site) == "mittaus"
	var away := going and not kolmio.remote_done(site)  # Esa on kirkolla mittaamassa, kunnes tekstaa
	if _kolmio_esa.visible == away:
		_kolmio_esa.visible = not away
		_kolmio_esa.process_mode = Node.PROCESS_MODE_DISABLED if away else Node.PROCESS_MODE_INHERIT
	if kolmio.remote_step(site, get_process_delta_time()):
		_kolmio_remote(site)
	# Mittauksen ajan kaverit kulkevat jalan pelaajan perässä (pyörän selässä jäävät odottamaan, villager.gd follow).
	_kolmio_follow([_kolmio_joni, _kolmio_esa], walker_out if going and player == walker_out else null, going)
	if _hint.text != "" or _kolmio_ui != null:
		return
	if going:
		return  # mittauksen aikana kaverit seuraavat vieressä: juttelu ja koputus vasta muiden toimintojen jälkeen (_kolmio_measure_logic)
	for npc: CharacterBody3D in [_kolmio_joni, _kolmio_esa]:
		if npc.visible and npc.distance_to_player() < 4.2:
			_talk_hint("kolmio_saloinen", npc, player != bike)
			return
	if kolmio.stage("saloinen") != "mittaus" or player == bike:
		return
	var p := _kolmio_me("saloinen")
	for dd: Array in _kolmio_door_list("saloinen"):
		if p.distance_to(dd[0]) < KOLMIO_DOOR_R:
			_hint.text = "[E] Koputa oveen"
			if Input.is_action_just_pressed("interact") and not player.is_stunned():
				_kolmio_knock("saloinen", dd[1])
			return


## K-18-sisältö pois (asetus k18_pois): hahmot piiloon ja pysähdyksiin; palauttaa true, kun piilossa. Asetuksen
## vaihtuessa takaisin hahmot palaavat näkyviin (kolmiomittauksen Esan poissaolon hoitaa _kolmio_logic itse).
const K18_SIDE := ["rasvanappi", "pentti", "kolmio_saloinen", "kolmio_vaala", "iltakivat"]  # päiväkirjan tehtävät
const K18_LOPUT := ["minttu", "katja", "pentin_kyyti", "pentin_kiertue", "kulissit", "avoin_pelikortti", "kesaheila", "rasytuppi", "lettukunkku", "loylykunkku",
	"sivikkidisko", "karaokekunkku"]  # onnelliset loput ja legendaariset hetket
func _k18_hide(npcs: Array) -> bool:
	var off: bool = Settings.get_v("k18_pois")
	for v in npcs:
		if not is_instance_valid(v):
			continue
		if off and not v.has_meta("k18"):
			v.set_meta("k18", true)
			v.visible = false
			v.process_mode = Node.PROCESS_MODE_DISABLED
		elif not off and v.has_meta("k18"):
			v.remove_meta("k18")
			v.visible = true
			v.process_mode = Node.PROCESS_MODE_INHERIT
	return off


## Kaverit seuraavat (f) tai palaavat lähtöpaikalleen (meta "home"), kun tehtävä ei ole käynnissä (going = false).
func _kolmio_follow(npcs: Array, f: Node3D, going: bool) -> void:
	for v: Node3D in npcs:
		if not v.visible:
			continue
		v.follow = f
		if not going and v.has_meta("home") and v.transform.origin.distance_to((v.get_meta("home") as Transform3D).origin) > 0.5:
			v.transform = v.get_meta("home")


## Mittaus missä vain (viimeisenä _outside_logicissa, kun muuta vihjettä ei ole).
func _kolmio_measure_logic() -> void:
	var site := _kolmio_sal_site()
	if _hint.text != "" or _kolmio_ui != null or player == bike or kolmio.stage(site) != "mittaus":
		return
	var p := _kolmio_me(site)
	# Seuraavat kaverit ovat aina vieressä, joten koputus ja juttelu tulevat vasta muiden E-toimintojen jälkeen:
	# ensin ovi, sitten kaveri, jota pelaaja katsoo päin (lähellä), lopuksi Sytkärin mittaus.
	for dd: Array in _kolmio_door_list(site):
		if p.distance_to(dd[0]) < KOLMIO_DOOR_R:
			_hint.text = "[E] Koputa oveen"
			if Input.is_action_just_pressed("interact") and not player.is_stunned():
				_kolmio_knock(site, dd[1])
			return
	var eteen := -player.global_transform.basis.z
	for npc: CharacterBody3D in [_kolmio_joni, _kolmio_esa]:
		if not npc.visible or npc.distance_to_player() > 2.5:
			continue
		var suunta := npc.global_position - player.global_position
		suunta.y = 0.0
		if suunta.length() > 0.01 and Vector2(eteen.x, eteen.z).normalized().dot(Vector2(suunta.x, suunta.z).normalized()) > 0.6:
			_talk_hint("kolmio_" + site, npc, true)
			return
	if not kolmio.can_measure(site, p):
		return
	_hint.text = "[E] Avaa Sytkäri: kuinka kaukana %s on?" % Kolmio.SITES[site].woman
	if Input.is_action_just_pressed("interact") and not player.is_stunned():
		_kolmio_measure(site, p)


## Vaalan kaverit, mittaus ja etämittaus (_vaala_logic). Ovet ja Teron ja Timon juttelu ovat vaala.gd doors -listassa.
func _kolmio_vaala_logic() -> void:
	_kolmio_vaala_setup()
	if _k18_hide(_kolmio_vaala_npcs):
		return
	if not _kolmio_drive.is_empty():
		_kolmio_drive_step(get_process_delta_time())
		return
	for v: Node3D in _kolmio_vaala_npcs:
		v.target = player
	# Sivikki-ajon jälkeen Tero ja Timo kulkevat jalan pelaajan perässä; juttelupiste kulkee Teron mukana.
	var going := kolmio.stage("vaala") == "mittaus"
	var f: Node3D = mopo_trip.on_foot if going and kolmio.remote_done("vaala") else null
	_kolmio_follow(_kolmio_vaala_npcs, f, going)
	if not _kolmio_vaala_npcs.is_empty():
		for d: Dictionary in mopo_trip.vaala.doors:
			if d.id == "kolmio_kaverit":
				d.pos = mopo_trip.vaala.to_local(_kolmio_vaala_npcs[0].global_position) if f != null \
					else _kolmio_vaala_spots.get("door_home", d.pos)
				# Seuraavana juttelupiste on aina vieressä: pieni säde (5 m pienempi etusija), jotta ovet ja muut
				# toiminnot voittavat sen; kotipaikalla iso säde, jotta Teron ja Timon löytää (#8572288).
				d["r"] = 2.5 if f != null else 7.0
	if kolmio.remote_step("vaala", get_process_delta_time()):
		_kolmio_remote("vaala")
	if _hint.text != "" or _kolmio_ui != null or mopo_trip.on_foot == null or _talk_box.is_open() \
			or kolmio.stage("vaala") != "mittaus":
		return
	var p := _kolmio_me("vaala")
	if not kolmio.can_measure("vaala", p):
		return
	_hint.text = "[E] Avaa Sytkäri: kuinka kaukana Katja on?"
	if Input.is_action_just_pressed("interact"):
		_kolmio_measure("vaala", p)


## Vaalaan Katjan rivitalo, väärät ovet, Tero ja Timo Sivikin kanssa aseman pihaan (kerran, kun vaala on rakennettu).
func _kolmio_vaala_setup() -> void:
	if mopo_trip == null:
		return
	var vl: Node3D = mopo_trip.vaala
	if vl == null or not vl.built or vl == _kolmio_vaala_built:
		return
	_kolmio_vaala_built = vl
	var station: Vector3 = vl.station_door
	var best := {}
	for hd: Dictionary in vl.house_doors:
		var dd := Vector2(hd.pos.x - station.x, hd.pos.z - station.z).length()
		if dd >= KOLMIO_VAALA_MIN and dd <= KOLMIO_VAALA_MAX and (best.is_empty() or float(hd.len) > float(best.len)):
			best = hd
	if best.is_empty():
		push_warning("KOLMIO: Vaalasta ei löytynyt Katjan taloa (house_doors %d)" % vl.house_doors.size())
		return
	var bp: Vector3 = best.pos
	var near: Array = vl.house_doors.filter(func(hd: Dictionary) -> bool:
		return (hd.pos as Vector3).distance_to(bp) > 8.0 and (hd.pos as Vector3).distance_to(bp) < 120.0)
	near.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return (a.pos as Vector3).distance_to(bp) < (b.pos as Vector3).distance_to(bp))
	var list: Array = []
	var picks: Array = [best]
	picks.append_array(near.slice(0, 3))
	for i in picks.size():
		var hd: Dictionary = picks[i]
		var at: Vector3 = (hd.pos as Vector3) + (hd.out as Vector3) * 1.0
		list.append([Vector2(at.x, at.z), i - 1])
		vl.doors.append({"id": "kolmio_katja" if i == 0 else "kolmio_v%d" % (i - 1), "pos": at, "out": hd.out, "r": 3.0,
			"walk": true, "hint": "ovelle", "text": "Koputa oveen"})
	_kolmio_doors["vaala"] = list
	# Tero ja Timo seisovat aseman pihassa Sivikin vieressä; Timon mittauspiste Vaalantien varrella (_kolmio_road_spot).
	var asema: Array = vl.doors.filter(func(d: Dictionary) -> bool: return d.id == "asema")
	var out: Vector3 = asema[0].out if not asema.is_empty() else Vector3.FORWARD
	var side := Vector3(-out.z, 0, out.x)
	var base: Vector3 = station + out * 7.0
	_kolmio_vaala_spots["start"] = Vector2(base.x, base.z)
	var tgt := Vector2(bp.x, bp.z)
	var start := Vector2(base.x, base.z)
	var cp := base + side * 3.6
	_kolmio_vaala_spots.merge(_kolmio_road_spot(vl, Vector2(cp.x, cp.z), start, tgt), true)
	var civic := Node3D.new()
	vl.add_child(civic)
	Vehicles.civic(civic, Color(0.72, 0.04, 0.07), "VTC-916")  # punainen Honda Civic 3-ovinen (1987–91)
	civic.position = Vector3(cp.x, vl.h(cp.x, cp.z), cp.z)
	civic.rotation.y = B.yaw_to(side)
	_kolmio_civic = civic
	var who := [["Hevari-Tero", Looks.HEVARI_TERO, "Tero", "pekka"], ["Sivikki-Timo", Looks.SIVIKKI_TIMO, "Timo", "arto"]]
	for k in 2:
		var v := Villager.new()
		v.display_name = who[k][0]
		v.look = who[k][1]
		v.lines = _kolmio_lines("vaala", who[k][2])
		v.voice = who[k][3]
		v.target = player
		var q := base - side * (1.2 + k * 1.3) - out * 0.5  # Civicin vastakkaiselle puolelle (auto on side-suunnassa)
		v.position = Vector3(q.x, vl.h(q.x, q.z), q.z)
		v.rotation.y = B.yaw_to(-out)
		v.gap = 2.0 + k * 1.3
		v.ground_fn = func(gp: Vector3) -> float:
			var l := vl.to_local(gp)
			return vl.to_global(Vector3(l.x, vl.h(l.x, l.z), l.z)).y
		v.set_meta("home", v.transform)
		v.avoid = [[civic, 2.6]]  # Civic 4,2 m pitkä: puolikas ja hahmon leveys
		vl.add_child(v)
		_kolmio_vaala_npcs.append(v)
	_kolmio_vaala_spots["door_home"] = base - side * 1.8
	# r 7: lähin ovi voittaa (mopo_trip.gd), ja aseman odotussalin ovi on heidän vieressään; pienemmällä säteellä E avasi odotussalin.
	vl.doors.append({"id": "kolmio_kaverit", "pos": base - side * 1.8, "out": out, "r": 7.0, "walk": true,
		"hint": "Teron ja Timon luo", "text": "Juttele Teron ja Timon kanssa"})


## Timon mittauspiste Vaalantien varrella: tien näyte, joka on kauimpana aseman pihasta mutta alle 700 m Katjan
## talosta (ympyrät leikkaavat jyrkässä kulmassa), ja Sivikin reitti sinne (vaala.gd road: [x, y, z, ...]).
## Paikan nimi lähimmästä tunnetusta ovesta (alle 150 m), muuten "Vaalantien varresta".
func _kolmio_road_spot(vl: Node3D, car: Vector2, start: Vector2, tgt: Vector2) -> Dictionary:
	var road: Array = vl.road
	var i0 := 0
	var bi := -1
	var best_d := 0.0
	for i in road.size():
		var q := Vector2(road[i][0], road[i][2])
		if q.distance_to(car) < Vector2(road[i0][0], road[i0][2]).distance_to(car):
			i0 = i
		if q.distance_to(tgt) < 700.0 and q.distance_to(start) > best_d and not road[i][6]:
			best_d = q.distance_to(start)
			bi = i
	if bi < 0:
		return {"remote": start + Vector2(150, 0), "remote_name": "Vaalantien varresta", "route": PackedVector3Array()}
	var at := Vector2(road[bi][0], road[bi][2])
	var names := {"kmarket": "K-Marketin pihasta", "zabuki": "torin Zabukilta", "apteekki": "apteekin edestä", "gasthaus": "Gasthausin pihasta",
		"hotelli": "hotellin pihasta", "tyokkari": "työkkärin jonosta", "veturitalli": "Veturitallin pihasta"}
	var place := "Vaalantien varresta"
	var nd := 150.0
	for d: Dictionary in vl.doors:
		if names.has(d.id) and Vector2(d.pos.x, d.pos.z).distance_to(at) < nd:
			nd = Vector2(d.pos.x, d.pos.z).distance_to(at)
			place = names[d.id]
	# Aseman pihasta suoraan nurmikon yli lähimpään Vaalantien näytteeseen, sitten tietä pitkin.
	var route := PackedVector3Array([Vector3(car.x, vl.h(car.x, car.y), car.y)])
	var step := 1 if bi >= i0 else -1
	for i in range(i0, bi + step, step):
		route.append(Vector3(road[i][0], road[i][1], road[i][2]))
	return {"remote": at, "remote_name": place, "route": route, "road_i0": i0, "road_bi": bi}


const SIVIKKI_BOX := Vector3(1.8, 1.0, 4.0)  # Civicin törmäyslaatikko reitin tarkistuksessa (0,4–1,4 m maasta)
const SIVIKKI_CELL := 2.0  # reitinhaun ruutu (m)
const SIVIKKI_HAKU := 240.0  # reitinhaun säde aseman pihasta (m)


## Este Civicin kohdalla (xz-taso kohteen kehyksessä vl, keula fwd): rakennukset ja muut kiinteät esteet, ei maastoa,
## ei Sivikkiä itseään eikä hahmoja tai mopoa (ne väistävät tai ovat kyydissä).
func _sivikki_este(vl: Node3D, p: Vector2, fwd: Vector2, size := SIVIKKI_BOX) -> bool:
	var q := PhysicsShapeQueryParameters3D.new()
	var box := BoxShape3D.new()
	box.size = size
	q.shape = box
	q.collision_mask = 0xFFFFFFFF & ~Terrain.COLLISION_LAYER
	var lp := Vector3(p.x, vl.h(p.x, p.y) + 0.9, p.y)
	q.transform = vl.global_transform * Transform3D(Basis(Vector3.UP, atan2(-fwd.x, -fwd.y)), lp)
	for h: Dictionary in vl.get_world_3d().direct_space_state.intersect_shape(q, 8):
		var col: Object = h.collider
		if col == null or col is CharacterBody3D or (col is Node and _kolmio_civic != null and _kolmio_civic.is_ancestor_of(col)):
			continue
		return true
	return vl.wet(p.x, p.y)


## Suora a -> b vapaa (Civic 1,5 m välein suoran suuntaisena).
func _sivikki_suora(vl: Node3D, a: Vector2, b: Vector2) -> bool:
	var l := a.distance_to(b)
	var fwd := (b - a) / maxf(l, 0.001)
	var d := 0.0
	while d <= l:
		if _sivikki_este(vl, a + fwd * d, fwd):
			return false
		d += 1.5
	return true


## Sivikin reitti (lasketaan kerran ajon alussa, kun rakennusten törmäysmuodot ovat fysiikassa): aseman pihasta
## Vaalantielle ja tietä pitkin mittauspisteeseen. Pihasta tielle haetaan halvin reitti SIVIKKI_CELL-ruudukossa
## (Dijkstra, 8 naapuria): ajoalueella (vaala.gd drivable: tiet, sivukadut, pihat ja parkit) askel maksaa matkan verran,
## maastossa SIVIKKI_MAASTO-kertaisesti, ja esteet (rakennukset, autot) on kielletty. Sivikki siis ajaa teitä ja
## oikaisee maaston kautta vain, kun tietä ei ole tai kierros olisi pitkä. Suoristus vain, kun suora on vapaa eikä lisää
## maastossa ajettua matkaa. _kolmio_vaala_spots: "route", "lawn_n" (pihaosuudet alussa, maan pinnalla, ei kaistaa).
const SIVIKKI_MAASTO := 5.0


## Matka maastossa (ei ajoaluetta) suoralla a -> b, metrin näyttein.
func _sivikki_maastossa(vl: Node3D, a: Vector2, b: Vector2) -> float:
	var l := a.distance_to(b)
	var n := maxi(1, int(ceil(l)))
	var off := 0.0
	for i in n:
		var q := a.lerp(b, (i + 0.5) / n)
		if not vl.drivable(q.x, q.y):
			off += l / n
	return off


func _kolmio_sivikki_route() -> PackedVector3Array:
	var sp := _kolmio_vaala_spots
	var route: PackedVector3Array = sp.get("route", PackedVector3Array())
	if sp.get("route_ok", false) or route.size() < 2 or mopo_trip == null or not sp.has("road_bi"):
		return route
	var vl: Node3D = mopo_trip.vaala
	var road: Array = vl.road
	var bi: int = sp.road_bi
	var start := Vector2(route[0].x, route[0].z)
	var n := int(SIVIKKI_HAKU * 2.0 / SIVIKKI_CELL)
	var o := start - Vector2.ONE * SIVIKKI_HAKU
	var cell_p := func(k: int) -> Vector2: return o + (Vector2(k % n, int(k / n)) + Vector2(0.5, 0.5)) * SIVIKKI_CELL
	var k0 := int(SIVIKKI_HAKU / SIVIKKI_CELL) * n + int(SIVIKKI_HAKU / SIVIKKI_CELL)
	var cost := {k0: 0.0}
	var prev := {k0: -1}
	var done := {}
	var blocked := {}
	var heap: Array = [[0.0, k0]]  # binäärikeko [hinta, ruutu]
	var goal := -1
	var join := -1
	while not heap.is_empty():
		# Pienin pois keosta.
		var top: Array = heap[0]
		var last: Array = heap.pop_back()
		if not heap.is_empty():
			heap[0] = last
			var i := 0
			while true:
				var l := i * 2 + 1
				var m := i
				if l < heap.size() and heap[l][0] < heap[m][0]:
					m = l
				if l + 1 < heap.size() and heap[l + 1][0] < heap[m][0]:
					m = l + 1
				if m == i:
					break
				var t: Array = heap[i]
				heap[i] = heap[m]
				heap[m] = t
				i = m
		var k: int = top[1]
		if done.has(k):
			continue
		done[k] = true
		var cp: Vector2 = cell_p.call(k)
		var ni: Array = vl.nearest(Vector3(cp.x, 0, cp.y))
		if k != k0 and ni[0] >= 0 and not road[ni[0]][6] and ni[1] < float(road[ni[0]][4]):
			goal = k
			join = ni[0]
			break
		var cx := k % n
		var cz := int(k / n)
		for dz in [-1, 0, 1]:
			for dx in [-1, 0, 1]:
				var nx: int = cx + dx
				var nz: int = cz + dz
				if (dx == 0 and dz == 0) or nx < 0 or nz < 0 or nx >= n or nz >= n:
					continue
				var nk := nz * n + nx
				if done.has(nk):
					continue
				var np: Vector2 = cell_p.call(nk)
				if not blocked.has(nk):
					blocked[nk] = _sivikki_este(vl, np, Vector2(dx, dz).normalized(), Vector3(2.6, 1.0, 2.6))
				if blocked[nk]:
					continue
				var step := SIVIKKI_CELL * (1.4142 if dx != 0 and dz != 0 else 1.0)
				var c: float = cost[k] + step * (1.0 if vl.drivable(np.x, np.y) else SIVIKKI_MAASTO)
				if c < float(cost.get(nk, INF)):
					cost[nk] = c
					prev[nk] = k
					# Keko: lisää loppuun ja nosta.
					heap.append([c, nk])
					var j := heap.size() - 1
					while j > 0:
						var pj := int((j - 1) / 2)
						if heap[pj][0] <= heap[j][0]:
							break
						var t2: Array = heap[pj]
						heap[pj] = heap[j]
						heap[j] = t2
						j = pj
	if goal < 0:
		push_warning("KOLMIO: Sivikin reittiä aseman pihasta tielle ei löytynyt esteiden ohi")
		sp["route_ok"] = true
		return route
	var path: Array = []
	var kk := goal
	while kk >= 0:
		path.push_front(cell_p.call(kk))
		kk = prev[kk]
	path[0] = start
	path.append(Vector2(road[join][0], road[join][2]))
	# Suoristus: kauimpaan pisteeseen, jonne suora on vapaa eikä kulje maastossa enempää kuin ruutureitti.
	var hop: Array = []
	var at := 0
	while at < path.size() - 1:
		var nxt := at + 1
		for j in range(path.size() - 1, at + 1, -1):
			var via := 0.0
			for m in range(at, j):
				via += _sivikki_maastossa(vl, path[m], path[m + 1])
			if _sivikki_maastossa(vl, path[at], path[j]) <= via + 0.5 and _sivikki_suora(vl, path[at], path[j]):
				nxt = j
				break
		hop.append(path[nxt])
		at = nxt
	var out := PackedVector3Array([route[0]])
	for q: Vector2 in hop.slice(0, hop.size() - 1):
		out.append(Vector3(q.x, vl.h(q.x, q.y), q.y))
	var dstep := 1 if bi >= join else -1
	for i in range(join, bi + dstep, dstep):
		out.append(Vector3(road[i][0], road[i][1], road[i][2]))
	var off := 0.0
	var prevp := start
	for q: Vector2 in hop:
		off += _sivikki_maastossa(vl, prevp, q)
		prevp = q
	sp["route"] = out
	sp["lawn_n"] = hop.size()
	sp["off_road"] = off
	sp["route_ok"] = true
	if B.diag():
		print("KOLMIO Sivikin reitti: %d pihaosuutta, maastossa %.0f m, liittymä tien näytteeseen %d, %.0f m, ruutuja tutkittu %d" % [
			hop.size(), off, join, _kolmio_route_len(out), done.size()])
	return out


## Sivikki-ajo alkaa (Teron ja Timon juttelu): kaverit ja pelaaja kyytiin, ajokamera auton taakse.
func _kolmio_drive_start() -> void:
	var route := _kolmio_sivikki_route()
	if route.size() < 2 or _kolmio_civic == null:
		_kolmio_remote("vaala")  # varalla tekstiviesti, jos tietä ei löytynyt
		return
	var vl: Node3D = mopo_trip.vaala
	var cam := Camera3D.new()
	cam.fov = 62.0
	cam.top_level = true
	vl.add_child(cam)
	cam.current = true
	_kolmio_drive = {"d": 0.0, "dir": 1, "v": 0.0, "vtec": false, "cam": cam, "home": _kolmio_civic.transform,
		"len": _kolmio_route_len(route), "line": 0, "line_t": 0.0,
		"engine": Sfx.loop_on(_kolmio_civic, "engine", -6.0), "stereo": _sivikki_stereo()}
	for v: Node3D in _kolmio_vaala_npcs:
		v.visible = false
	mopo_trip.on_foot.visible = false
	mopo_trip.on_foot.process_mode = Node.PROCESS_MODE_DISABLED
	mopo_trip.menu_open = true  # E ei avaa ovia ajon aikana
	Sfx.play("door_close", -4.0)
	_queue_message("Timo: \"Turvavyöt. Tero, pidä kiinni. Tää on kakkosvaihde ja VTEC.\"", 3.5)


## Sivikin stereot: 90-luvun tanssibiisi (kuulokkeiden kansio, ei tunnistettavaa biisiä) satunnaisesta kohdasta väylän
## SIVIKKI_BUS läpi: bassot ylös, diskantti pois ja vähän säröä, eli auton läpi kuuluva bassojytke.
const SIVIKKI_BUS := "Sivikki"
func _sivikki_stereo() -> AudioStreamPlayer3D:
	if AudioServer.get_bus_index(SIVIKKI_BUS) < 0:
		AudioServer.add_bus()
		var bi := AudioServer.bus_count - 1
		AudioServer.set_bus_name(bi, SIVIKKI_BUS)
		AudioServer.set_bus_send(bi, "Music" if AudioServer.get_bus_index("Music") >= 0 else "Master")
		var eq := AudioEffectEQ6.new()  # 32, 100, 320, 1000, 3200, 10000 Hz
		for band: Array in [[0, 9.0], [1, 8.0], [2, 2.0], [3, -4.0], [4, -12.0], [5, -20.0]]:
			eq.set_band_gain_db(band[0], band[1])
		AudioServer.add_bus_effect(bi, eq)
		var lp := AudioEffectLowPassFilter.new()
		lp.cutoff_hz = 700.0
		AudioServer.add_bus_effect(bi, lp)
		var dist := AudioEffectDistortion.new()  # ylikuormitettu subwoofer
		dist.mode = AudioEffectDistortion.MODE_OVERDRIVE
		dist.drive = 0.35
		dist.pre_gain = -6.0
		dist.post_gain = -2.0
		AudioServer.add_bus_effect(bi, dist)
	var list: Array[String] = Headphones.playlist()
	if list.is_empty() or _kolmio_civic == null:
		return null
	var st: AudioStream = load(list.pick_random())
	if st == null:
		return null
	var p := AudioStreamPlayer3D.new()
	p.stream = st
	p.bus = SIVIKKI_BUS
	p.volume_db = 2.0
	p.unit_size = 8.0
	p.max_db = 6.0
	_kolmio_civic.add_child(p)
	p.play(randf_range(15.0, maxf(16.0, st.get_length() - 60.0)))
	return p


static func _kolmio_route_len(route: PackedVector3Array) -> float:
	var n := 0.0
	for i in route.size() - 1:
		n += route[i].distance_to(route[i + 1])
	return n


## Piste ja suunta reitillä matkan d kohdalla (oikea kaista 1,7 m keskiviivasta, kun lähtöpihasta on päästy).
func _kolmio_route_at(route: PackedVector3Array, d: float, dir: int) -> Array:
	var lawn_n: int = _kolmio_vaala_spots.get("lawn_n", 1)  # nurmikko-osuudet alussa (_kolmio_sivikki_route)
	var left := d
	for i in route.size() - 1:
		var a := route[i]
		var b := route[i + 1]
		var l := a.distance_to(b)
		if left <= l or i == route.size() - 2:
			var p := a.lerp(b, clampf(left / maxf(l, 0.001), 0.0, 1.0))
			var fwd := (b - a).normalized() * dir
			var right := Vector3(-fwd.z, 0, fwd.x)
			if i >= lawn_n:
				p += right * 1.7
			else:  # nurmikko aseman pihasta tielle: maanpinnan korkeudella
				p.y = mopo_trip.vaala.h(p.x, p.z)
			return [p, fwd]
		left -= l
	return [route[route.size() - 1], Vector3.FORWARD]


## Ajo ruutu kerrallaan: kiihdytys, VTEC-hetki, kamera perässä ja jutut. Perillä Timo mittaa; paluussa kaverit ulos
## aseman pihaan. E = hyppää osuuden loppuun.
func _kolmio_drive_step(delta: float) -> void:
	var dr := _kolmio_drive
	var route: PackedVector3Array = _kolmio_vaala_spots.route
	var total: float = dr.len
	var left: float = total - dr.d
	var top := 22.0 if left > 60.0 and dr.d > 30.0 else 8.0
	dr.v = move_toward(dr.v, top, (6.0 if dr.v < top else 9.0) * delta)
	dr.d = minf(total, dr.d + dr.v * delta)
	if Input.is_action_just_pressed("interact"):
		dr.d = total
	var engine: AudioStreamPlayer3D = dr.engine
	if dr.v > 12.0 and not dr.vtec:
		dr.vtec = true
		Sfx.play("whoosh", -2.0, 0.6)
		_queue_message("VTEC KYTKEYTYI. Timo: \"Kuuliks! Seittemäntuhatta!\" Tero: \"Mää kuulin bensan hinnan.\"", 3.5)
	if is_instance_valid(engine):
		engine.pitch_scale = (0.9 + dr.v / 22.0 * 0.5) * (1.35 if dr.vtec and dr.v > 12.0 else 1.0)
	var dist: float = dr.d if dr.dir == 1 else total - dr.d
	var at: Array = _kolmio_route_at(route, dist, dr.dir)
	var p: Vector3 = at[0]
	var fwd: Vector3 = at[1]
	_kolmio_civic.position = p
	if fwd.length() > 0.1:
		_kolmio_civic.rotation.y = B.yaw_to(fwd)
	var cam: Camera3D = dr.cam
	var eye := _kolmio_civic.global_position - fwd * 7.5 + Vector3(0, 3.2, 0)
	cam.global_position = cam.global_position.lerp(eye, 1.0 - exp(-4.0 * delta)) if dr.d > 0.5 else eye
	cam.look_at(_kolmio_civic.global_position + Vector3(0, 0.9, 0) + fwd * 2.0, Vector3.UP)
	dr.line_t += delta
	if dr.line_t > 6.0:
		dr.line_t = 0.0
		var lines: Array = Kolmio.DRIVE_LINES
		_queue_message(lines[dr.line % lines.size()], 4.0)
		dr.line += 1
	_hint.text = "[E] Perille" if dr.dir == 1 else "[E] Takaisin asemalle"
	if dr.d < total:
		return
	if dr.dir == 1:
		dr.dir = -1
		dr.d = 0.0
		dr.v = 0.0
		dr.vtec = false
		_kolmio_civic.position = route[route.size() - 1]  # käännös tien päällä
		var r: Dictionary = kolmio.measure("vaala", _kolmio_vaala_spots.remote, _kolmio_target("vaala"), "Timo")
		Sfx.play("bell", -10.0, 2.8)
		_queue_message("Timo %s: \"%s päässä. Mää piirrän, sää pidät harppia.\" (kartta M)" % [_kolmio_vaala_spots.remote_name,
			Kolmio.dist_text(r.m)], 4.5)
		_save_game()
		return
	_kolmio_drive_end()


func _kolmio_drive_end() -> void:
	var dr := _kolmio_drive
	_kolmio_drive = {}
	_kolmio_civic.transform = dr.home
	if is_instance_valid(dr.engine):
		(dr.engine as Node).queue_free()
	var st: Node = dr.get("stereo")
	if is_instance_valid(st):  # stereot hiljenevät ovien auetessa
		var tw := st.create_tween()
		tw.tween_property(st, "volume_db", -40.0, 0.6)
		tw.tween_callback(st.queue_free)
	(dr.cam as Node).queue_free()
	for v: Node3D in _kolmio_vaala_npcs:
		v.visible = true
	var w: CharacterBody3D = mopo_trip.on_foot
	w.visible = true
	w.process_mode = Node.PROCESS_MODE_INHERIT
	var kd: Array = mopo_trip.vaala.doors.filter(func(d: Dictionary) -> bool: return d.id == "kolmio_kaverit")
	if not kd.is_empty():
		var at: Vector3 = kd[0].pos + (kd[0].out as Vector3) * 2.5  # kaverien eteen, ei heidän sisäänsä
		w.global_position = mopo_trip.vaala.to_global(at) + Vector3(0, 0.5, 0)
	w.activate_camera()
	mopo_trip.menu_open = false
	Sfx.play("door_close", -4.0)
	_queue_message("Tero: \"Takas asemalla. Mittaa sää loput (E missä vain), ympyrät kartalle (M).\"", 4.0)


## Vaalan ovet piiloon, kun niille ei ole asiaa: talojen ovet vain mittauksen aikana.
func _kolmio_door_hidden(id: String) -> bool:
	if id == "kolmio_kaverit":
		return false
	return kolmio.stage("vaala") != "mittaus"


func _kolmio_vaala_door(id: String) -> void:
	if id == "kolmio_kaverit":
		_talk_open("kolmio_vaala", _kolmio_vaala_npcs[0] if not _kolmio_vaala_npcs.is_empty() else null)
		return
	_kolmio_knock("vaala", -1 if id == "kolmio_katja" else int(id.substr(8)))  # "kolmio_v1" -> 1


func _kolmio_options(who: String, o: Array) -> void:
	var site := _kolmio_site_of(who)
	var s: Dictionary = kolmio.st(site)
	match s.stage:
		"mittaus":
			if Kolmio.SITES[site].get("drive", false) and not kolmio.remote_done(site):
				o.append(_opt("kolmio_sivikki", "Hypätään Sivikkiin: Timo ajaa toiselle puolelle kylää mittaamaan", true, "", true))
			o.append(_opt("kolmio_tilanne", "Missä ne ympyrät nyt menee?"))
			if not (Kolmio.SITES[site].gifts as Array).is_empty():
				o.append(_opt("kolmio_lahjat", "Onks teillä lahjat valmiina?", true, "", not s.gift))
		_:
			var why := ""
			if s.stage == "valmis" and s.done_day == day:
				why = "eilinen ilta vielä mielessä: huomenna uudestaan"
			elif kolmio.busy_today(day):
				why = "tämän illan kolmiomittaus on jo tehty"
			elif _kolmio_target(site) == Vector2.INF:
				why = "Sytkäri ei löydä ketään"
			if site == "saloinen" and _kesaheila_auki():
				o.append(_opt("kolmio_kesaheila", "Näytä Sytkärin uusi mätsi: Kesäheila -96, Saloinen", why == "" and \
					_kolmio_target("koti") != Vector2.INF, why, true))
			var text := "Mitä te siinä puhelimen kanssa kytätte?" if s.stage == "" else "Mittaillaanko taas?"
			o.append(_opt("kolmio_aloita", text, why == "", why, s.stage == ""))


## Kaupan tiskiltä oma lahja (kauppias, sama sisätila Saloisissa ja Vaalassa).
func _kolmio_gift_option(o: Array) -> void:
	var site := "vaala" if _in_vaala else "saloinen"
	var s: Dictionary = kolmio.st(site)
	if s.stage != "mittaus" or s.gift:
		return
	var info: Dictionary = Kolmio.SITES[site]
	o.append(_opt("kolmio_lahja", "Osta %s tiskiltä (%s €)" % [info.gift_me, _eur(Kolmio.GIFT_PRICE)], money >= Kolmio.GIFT_PRICE,
		"rahat ei riitä", true))


func _kolmio_choose(id: String) -> void:
	var site := "vaala" if _in_vaala else "saloinen"
	if _talk_who.begins_with("kolmio_"):
		site = _kolmio_site_of(_talk_who)
	var info: Dictionary = Kolmio.SITES[site]
	var s: Dictionary = kolmio.st(site)
	match id:
		"kolmio_lahja":
			money -= Kolmio.GIFT_PRICE
			interior.money -= Kolmio.GIFT_PRICE
			s.gift = true
			Sfx.play("coin", -4.0)
			_save_game()
			_talk_box.reply("Kaunis valinta. Joku on onnekas tänään." if site == "saloinen" else "Kotimaisia, Suonenjoelta. Tuliko tietäjä hakemaan?",
				_talk_options(), "%s mukana: kolmas lahja kolmannelle tietäjälle." % String(info.gift_me).capitalize())
		"kolmio_aloita":
			_talk_box.close()
			var r: Dictionary = kolmio.start(site, _kolmio_start_point(site), _kolmio_target(site), "Joni" if site == "saloinen" else "Tero")
			tilat.first("kolmio_" + site, 0.3)
			_save_game()
			_kolmio_phone(site, "match", Kolmio.dist_text(r.m))
		"kolmio_kesaheila":
			# Luku 6: sama mittaus kuin Mintulle, mutta ympyrät leikkaavat pelaajan oman kodin (jälkeä ei synny).
			_talk_box.close()
			var r: Dictionary = kolmio.start("koti", _kolmio_start_point("koti"), _kolmio_target("koti"), "Joni")
			tilat.first("kesaheila_matsi", 0.0)
			_save_game()
			_kolmio_phone("koti", "match", Kolmio.dist_text(r.m))
		"kolmio_sivikki":
			_talk_box.close()
			_kolmio_drive_start()
		"kolmio_tilanne":
			var n: int = (s.rings as Array).size()
			var line := "Esa: Kartalla on %d ympyrää. Siellä missä ne kaikki risteää, siellä on Mintun talo. Avaa kartta (M)." % n \
				if site == "saloinen" else "Timo: %d ympyrää kartalla. Tero sanoo, että valtio tietää jo vastauksen. Avaa kartta (M)." % n
			if site == "koti":
				line = "Esa: Kartalla on %d ympyrää. Ne vetää kumman lähelle sun kotia. Avaa kartta (M)." % n
			if n < 3:
				line += " Tarvitaan vielä %d mittausta eri paikoista." % (3 - n)
			_talk_box.reply(line, _talk_options(), "Mittaa missä vain: E, kun Sytkäri-vihje näkyy (vähintään %d m edellisistä). Lähempää mitattu ympyrä on tarkempi." % int(Kolmio.MIN_GAP))
		"kolmio_lahjat":
			var gifts := "Esa: Mansikat on poimittu. Joni: Kermavaahto on rinkassa jesarin alla. Sää tuot ruusut, kauppa myy tiskiltä." \
				if site == "saloinen" else "Timo: Kermavaahto on Sivikin takakontissa. Tero: Ruusut ostin, valtio veis nääki verona. Sää tuot mansikat, K-Marketin tiskiltä."
			_talk_box.reply(gifts, _talk_options(), "Oma lahja mukana ✔" if s.gift else "Oma lahja puuttuu: %s kaupan tiskiltä." % info.gift_me)


## Sytkäri esiin: match (mätsi ja ensimmäinen etäisyys) tai matka (mittaus tästä paikasta ja kaverin viesti).
func _kolmio_phone(site: String, mode: String, dist: String, note := "") -> void:
	var info: Dictionary = Kolmio.SITES[site]
	var ui := Sytkari.new()
	ui.mode = mode
	ui.who = info.woman
	ui.age = info.age
	ui.job = info.job
	ui.bio = info.bio
	ui.dist = dist
	if note != "":
		ui.note_from = note.get_slice(":", 0)
		ui.note = note.substr(note.find(":") + 1).strip_edges()
	_kolmio_hold(true)
	ui.closed.connect(func() -> void:
		_kolmio_ui = null
		_kolmio_hold(false)
		if mode == "match":
			_kolmio_briefing(site))
	add_child(ui)
	_kolmio_ui = ui


## Puhelin esillä: ohjaus pois. Saloisissa kuten välikuvassa, Vaalassa vain kävelijä pysähtyy (näkyy puhelimen takana).
## Sulkeva E ei saa samalla ruudulla käynnistää muuta toimintoa (_talk_end_frame).
func _kolmio_hold(on: bool) -> void:
	_talk_end_frame = Engine.get_process_frames()
	if not _in_vaala:
		if on:
			_act_begin()
		else:
			_act_end()
		return
	walker_out.controls_enabled = not on
	walker_out.speed = 0.0
	_hud.visible = not on
	_mopo_menu(on)  # mopomatkan ovet eivät ota puhelimen sulkevaa E:tä


func _kolmio_briefing(site: String) -> void:
	if site == "koti":
		_queue_message("Joni: \"Kesäheila -96? Mää mittasin tästä, Esa lähti kirkolle. Toi hattu on jotenki tuttu.\"", 4.5)
		_queue_message("Esa: \"Mittaa sää jostain muualta (E missä vain), ympyrät harpilla kartalle (M). Lahjoja ei tarvita: kerma ja mansikat sillä on jo.\"", 5.5)
		return
	if site == "saloinen":
		_queue_message("Joni: \"Mätsi! Mutta osoitetta ei kerrota, vain matka. Mää mittasin tästä, Esa lähti kirkolle.\"", 4.5)
		_queue_message("Esa: \"Mittaa sää jostain muualta (E missä vain). Ympyrät harpilla kartalle (M), ja ruusut kaupan tiskiltä.\"", 5.0)
	else:
		_queue_message("Tero: \"Mätsi. Ja valtio tietää sen jo. Mää mittasin aseman pihasta.\"", 4.0)
		_queue_message("Timo: \"Seuraava mittaus Sivikillä toiselta puolelta kylää. Hyppää kyytiin (puhu meille). Mittaa sää lisää (E missä vain), mansikat K-Marketin tiskiltä.\"", 6.0)


func _kolmio_measure(site: String, at: Vector2) -> void:
	var r: Dictionary = kolmio.measure(site, at, _kolmio_target(site), "Sinä")
	_save_game()
	_kolmio_phone(site, "matka", Kolmio.dist_text(r.m), kolmio.next_measure_line(site))


## Kaverin etämittaus tekstiviestinä (ei avaa puhelinta: voi tulla ajaessa).
func _kolmio_remote(site: String) -> void:
	var info: Dictionary = Kolmio.SITES[site]
	var r: Dictionary = kolmio.measure(site, _kolmio_remote_point(site), _kolmio_target(site), info.remote)
	Sfx.play("bell", -10.0, 2.8)
	var place: String = _kolmio_vaala_spots.get("remote_name", info.remote_place) if site == "vaala" else info.remote_place
	_queue_message("%s tekstaa %s: \"%s päässä. Harpilla kartalle.\" (kartta M)" % [info.remote, place, Kolmio.dist_text(r.m)], 4.5)
	_save_game()


## Ovelle koputus: väärä ovi (idx >= 0) tai naisen ovi (-1, lahjat ja Rasvanappi).
func _kolmio_knock(site: String, idx: int) -> void:
	var info: Dictionary = Kolmio.SITES[site]
	var ui := KolmioKohtaus.new()
	ui.site = site
	ui.woman = info.woman
	ui.friends = info.friends
	if idx >= 0:
		ui.mode = "vaara"
		ui.resident = kolmio.wrong_door(site, idx)
	else:
		ui.mode = "ovi"
		ui.gifts = info.gifts
		ui.missing = "" if kolmio.st(site).gift else String(info.gift_me)
	_act_begin()
	ui.finished.connect(func(r: Dictionary) -> void:
		_kolmio_ui = null
		_talk_end_frame = Engine.get_process_frames()
		if r.mode == "ovi" and site == "koti":
			_act_end()
			_kesaheila_valinta("No? Mitä sää nyt sanot, Sytkärin sankari? Sinikka, älä naura!")
			return
		if r.mode == "ovi" and r.ok:
			_kolmio_kiva(site, kolmio.next_kiva(site))
			return
		_act_end()
		if r.mode == "ovi":
			_show_message("Ovi kiinni. Oma lahja puuttuu: %s kaupan tiskiltä (%s €)." % [info.gift_me, _eur(Kolmio.GIFT_PRICE)], 4.5)
		else:
			tilat.add("moraali", -0.03)
		_save_game())
	add_child(ui)
	_kolmio_ui = ui


## Iltakivat sivutehtävää varten (quests.gd "iltakivat"): koettu kiva kirjataan aamulla tilat.first("kiva_<nimi>").
const KOLMIO_KIVAT := ["rasvanappi", "tuppi", "lettu", "loyly", "disko", "karaoke"]
const KOLMIO_KIVA_NIMET := {"rasvanappi": "Rasvanappi", "tuppi": "räsytuppi", "lettu": "lettukisa", "loyly": "löylykisa",
	"disko": "Sivikki-disko (Vaala)", "karaoke": "karaoke"}


## Iltakiva naisen luona: kohteen ensimmäinen ilta on Rasvanappi, seuraavat kiertävät (kolmiomittaus.gd KIVAT):
## räsytuppi, lettukisa, löylykisa, Sivikki-disko (Vaala) ja karaoke. Kaikki K-18 ja vähän rivoja.
func _kolmio_kiva(site: String, kiva: String) -> void:
	match kiva:
		"tuppi":
			_kolmio_tuppi(site)
		"lettu":
			_kolmio_ilta(site, LettuGame.new(), Kolmio.LETTU_LINES, "lettukunkku")
		"loyly":
			_kolmio_ilta(site, LoylyGame.new(), Kolmio.LOYLY_LINES, "loylykunkku")
		"disko":
			_kolmio_ilta(site, DiskoGame.new(), Kolmio.DISKO_LINES, "sivikkidisko")
		"karaoke":
			var k := IltaKaraoke.new()
			k.drunk = _hand_shake()
			_kolmio_ilta(site, k, Kolmio.KARAOKE_LINES, "karaokekunkku")
		_:
			_kolmio_rasvanappi(site)


## Ankkuri naisen talon kohdalle (iltakivojen hallit rakennetaan sen yläpuolelle).
func _kolmio_new_anchor(site: String) -> Node3D:
	var t := _kolmio_target(site)
	_kolmio_anchor = Node3D.new()
	if site == "vaala":
		var vl: Node3D = mopo_trip.vaala
		vl.add_child(_kolmio_anchor)
		_kolmio_anchor.position = Vector3(t.x, vl.h(t.x, t.y), t.y)
	else:
		add_child(_kolmio_anchor)
		_kolmio_anchor.global_position = Vector3(t.x, Terrain.h(t.x, t.y), t.y)
	return _kolmio_anchor


## Erikoissääntöinen Rasvanappi naisen pimennetyssä olohuoneessa (halli talon yläpuolella, ei ovea eikä portsaria).
func _kolmio_rasvanappi(site: String) -> void:
	var info: Dictionary = Kolmio.SITES[site]
	var t := _kolmio_target(site)
	_kolmio_anchor = Node3D.new()
	if site == "vaala":
		var vl: Node3D = mopo_trip.vaala
		vl.add_child(_kolmio_anchor)
		_kolmio_anchor.position = Vector3(t.x, vl.h(t.x, t.y), t.y)
	else:
		add_child(_kolmio_anchor)
		_kolmio_anchor.global_position = Vector3(t.x, Terrain.h(t.x, t.y), t.y)
	var rules: Dictionary = (Kolmio.RASVA_RULES[site] as Dictionary).duplicate(true)
	rules.merge({"host": info.woman, "kerma": true, "mansikka": true, "call": Kolmio.PAIVI_CALL}, true)
	var g := RasvanappiGame.new()
	g.drunk = _hand_shake()
	g.people = Kolmio.RASVA_PEOPLE[site]
	g.rules = rules
	g.anchor = _kolmio_anchor
	g.sun = _sun
	g.finished.connect(func(r: Dictionary) -> void: _kolmio_morning(site, r))
	add_child(g)
	_rasva_game = g


## Räsytuppi naisen olohuoneessa (toisesta kolmiomittauksesta alkaen samassa kohteessa): pelaaja ja nainen vastaan
## kaverit; ilta päättyy, kun pari on pantu tuppeen, ja aamu tulee kuten Rasvanapin jälkeen. Ensimmäinen voitto on
## legendaarinen hetki "rasytuppi".
const TUPPI_KAVERIT := {"saloinen": [["joni", "Joni"], ["esa", "Esa"]], "vaala": [["tero", "Tero"], ["timo", "Timo"]]}
const TUPPI_NAINEN := {"saloinen": "minttu", "vaala": "katja"}
func _kolmio_tuppi(site: String) -> void:
	var info: Dictionary = Kolmio.SITES[site]
	_kolmio_new_anchor(site)
	var k: Array = TUPPI_KAVERIT[site]
	var g := TuppiGame.new()
	g.site = site
	g.anchor = _kolmio_anchor
	g.sun = _sun
	g.style = (Kolmio.RASVA_RULES[site] as Dictionary).get("style", {})
	g.lines = Kolmio.TUPPI_LINES[site]
	g.seats = [{"id": "pelaaja", "name": "Sinä", "look": Looks.player()},
		{"id": k[0][0], "name": k[0][1], "look": RasvanappiGame.real_look(k[0][0])},
		{"id": TUPPI_NAINEN[site], "name": info.woman, "look": RasvanappiGame.real_look(TUPPI_NAINEN[site])},
		{"id": k[1][0], "name": k[1][1], "look": RasvanappiGame.real_look(k[1][0])}]
	g.finished.connect(func(r: Dictionary) -> void:
		if r.get("voitto", false):
			_ending("rasytuppi")
		r["kiva"] = "tuppi"
		_kolmio_morning(site, r))
	add_child(g)
	_rasva_game = g


## Kaverit ja nainen iltakivoihin: [pelaaja, kaveri, kaveri, nainen] ({"id", "name", "look"}).
func _kolmio_people(site: String) -> Array:
	var info: Dictionary = Kolmio.SITES[site]
	var k: Array = TUPPI_KAVERIT[site]
	return [{"id": "pelaaja", "name": "Sinä", "look": Looks.player()},
		{"id": k[0][0], "name": k[0][1], "look": RasvanappiGame.real_look(k[0][0])},
		{"id": k[1][0], "name": k[1][1], "look": RasvanappiGame.real_look(k[1][0])},
		{"id": TUPPI_NAINEN[site], "name": info.woman, "look": RasvanappiGame.real_look(TUPPI_NAINEN[site])}]


## Lettukisa, löylykisa, Sivikki-disko ja karaoke (lettu_game.gd ...): samat kentät ja finished-tulos; pelaajan voitto
## on legendaarinen hetki (ending).
func _kolmio_ilta(site: String, g: CanvasLayer, all_lines: Dictionary, ending: String) -> void:
	g.site = site
	g.anchor = _kolmio_new_anchor(site)
	g.sun = _sun
	g.style = (Kolmio.RASVA_RULES[site] as Dictionary).get("style", {})
	g.lines = all_lines.get(site, all_lines.values()[0])  # disko on vain Vaalassa: muualla Vaalan repliikit
	g.people = _kolmio_people(site)
	g.finished.connect(func(r: Dictionary) -> void:
		if r.get("voitto", false):
			_ending(ending)
		_kolmio_morning(site, r))
	add_child(g)
	_rasva_game = g


## Aamu naisen keittiössä, onnellinen loppu ja uusi päivä. Päivi soitti yöllä: maito on ostettava ennen kotiin menoa.
func _kolmio_morning(site: String, r: Dictionary) -> void:
	_rasva_game = null
	if is_instance_valid(_kolmio_anchor):
		_kolmio_anchor.queue_free()
	var info: Dictionary = Kolmio.SITES[site]
	kolmio.finish(site, day)
	tilat.first("rasvanappi", 0.5)
	if not r.get("luovutti", false):
		tilat.first("kiva_" + String(r.get("kiva", "rasvanappi")), 0.2)  # sivutehtävä "Kolmiomittauksen iltakivat"
	tilat.add("moraali", Kolmio.END_MORAALI)
	tilat.add("stressi", Kolmio.END_STRESSI)
	tilat.add("vireys", Kolmio.END_VIREYS)
	var ilta := "Mansikoita %d" % int(r.get("mansikat", 0))
	if r.has("rasy"):  # räsytuppi: kumpi pari pantiin tuppeen
		ilta = "Räsytuppi: kaverit tupessa ✔" if r.get("voitto", false) else "Räsytuppi: te tupessa, kalsareissa"
	elif r.has("kiva"):
		var nimi: String = {"tuppi": "Räsytuppi", "lettu": "Lettukisa", "loyly": "Löylykisa", "disko": "Sivikki-disko", "karaoke": "Karaoke"}.get(r.kiva, "Ilta")
		ilta = "%s: %s" % [nimi, "voitit ✔" if r.get("voitto", false) else ("luovutit" if r.get("luovutti", false) else "hävisit")]
	var stats := "Kolme ympyrää ✔  ·  Kolme lahjaa ✔  ·  %s  ·  %s" % [ilta, _ending_line(info.ending)]
	kolmio.maito_day = day + 1
	_save_game()
	var ui := KolmioKohtaus.new()
	ui.mode = "aamu"
	ui.site = site
	ui.woman = info.woman
	ui.friends = info.friends
	ui.stats = stats
	ui.kiva = String(r.get("kiva", "rasvanappi"))
	ui.finished.connect(func(_r: Dictionary) -> void:
		_kolmio_ui = null
		var intro := "Aamu %s keittiössä. Päivi tekstasi yöllä: \"MAITOA.\" Osta maitoa kaupasta ennen kuin menet kotiin.\n" % info.gen
		if site == "vaala":
			_gasthaus_morning(intro, "Huomenta Vaalasta! Katjan kahvit juotu, mopo odottaa Gasthausin pihassa. Muista maito.")
		else:
			var t := _kolmio_target(site)
			_new_day(Vector3(t.x, Terrain.h(t.x, t.y), t.y), false, intro))
	add_child(ui)
	_kolmio_ui = ui


## Kotiin tultaessa kolmiomittauksen jälkeisenä päivänä: maito mukana vai Päivin motkotus.
func _kolmio_maito_home() -> void:
	if kolmio.maito_day != day:
		return
	kolmio.maito_day = -1
	if paivi_bag.has("maito"):
		tilat.add("stressi", 0.1)
		if not shopping_list.any(func(it: Array) -> bool: return it[0] == "maito"):
			paivi_bag.erase("maito")  # Päivin pyytämä maito ei ole "listan ulkopuolinen" ostos
		_queue_message("Päivi: \"No niin, maitoa. Missä sää muuten olit koko yön?\" \"Kolmiomittaamassa.\" \"Joo joo.\"", 4.5)
	else:
		tilat.add("stressi", Kolmio.MAITO_STRESSI)
		tilat.add("moraali", Kolmio.MAITO_MORAALI)
		_queue_message("Päivi: \"MISSÄ SE MAITO ON?! Koko yö kolmiomittaamassa, eikä ees maitoa!\"", 4.5)
	_save_game()


# --- Kesäheila -96 (luku 6 "Päivi epäilee", #326) ----------------------------------------------------------------
# Kun Päivin huipennus on auki (rikos/paivi.gd huipennus_auki: epäluulo joskus yli 60 tai vastahyökkäys, K-18 sallittu),
# Sytkäri piippaa uudesta mätsistä, ja Joni ja Esa mittaavat sen kuten Mintun (kohde "koti", _kolmio_sal_site): ympyrät
# leikkaavat pelaajan oman kodin. Mittauksen ajan Päivin auto on kotipihassa (_wife_rhythm). Etuovella koputetaan
# (_kesaheila_ovi, ei sisälle), ovikohtaus on kolmio_kohtaus.gd:ssä ja sen jälkeen Päivin valinta:
#   nauraa    epäluulo 0, onnellinen loppu "kulissit" ja aamu omassa keittiössä (kerma ja mansikat)
#   suuttua   Päivi äidillään KESA_POISSA päivää: ei lappua, listaa, rahaa eikä autoa, jääkaappi tyhjä. Paluu, kun pelaaja
#             soittaa kukat ovella (has_flowers) tai viikon kuluttua; sitten valinta etuovella uudestaan
#   tunnustaa onnellinen loppu "avoin_pelikortti": pelaajan synnit oikeista teoista (KESA_SYNNIT) ja Päivin synnit
# Legendaarinen hetki "kesaheila" kummassakin onnellisessa lopussa. Ensikerrat kesaheila_matsi ja kesaheila_valinta.

const KESA_POISSA := 7  # "Suuttua": Päivi äidillään 7 pelipäivää (aamua)
## Pelaajan synnit oikeista teoista: [ensikerta tai "loppu:<id>" tai "jalki:<id>", tunnustus].
const KESA_SYNNIT := [
	["kolmio_saloinen", "kolmiomittasin Mintun oven Saloisissa"],
	["kolmio_vaala", "kolmiomittasin Katjan rivitalon Vaalassa"],
	["rasvanappi", "pelasin Rasvanappia makasiinissa"],
	["pentti_kyyti", "istuin Pentin BangBusissa"],
	["korkki", "keräsin korkkikansion"],
	["drakkar", "ostin Drakkar Noirin Railin kirppispöydältä"],
	["rakaleima_kopio", "leimasin perunalla rakaleiman kopion"],
	["loppu:mirkku", "nukuin Mirkun teltassa, en ollu kalassa"],
	["jalki:huume", "myin kylällä jotain, mitä ei ois pitäny"],
	["siitari", "istuin Siitarissa, vaikka sanoin olevani Pekan kanssa"],
]
## Päivin synnit (issue #326: jumppaillat olivat Zabukin tansseja Sinikan kanssa). Sävy hauska, ei julma.
const KESA_PAIVIN := ["\"jumppaillat\" oli Zabukin tansseja Sinikan kanssa", "tein Sytkäriin profiilin vanhasta lavakuvasta",
	"söin sun piilosuklaat eteisen kaapista", "Sinikka tietää kaiken, ja se kerto Hilkalle"]
var _kesa_valinta := false  # Päivin valintaikkuna auki (_talk_options näyttää vain valinnat)


## Päivin "jumppa"-parkkipaikka seuraintalon pihassa: pääoven edustalta 4 m poispäin talosta ja 6 m sivuun (ei oven eteen).
func _jumppa_parkki() -> Vector3:
	var talo: Vector3 = M.w(M.SEURAINTALO)
	var ovi: Vector3 = world.kirppis_door
	if ovi == Vector3.ZERO:
		return talo
	var ulos := Vector3(ovi.x - talo.x, 0, ovi.z - talo.z).normalized()
	var p := ovi + ulos * 4.0 + ulos.cross(Vector3.UP) * 6.0
	return Vector3(p.x, Terrain.h(p.x, p.z), p.z)


## Huipennus auki eikä kesäheilaa ole vielä mitattu (Jonin ja Esan valinta, Sytkärin ilmoitus).
func _kesaheila_auki() -> bool:
	if kolmio.stage("koti") != "":
		return false
	var p := rikos_osa("paivi")
	return p != null and p.huipennus_auki()


func _kesaheila_poissa() -> bool:
	var p := rikos_osa("paivi")
	return p != null and p.poissa()


func _kesaheila_poissa_pv() -> int:
	var p := rikos_osa("paivi")
	return maxi(0, int(p.poissa_asti) - day) if p != null else 0


## Päivin auton pakotettu vaihe (_wife_rhythm): "poissa" äidillä, "koti" kesäheilan mittauksen ja paluun ajan, muuten "".
func _kesaheila_wife() -> String:
	var mittaus := kolmio.stage("koti") == "mittaus"
	var p := rikos_osa("paivi")
	if p == null:
		return "koti" if mittaus else ""
	if p.poissa():
		return "poissa"
	return "koti" if mittaus or p.liput.get("kesaheila_paluu", false) else ""


## Sytkärin ilmoitus kerran, kun huipennus aukeaa (ulkona, ei muuta puhelinta auki).
func _kesaheila_notice() -> void:
	if _kolmio_ui != null or state != "ulkona" or not _kesaheila_auki():
		return
	var p := rikos_osa("paivi")
	if p.liput.get("kesaheila_viesti", false):
		return
	p.liput["kesaheila_viesti"] = true
	Sfx.play("bell", -8.0, 2.4)
	_queue_message("Sytkäri piippaa: uusi mätsi! \"Kesäheila -96, Saloinen.\" Joni ja Esa osaa mitata (kaupan parkkipaikalla).", 5.0)
	_save_game()


## Kodin etuovi luvussa 6: koputus kesäheilan mittauksessa, kukat ovella Päivin ollessa poissa tai Päivin paluu.
## Palauttaa true, kun ovi on varattu tähän (sisälle pääsee takaovesta).
func _kesaheila_ovi() -> bool:
	if _kolmio_ui != null or Settings.get_v("k18_pois"):
		return false
	var press: bool = Input.is_action_just_pressed("interact") and not player.is_stunned() \
		and Engine.get_process_frames() != _home_exit_frame and Engine.get_process_frames() != _talk_end_frame
	if kolmio.stage("koti") == "mittaus":
		_hint.text = "[E] Koputa omaan etuoveen (Kesäheila -96?)"
		if press:
			_kolmio_knock("koti", -1)
		return true
	var p := rikos_osa("paivi")
	if p == null:
		return false
	if p.poissa() and has_flowers:
		_hint.text = "[E] Soita Päiville äidille: kukat odottaa ovella"
		if press:
			has_flowers = false
			_flowers_day = day
			p.poissa_asti = day
			p.liput["kesaheila_paluu"] = true
			_save_game()
			_wife_rhythm(clock_min)
			_show_message("Hyundai kurvaa pihaan puolen tunnin päästä. Päivi katsoo kukkia ja sitten sinua.", 4.0)
			_kesaheila_valinta("Kukkia. No. Puhutaanko nyt?")
		return true
	if p.liput.get("kesaheila_paluu", false):
		_hint.text = "[E] Koputa: Päivi on tullut kotiin"
		if press:
			_kesaheila_valinta("Mää tulin takasin. Kesäheila -96 on vieläki sun Sytkärissä. No, mitä sää nyt sanot?")
		return true
	return false


## Paluuaamu viikon jälkeen (_new_day): Päivi palasi yöllä, valinta odottaa etuovella.
func _kesaheila_paluu_aamu() -> String:
	var p := rikos_osa("paivi")
	if p == null or int(p.poissa_asti) != day:
		return ""
	p.liput["kesaheila_paluu"] = true
	return "\nMää tulin takasin äidiltä. Jääkaappi on taas täynnä. Koputa etuoveen, kun oot valmis puhumaan."


func _kesaheila_valinta(hello: String) -> void:
	_kesa_valinta = true
	_kesaheila_hiljaa(true)  # Joni ja Esa eivät juttele Päivin valinnan päälle
	var puhe := rikos_osa("paivi_puhe")
	if puhe != null:
		puhe.nayta(hello)  # Päivi näkyy pelaajan vieressä (rikos/paivi_puhe.gd)
	else:
		_talk_open("paivi", null, hello)


func _kesaheila_options() -> Array:
	return [_opt("paivi_kesa_nauraa", "Nauraa yhdessä: \"Sää oot vieläki se kesäheila.\"", true, "", true),
		_opt("paivi_kesa_tunnustaa", "Tunnustaa kaikki: \"Pannaan kortit pöytään.\""),
		_opt("paivi_kesa_suuttua", "Suuttua: \"Sää jäljitit mua Sytkärillä?!\"")]


## Pelaajan synnit oikeista teoista (KESA_SYNNIT); aina ainakin Sytkärin pyyhkäisy.
func _kesaheila_synnit() -> Array:
	var p := rikos_osa("paivi")
	var out: Array = []
	for sy: Array in KESA_SYNNIT:
		var k: String = sy[0]
		var ok := false
		if k.begins_with("loppu:"):
			ok = endings.counts.has(k.substr(6))
		elif k.begins_with("jalki:"):
			ok = p != null and (p.kasitelty.has(k.substr(6)) or p.odottaa.any(func(o: Dictionary) -> bool: return o.id == k.substr(6)))
		else:
			ok = k in tilat.firsts
		if ok:
			out.append(sy[1])
	out.append("pyyhkäsin Sytkärissä oikealle Kesäheilaa -96")
	return out


## Jonin ja Esan puhekuplat pois kesäheilan valinnan ajaksi (villager.gd quiet, say("") tyhjentää kuplan).
func _kesaheila_hiljaa(on: bool) -> void:
	for v in [_kolmio_joni, _kolmio_esa]:
		if is_instance_valid(v):
			v.quiet = on
			if on:
				v.say("")


func _kesaheila_choose(id: String) -> void:
	_kesa_valinta = false
	_kesaheila_hiljaa(false)
	var p := rikos_osa("paivi")
	if id == "paivi_kesa_jatka":
		_talk_box.close()
		_kesaheila_aamu()
		return
	if kolmio.stage("koti") == "mittaus":
		kolmio.finish("koti", day)
	p.liput.erase("kesaheila_paluu")
	var e0: float = p.epaluulo
	match id:
		"paivi_kesa_nauraa":
			p.nollaa()
			tilat.first("kesaheila_valinta", 0.0)
			_save_game()
			_talk_box.reply("HAHAHAA! Sää kolmiomittasit oman vaimos! ...No. Tuu sisään, Joni ja Esa kans. Kerma ja mansikat ei odota.",
				[_opt("paivi_kesa_jatka", "Jatka: aamu keittiössä", true, "", true)], "Päivin epäluulo %d -> 0  ·  Kulissit kunnossa" % roundi(e0))
		"paivi_kesa_tunnustaa":
			p.nollaa()
			tilat.first("kesaheila_valinta", 0.0)
			tilat.add("moraali", Kolmio.END_MORAALI)
			tilat.add("stressi", Kolmio.END_STRESSI)
			var mun := _kesaheila_synnit()
			var line := "Sun lista: %s. Ja mun lista: %s. ...Mitä sää tuijotat? Ja Sinikka, sää tiesit kaikki!" % [
				", ".join(mun), ", ".join(KESA_PAIVIN)]
			var stats := _ending_line("avoin_pelikortti")
			_ending("kesaheila")
			_talk_box.reply(line, [_opt("lopeta", "Lopeta")], "%s  ·  Päivin epäluulo %d -> 0" % [stats, roundi(e0)])
		"paivi_kesa_suuttua":
			p.poissa_asti = day + 1 + KESA_POISSA
			_save_game()
			_wife_rhythm(clock_min)
			_talk_box.reply("Sää jäljitit mua Sytkärillä, ja sää SUUTUT? Mää lähen äidille. Viikoksi. Jääkaappi on tyhjä, ja sää tiedät miksi.",
				[_opt("lopeta", "Lopeta")], "Päivi on äidillään %d päivää. Kukat ovella saa hänet kotiin aiemmin." % KESA_POISSA)


## "Nauraa yhdessä": aamu omassa keittiössä (kolmio_kohtaus.gd aamu, koti), onnellinen loppu ja uusi päivä kotoa.
func _kesaheila_aamu() -> void:
	_act_begin()
	tilat.add("moraali", Kolmio.END_MORAALI)
	tilat.add("stressi", Kolmio.END_STRESSI)
	tilat.add("vireys", Kolmio.END_VIREYS)
	var stats := "Kolme ympyrää ✔  ·  Kerma ja mansikat ✔  ·  Epäluulo 0  ·  %s" % _ending_line("kulissit")
	_ending("kesaheila")
	var ui := KolmioKohtaus.new()
	ui.mode = "aamu"
	ui.site = "koti"
	ui.woman = "Päivi"
	ui.friends = Kolmio.SITES.koti.friends
	ui.stats = stats
	ui.finished.connect(func(_r: Dictionary) -> void:
		_kolmio_ui = null
		_new_day(home_zone + Vector3(0, 0, 4), false, "Aamu omassa keittiössä. Kesäheila -96 keitti kahvit, ja Esa paistoi letut.\n"))
	add_child(ui)
	_kolmio_ui = ui


# --- Aseman odotussali: juopot, narkkarit ja rahakätkö --------------------------------------------------------

const CACHE_MONEY := 100.0
const CACHE_R := 2.0
## Kätköjen tila asemittain: 0 = ei kuultu, 1 = paikka kerrottu (merkki kartalla), 2 = tyhjennetty. Säilyy.
var asema_katkot := {}
var _asema_town := "saloinen"
var _asema_prev := "ulkona"
var _asema_npc := 0


func _enter_asema(town: String) -> void:
	_asema_town = town
	_asema_prev = state
	if town == "vaala":
		mopo_trip.stop()
		_mopo_foot_inside()
		_mopo_label.visible = false
		_compass.visible = false
	else:
		player.controls_enabled = false
		player.speed = 0.0
		_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	state = "in_asema"
	Sfx.play("door", -3.0)
	tilat.first("asema", 0.2)
	if town == "vaala":
		tilat.first("asema_vaala", 0.0)  # luku 4: Vaalan asema (Saloisten asema ei kuittaa)
	asema_int.enter("Vaala" if town == "vaala" else "Saloinen")
	_show_message("%s asema. Lippuluukku on kiinni, mutta penkeillä on väkeä." % ("Vaalan" if town == "vaala" else "Saloisten"), 3.0)


## Odotussalista ulos: kadulle (tultu ovi) tai laiturille junaa odottamaan.
func _on_asema_exited(where: String) -> void:
	asema_int.leave()
	Sfx.play("door_close", -3.0)
	state = _asema_prev
	if _asema_town == "vaala":
		var vl: Node3D = mopo_trip.vaala
		_mopo_label.visible = true
		_compass.visible = true
		if where == "laituri":
			# Laiturille aina jalan: mopo jää aseman eteen parkkiin.
			mopo_trip.resume()
			walker_out.global_position = mopo_trip.to_global(vl.station_back + Vector3(0, 0.4, 0))
			walker_out.global_rotation.y = atan2(vl.station_back.x - vl.station_board.x, vl.station_back.z - vl.station_board.z) + mopo_trip.global_rotation.y
			walker_out.velocity = Vector3.ZERO
			walker_out.speed = 0.0
			walker_out.visible = true
			walker_out.process_mode = Node.PROCESS_MODE_INHERIT
			walker_out.controls_enabled = true
			walker_out.set_carrying(beers > 0)
			mopo_trip.set_on_foot(walker_out)
			_mopo_follow(walker_out)
			_mopo_dry = walker_out.global_position
			mopo_trip._resume_frame = Engine.get_process_frames()
			var bt := _train_board_text("vaala", "Saloisiin")
			_show_message("Laiturilla. %s." % (bt.substr(0, 1).to_upper() + bt.substr(1)), 3.0)
		else:
			_mopo_resume()
			mopo_trip._resume_frame = Engine.get_process_frames()
		return
	var to: Vector3 = world.station_plat_door if where == "laituri" else world.station_pos
	player.global_position = Vector3(to.x, Terrain.h(to.x, to.z) + 0.3, to.z)
	player.rotation.y = 0.0 if where == "laituri" else PI
	player.controls_enabled = true
	player.activate_camera()
	_hazards.process_mode = Node.PROCESS_MODE_INHERIT
	if where == "laituri":
		var bt := _train_board_text("saloinen", "Vaalaan")
		_show_message("Laiturilla. %s." % (bt.substr(0, 1).to_upper() + bt.substr(1)), 3.0)


## Lähtevien junien taulu odotussalissa.
func _asema_board() -> String:
	var to := "SALOINEN" if _asema_town == "vaala" else "VAALA"
	var tr: Array = _station_train(_asema_town)
	var when := "LAITURILLA" if tr[0] != null and tr[0].at_station() else ("SAAPUU" if tr[0] != null and tr[0].arriving()
		else "klo " + _train_due_text(_asema_town))
	return "LÄHTEVÄT JUNAT\n%s  %s\nRaide 1" % [to, when]


func _on_asema_acted(kind: String) -> void:
	match kind:
		"taulu":
			_show_message("Seuraava juna %s: %s." % ["Saloisiin" if _asema_town == "vaala" else "Vaalaan",
				_train_board_text(_asema_town, "Saloisiin" if _asema_town == "vaala" else "Vaalaan")], 3.0)
		"automaatti":
			if money < 1.0:
				_show_message("Automaatti haluaa euron. Ei ole.", 2.0)
				return
			money -= 1.0
			Sfx.play("coin", -6.0)
			_coffee()
			_show_message("Automaattikahvi: haaleaa ja pahaa, mutta herättää.", 2.5)
		_:
			if not kind.begins_with("hlo"):
				return
			_asema_npc = int(kind.substr(3))
			var items := _asema_drinks()
			if items.is_empty():
				asema_int.no_drink(_asema_npc)
				return
			asema_int.beg(_asema_npc)
			asema_int.walker.controls_enabled = false
			_interior_busy(true)
			_menu_mode = "asema"
			_item_menu.open(items, "Anna hörppy: %s" % StationInterior.PEOPLE[_asema_npc].name)


func _asema_drinks() -> Array:
	var items: Array = []
	if beers > 0:
		items.append(["kalja", "Kalja (%d)" % beers])
	if viina_pullot > 0:
		items.append(["viina", "Huikka Koskenkorvaa (%d pulloa)" % viina_pullot])
	if pontikka > 0:
		items.append(["pontikka", "Huikka pontikkaa (%d pulloa)" % pontikka])
	return items


## Juoma juopolle tai narkkarille: ensimmäisestä hörpystä kätkön paikka ja merkki kartalle, sitten pelkkä kiitos.
func _on_asema_give(id: String) -> void:
	_menu_mode = "give"
	_interior_busy(false)
	asema_int.walker.controls_enabled = true
	match id:
		"kalja":
			beers -= 1
			player.set_carrying(beers > 0)
			asema_int.walker.set_carrying(beers > 0)
		"viina":
			viina_pullot -= 1  # pullo menee kiertoon eikä palaa
		"pontikka":
			pontikka -= 1
	Sfx.play("glass", -6.0, 1.1)
	tilat.first("asema_horppy", 0.1)
	if asema_katkot.get(_asema_town, 0) == 0 and _cache_pos(_asema_town) != Vector3.INF:
		asema_katkot[_asema_town] = 1
		asema_int.thank(_asema_npc, _cache_where(_asema_town))
		Sfx.play("win_small", -6.0)
		_show_message("Rahakätkön paikka merkitty karttaan (%s). Ratapölkkypino radan varressa, %s." % [
			Settings.action_key("map"), _dist_text(_cache_station(_asema_town), _cache_pos(_asema_town))], 4.5)
		_save_game()
	else:
		asema_int.thank(_asema_npc, "")
		tilat.add("moraali", 0.05)
		_show_message("%s kiittää hörpystä.%s" % [StationInterior.PEOPLE[_asema_npc].name,
			" Kätkö on jo kerrottu." if asema_katkot.get(_asema_town, 0) == 1 else ""], 2.5)


## Kätkön paikka maailmassa (Vaalassa mopomatkan kehyksestä) ja asema, josta se on kerrottu.
func _cache_pos(town: String) -> Vector3:
	if town == "vaala":
		if mopo_trip == null or mopo_trip.vaala == null or mopo_trip.vaala.cache_pos == Vector3.INF:
			return Vector3.INF
		return mopo_trip.to_global(mopo_trip.vaala.cache_pos)
	return world.cache_pos


func _cache_station(town: String) -> Vector3:
	if town == "vaala":
		return mopo_trip.to_global(mopo_trip.vaala.station_back)
	return world.station_plat_door


## Juopon kuvaus kätkön paikasta: ilmansuunta ja matka asemalta.
func _cache_where(town: String) -> String:
	var a := _cache_station(town)
	var b := _cache_pos(town)
	var d := Vector2(b.x - a.x, b.z - a.z)
	if town == "vaala":  # Vaalan kehys on pohjoinen ylös (mopomatka voi olla käännetty)
		var vl: Node3D = mopo_trip.vaala
		d = Vector2(vl.cache_pos.x - vl.station_back.x, vl.cache_pos.z - vl.station_back.z)
	var names := ["itään", "kaakkoon", "etelään", "lounaaseen", "länteen", "luoteeseen", "pohjoiseen", "koilliseen"]
	var way: String = names[posmod(roundi(d.angle() / (TAU / 8.0)), 8)]
	return "radan vartta %d metriä %s, vanhojen ratapölkkyjen alla on muovikassi" % [roundi(d.length() / 10.0) * 10, way]


## Saloisten kätkö: jalan pinon vieressä E (paikka pitää olla kuultu odotussalissa).
func _cache_logic(p: Vector3) -> bool:
	if asema_katkot.get("saloinen", 0) != 1 or world.cache_pos == Vector3.INF:
		return false
	if Vector2(p.x - world.cache_pos.x, p.z - world.cache_pos.z).length() > CACHE_R:
		return false
	if player == bike:
		_hint.text = "[F] Pyörältä pois, niin pääset kaivamaan kätköä"
		return true
	_hint.text = "[E] Kaiva narkkarin rahakätkö ratapölkkyjen alta"
	if Input.is_action_just_pressed("interact") and not player.is_stunned():
		_take_cache("saloinen")
	return true


func _take_cache(town: String) -> void:
	if asema_katkot.get(town, 0) != 1:
		return
	asema_katkot[town] = 2
	money += CACHE_MONEY
	reseptit += 1
	Sfx.play("win", -4.0)
	tilat.add("moraali", 0.2)
	tilat.first("asema_katko", 0.3)
	_show_message("Muovikassissa rypistynyt satanen! +%s €. Juoppo puhui totta.\nSatasen välissä on lääkärin resepti: kipulääkkeitä apteekista!" % _eur(CACHE_MONEY), 5.0)
	_save_game()


## Kartan kätkömerkit: [asema, paikka (Saloisissa maailman x/z, Vaalassa Vaalan kehyksen x/z)] kerrotuille kätköille.
func cache_markers() -> Array:
	var out := []
	if asema_katkot.get("saloinen", 0) == 1 and world.cache_pos != Vector3.INF:
		out.append(["saloinen", Vector2(world.cache_pos.x, world.cache_pos.z)])
	if asema_katkot.get("vaala", 0) == 1 and mopo_trip != null and mopo_trip.vaala != null and mopo_trip.vaala.cache_pos != Vector3.INF:
		out.append(["vaala", Vector2(mopo_trip.vaala.cache_pos.x, mopo_trip.vaala.cache_pos.z)])
	return out


## Junamatka (10 € suuntaansa): Saloisista Vaalan asemalle tai Vaalasta Saloisten asemalle. Välikuvassa istutaan
## ravintolavaunussa ja jutellaan mukavia naismatkustajien kanssa (cutscene.train_ride). Vaalaan tultaessa mopo
## odottaa aseman pihassa ja matka Paapeliin jatkuu siitä; Vaalasta lähdettäessä mopo jää Vaalaan (seuraavalla
## kerralla se on taas mökin pihassa kuten muillakin paluureiteillä).
func _train_trip(to: String) -> void:
	money -= TRAIN_FARE
	Sfx.play("coin", -6.0)
	if to == "saloinen":
		_santtu_home()
		if mopo_trip.on_foot != null:
			walker_out.controls_enabled = false
			mopo_trip.on_foot = null
		mopo_trip.stop()
		_mopo_restore_hud()
		state = _vaala_state
		var review := _hommat_leave_review(false)
		if review != "":  # tekstiviesti näytetään perillä Saloisten asemalla (junamatkalla HUD on piilossa)
			_train_review_msg = "Santtu tekstasi: " + review.trim_prefix("Santun arvostelu: ").strip_edges().replace("\n", " ")
		_hommat_leave_mokki()  # junalla kotiin = mökiltä lähtö: Santun hommat pois, maksettu paluutaksi raukeaa
		tilat.first("asema_vaala", 0.0)  # luku 4: laiturilta suoraan junaan ilman odotussalia käy myös
		_taxi_mokki_return = false
	else:
		_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	_train_prev = state
	state = "cutscene"
	player.controls_enabled = false
	player.speed = 0.0
	_hud.visible = false
	tilat.first("juna", 0.3)
	if to == "saloinen":
		tilat.first("juna_saloinen", 0.0)  # luku 4: juna Vaalasta kotiin (ei menomatka Vaalaan)
	# Ravintolavaunu: tuoppi olutta aina (humalaa), paukut naisille jos rahaa jää.
	var treat := money >= TRAIN_ROUND
	_train_round_msg = ("Ravintolavaunun tuoppi ja naisten Koskenkorvat %s €. " % _eur(TRAIN_ROUND)) if treat else ""
	if treat:
		money -= TRAIN_ROUND
		mielihyva = clampf(mielihyva + 5.0, 0.0, 100.0)
	tilat.add("humala", 0.12)
	helena_vaalassa = to == "vaala" and treat and Looks.outfit == "farkut"  # vain verkkopaita + kossut Saloisista Vaalaan
	_save_game()
	cutscene.train_ride(to == "vaala", _arrive_vaala_by_train if to == "vaala" else _arrive_saloinen_by_train, treat)


var _train_prev := "ulkona"
var helena_vaalassa := false  # Vaalaan ajettu junan erikoiskohtauksella (kossut naisille): Helena bikineissä Uiton saunalla Santun sijaan
var _train_round_msg := ""
var _train_review_msg := ""  # Santun arvostelu tekstiviestinä junalla kotiin tultaessa


func _arrive_saloinen_by_train() -> void:
	state = _train_prev if _train_prev != "cutscene" else "ulkona"
	walker_out.visible = true
	_set_avatar(walker_out)
	var a: Vector3 = world.station_arrive
	_arrive_by_car(Vector3(a.x, Terrain.h(a.x, a.z) + 0.3, a.z))
	walker_out.rotation.y = PI  # laiturilla kasvot asemaan päin
	if world.train != null:
		world.train.arrive_stopped(world.station_t)  # juna, jolla tultiin, lähtee laiturilta
	_show_message(_train_round_msg + "Saloisten asema. Odotussalin läpi kadulle, K-Market on aseman toisella puolella.", 3.5)
	if _train_review_msg != "":
		_queue_message(_train_review_msg, 5.0)
		_train_review_msg = ""


func _arrive_vaala_by_train() -> void:
	_advance_clock(HOP_VAALA)
	state = _train_prev if _train_prev != "cutscene" else "ulkona"
	mokki.ensure_built()
	_ensure_mopo_trip()
	_start_mopo(false)
	mopo_trip.target = "paapeli"
	var vl: Node3D = mopo_trip.vaala
	var ast: Dictionary = vl.data.keskusta.asema
	var out := Vector3(ast.out[0], 0, ast.out[1])
	var side := out.cross(Vector3.UP)
	var mp: CharacterBody3D = mopo_trip.mopo
	mp.position = vl.station_door + out * 2.5 + side * 2.5 + Vector3(0, 0.6, 0)
	mp.rotation.y = atan2(-out.x, -out.z)
	mp.speed = 0.0
	var best := INF
	for i in vl.road.size():
		var d2 := Vector2(vl.road[i][0] - mp.position.x, vl.road[i][2] - mp.position.z).length_squared()
		if d2 < best:
			best = d2
			mopo_trip._sample = i
	# Junasta laiturille jalan, kasvot asemaan päin; mopo parkissa aseman edessä.
	walker_out.global_position = mopo_trip.to_global(vl.station_board + Vector3(0, 0.2, 0))
	walker_out.global_rotation.y = atan2(-out.x, -out.z) + mopo_trip.global_rotation.y
	walker_out.velocity = Vector3.ZERO
	walker_out.speed = 0.0
	walker_out.visible = true
	walker_out.process_mode = Node.PROCESS_MODE_INHERIT
	walker_out.controls_enabled = true
	walker_out.set_carrying(beers > 0)
	mopo_trip.set_on_foot(walker_out)
	_mopo_follow(walker_out)
	_mopo_dry = walker_out.global_position
	_hud.visible = true
	if vl.train != null:
		vl.train.arrive_stopped(vl.station_t)  # juna, jolla tultiin, lähtee laiturilta
	_show_message(_train_round_msg + "Vaalan asema. Mopo odottaa aseman edessä: odotussalin läpi tai aseman ympäri. Siitari ja tori ovat liikenneympyrän takana.", 4.0)


## Huijauskoodi: kirjoita "paapeli" ulkona, niin hahmo siirtyy suoraan mökin pihatien päähän ilman
## kyytiä ja maksua. Paluu Pekan kyydillä pihatien päästä kuten aina.
const CHEAT_MOKKI := "paapeli"
## Huijauskoodi: "vaala" ulkona (Saloisissa, mökillä tai Vaalan matkalla) vie Vaalaan Gasthausin pihaan kuin yön
## jälkeen: päivä vaihtuu kuten Gasthausissa nukkuessa (ilmaiseksi) ja mopo odottaa pihassa.
const CHEAT_VAALA := "vaala"
## Huijauskoodi: "rahaa" missä tahansa antaa 20 €.
const CHEAT_RAHAA := "rahaa"
const CHEAT_RAHAA_EUR := 20.0
var _cheat_buf := ""


func _input(event: InputEvent) -> void:
	if not (event is InputEventKey and event.pressed and not event.echo and event.unicode > 0):
		return
	_cheat_buf = (_cheat_buf + char(event.unicode).to_lower()).right(maxi(CHEAT_MOKKI.length(), maxi(CHEAT_VAALA.length(), CHEAT_RAHAA.length())))
	if _cheat_buf.ends_with(CHEAT_MOKKI):
		_cheat_buf = ""
		_cheat_mokki.call_deferred()
	elif _cheat_buf.ends_with(CHEAT_VAALA):
		_cheat_buf = ""
		_cheat_vaala.call_deferred()
	elif _cheat_buf.ends_with(CHEAT_RAHAA):
		_cheat_buf = ""
		_cheat_rahaa.call_deferred()


func _cheat_rahaa() -> void:
	await get_tree().process_frame
	if _inventory.visible:
		_inventory.toggle()  # koodin I ei kirjoita, mutta varmuuden vuoksi kuten muissa koodeissa
	money += CHEAT_RAHAA_EUR
	Sfx.play("coin", -4.0)
	_show_message("Taskusta löytyi kaksikymppinen! +%s €. Rahaa %s €." % [_eur(CHEAT_RAHAA_EUR), _eur(money)], 2.5)


func _cheat_mokki() -> void:
	await get_tree().process_frame
	if _inventory.visible:
		_inventory.toggle()  # koodin I avasi repun
	if state != "ulkona" or _in_vaala or cutscene.busy or _talk_box.is_open() or _at_mokki():
		return
	if player == bike:
		_place_on_foot(bike.global_position + bike.global_transform.basis.x * 1.1)  # pyörä jää Saloisiin
	tilat.first("mokki", 0.4)
	_save_game()
	_arrive_by_car(mokki.gpos(Mokki.RIDE_LOCAL + Vector3(0, 0.3, 2.2)))
	_show_message("PAAPELI! Olet mökillä.", 2.5)


func _cheat_vaala() -> void:
	await get_tree().process_frame
	if _inventory.visible:
		_inventory.toggle()
	if cutscene.busy or _talk_box.is_open():
		return
	if state != "ulkona":
		return  # sisätiloissa (myös Vaalan Siitari, kaupat ja lava)
	if not _in_vaala and player == bike:
		_place_on_foot(bike.global_position + bike.global_transform.basis.x * 1.1)  # pyörä jää Saloisiin
	_gasthaus_morning("Heräsit Vaalan Gasthausista. Miten tänne tultiin? Lakanat oli puhtaat ja aamukahvi kuului hintaan.\n",
		"VAALA! Huomenta Gasthausista, mopo odottaa pihassa. Paapeliin on n. 11 km.")


var _raahe_fare := 0.0  # Raahen reissun taksimaksu (meno-paluu); -1 = rekkakyyti


var _raahe_hop := HOP_RAAHE


func _taxi_trip(escape := false) -> void:
	var offer := Retket.raahe_tarjous(false)
	var fare: float = offer.hinta
	_raahe_hop = offer.hop_min
	state = "cutscene"
	player.controls_enabled = false
	player.speed = 0.0
	_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	_hud.visible = false
	var before := money
	money = maxf(0.0, money - fare) if escape else money - fare  # paossa kuski ottaa mitä on
	_raahe_fare = before - money
	Sfx.play("door_close", -3.0)
	cutscene.taxi_to_raahe(_enter_raahe)


# --- Retket (retket.gd): valikkomatka kohteeseen ja takaisin lähtöpaikkaan ------------------------------------
## Taksilla maksetaan meno-paluu lähtiessä, kello siirtyy matkan keston (hop_min) verran sekä menossa että tullessa
## ja paluu on samaan paikkaan, josta lähdettiin (päivä ei vaihdu). Kohde on taskukohtaus (retki_*.gd).
const KALALUPA_PRICE := 8.0
var kalalupa := false  # Teeriniemen leirintäalueen kalalupa ostettu (tallentuu)
var _retki_id := ""
var _retki_from := Vector3.ZERO  # lähtöpaikka (maailmankoordinaatit), jonne palataan
var _retki_fare := 0.0
var _retki_hop := 0.0   # matkan kesto lähtöpaikasta (suuntaansa)
var _retki_vaala := false  # lähtö Vaalan taksitolpalta (mopomatkan maailma): paluu samaan paikkaan jalan


func _taxi_retki(id: String) -> void:
	var r: Dictionary = Retket.LISTA[id]
	var offer := Retket.tarjous(id, _in_vaala)
	if money < offer.hinta:
		_show_message("Kuski: \"%s € tai ei mitään.\"" % _eur(offer.hinta), 3.0)
		return
	money -= offer.hinta
	_retki_id = id
	_retki_fare = offer.hinta
	_retki_hop = offer.hop_min
	_retki_vaala = _in_vaala
	if _in_vaala:
		_act_begin("cutscene")  # mopo parkkiin, jalan; paluu samaan paikkaan (_retki_return)
		_retki_from = walker_out.global_position
	else:
		_retki_from = player.global_position
		state = "cutscene"
		player.controls_enabled = false
		player.speed = 0.0
		_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
		_hud.visible = false
	Sfx.play("door_close", -3.0)
	cutscene.taxi_ride(r.otsikko, r.sub, r.lines, _enter_retki.bind(id))


func _enter_retki(id: String) -> void:
	var r: Dictionary = Retket.LISTA[id]
	_retki_id = id
	if _retki_hop <= 0.0:
		_retki_hop = r.hop_min
	_advance_clock(_retki_hop)
	state = "in_retki"
	_hud.visible = true
	_retki_close()
	retki_int = r.tasku.new()
	retki_int.position = RETKI_INT_POS
	add_child(retki_int)
	retki_int.exited.connect(_on_retki_exited)
	retki_int.acted.connect(_on_retki_acted)
	tilat.first("retki_" + id, 0.4)
	if "legenda" in retki_int:
		retki_int.legenda = {"rojuniemi": peruskivi, "manamansalo": manamansalo, "wanharaahe": wanharaahe, "paltaniemi": kuvakirkko, "tietokonemuseo": tietokonemuseo, "vanhaherra": vanhaherra, "kuhmo": karhut, "hiidenportti": hiidenportti, "pyhakoski": pyhakoski, "kajaani": messenius, "kalajoki": kalajoki, "raate": raate}.get(id, pakkahuone)
	if id == "kalajoki":
		retki_int.set_juhannus(_juhannus())
	retki_int.enter()
	_show_message(r.perilla, 3.5)


## Kohtaus pois muistista (poistuessa ja sammuessa).
func _retki_close() -> void:
	if retki_int == null:
		return
	retki_int.leave()
	retki_int.queue_free()
	retki_int = null


func _on_retki_exited() -> void:
	if state != "in_retki":
		return
	_retki_close()
	Sfx.play("door_close", -3.0)
	state = "cutscene"
	_hud.visible = false
	cutscene.taxi_ride("TAKAISIN", "Taksi vie takaisin lähtöpaikkaan. Paluu oli jo maksettu.", Cutscene.TAXI_HOME_LINES, _retki_return)


## Paluu lähtöpaikkaan (ruutu vielä pimeänä): kello siirtyy takaisintulon verran, ohjaus takaisin.
func _retki_return() -> void:
	_advance_clock(_retki_hop)
	_retki_hop = 0.0
	if _retki_vaala:
		_retki_vaala = false
		walker_out.global_position = _retki_from
		walker_out.velocity = Vector3.ZERO
		_act_end()  # takaisin Vaalan tolpalle jalan (mopo parkissa)
		_retki_id = ""
		_save_game()
		return
	state = "ulkona"
	player.global_position = _retki_from
	player.activate_camera()
	player.controls_enabled = true
	_hud.visible = true
	_hazards.process_mode = Node.PROCESS_MODE_INHERIT
	_retki_id = ""
	_save_game()


func _on_retki_acted(kind: String) -> void:
	if _retki_id == "paltaniemi":
		_kuvakirkko_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "kuhmo":
		_karhut_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "raate":
		_raate_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "kalajoki":
		_kalajoki_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "kajaani":
		_messenius_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "pyhakoski":
		_pyhakoski_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "hiidenportti":
		_hiidenportti_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "vanhaherra":
		_vanhaherra_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "tietokonemuseo":
		_tietokonemuseo_acted(kind)
		retki_int.block_interact()
		return
	if _retki_id == "wanharaahe":
		_wanharaahe_acted(kind)
		retki_int.block_interact()
		return
	match kind:
		"kyltti", "kivi":
			if _retki_id == "rojuniemi":
				_peruskivi_acted(kind)
			elif kind == "kyltti":
				_hanhikivi_kyltti()
			else:
				_hanhikivi_kivi()
			retki_int.block_interact()
		"kuraattori", "kirja", "veistos", "luukku":
			_pakkahuone_acted(kind)
			retki_int.block_interact()
		"vartija", "laatta":
			_peruskivi_acted(kind)
			retki_int.block_interact()
		"opas", "infotaulu", "jaanteet":
			_manamansalo_acted(kind)
			retki_int.block_interact()
		"tiski":
			_talk_open("leirintaalue", null, "Päivää! Kalalupaa vai vain katselemassa?")
		"lampi":
			if not kalalupa:
				retki_int.say("Kalalupa pitää ostaa tiskiltä ennen kuin heität.")
				_show_message("Ei lupaa: ostetaan tiskiltä (%s €)." % _eur(KALALUPA_PRICE), 3.0)
				retki_int.block_interact()
			else:
				_start_lampi_fishing()


func _talk_leirintaalue(id: String) -> void:
	match id:
		"lupa":
			money -= KALALUPA_PRICE
			kalalupa = true
			Sfx.play("coin", -4.0)
			tilat.first("kalalupa", 0.3)
			_talk_box.reply("Tässä lupa. Vuokraonki ja kahdeksan matoa kuuluu hintaan. Lammelle vaan, ja saalis omaksi.",
				_talk_options(), "Kalalupa ostettu. Rahaa %s €." % _eur(money))
		"lampi_kysy":
			_talk_box.reply(["Lampeen istutetaan kirjolohta ja taimenta joka kevät. Ne syö kuin nälkäinen.",
				"Kirjolohi on vaaleanpunaraitainen, taimen ruskea ja punapilkkuinen. Taimen vetää kovempaa.",
				"Muuta ei saa onkia kuin tuolta penkalta. Ruovikossa ei ole mitään."].pick_random(), _talk_options(), "Rahaa %s €." % _eur(money))


## Lammen onkiminen: shore_fish_game.gd tilassa `stocked` (istutettu kala, nopeat tärpit), vedenpinta taskukohtauksesta.
func _start_lampi_fishing() -> void:
	var rt := retki_int
	rt.busy = true
	rt.walker.controls_enabled = false
	rt.walker.visible = false
	state = "minigame"
	_hud.visible = false
	_hint.text = ""
	var g := ShoreFishGame.new()
	g.gear = "onki"
	g.stocked = true
	g.place = "Teeriniemen lammen"
	g.spot = rt.fish_spot()
	g.dir = rt.fish_dir()
	g.surface_y = rt.water_y()
	g.water = func(p: Vector3) -> bool: return is_instance_valid(rt) and rt.is_water(p)
	g.worms = 8  # kuuluu lupaan, ei kulu omista madoista
	g.drunk = _hand_shake()
	g.finished.connect(func(got: Array) -> void:
		if state == "minigame" and retki_int == rt:
			state = "in_retki"
			_hud.visible = true
			rt.walker.visible = true
			rt.walker.activate()
			rt.busy = false
			rt.block_interact()
		if not got.is_empty():
			tilat.first("lampi_saalis", 0.2)  # päiväkirjan Teeriniemen kalalampi valmis
		_after_fishing(got))
	add_child(g)


## Raahessa: Kapteenin Kulma ja Kellari (raahe_interior.gd). Ulko-ovelta taksi kotiin ja uusi päivä.
func _enter_raahe() -> void:
	_advance_clock(_raahe_hop)
	_raahe_hop = HOP_RAAHE
	state = "in_raahe"
	_hud.visible = true
	# Päivi tulee etsimään joka toinen kerta, kun pelaaja on viihtynyt hetken (aika s, < 0 = ei tule).
	_raahe = {"won": -1, "paid": 0.0, "quiz": -1, "karaoke": -1.0, "caught": false,
		"paivi_t": randf_range(40.0, 90.0) if randf() < 0.5 else -1.0}
	tilat.first("raahe", 0.5)
	_own_drink_warned = false
	_ensure_raahe()
	raahe_int.kapteeni_vihje = hanhikivi.heard and not hanhikivi.kapteeni
	raahe_int.enter()
	_show_message("Kapteenin Kulma, Kirkkokatu 32, Raahe. Kellarissa karaoke, iltaisin visa ja Tero odottaa kädenvääntöä.", 4.0)


func _on_raahe_exited() -> void:
	if state != "in_raahe":
		return  # jo lähdössä (Päivi löysi ja ovi samaan aikaan)
	raahe_int.leave()
	Sfx.play("door_close", -3.0)
	state = "cutscene"
	_hud.visible = false
	var won: int = _raahe.won
	mielihyva = clampf(mielihyva + (35.0 if won == 1 else 20.0) - (15.0 if _raahe.caught else 0.0), 0.0, 100.0)
	_no_allowance = true
	var parts := PackedStringArray()
	if won == 1:
		parts.append("Voitit kädenväännön, Tero tarjosi.")
	elif won == 0:
		parts.append("Hävisit kädenväännön ja tarjosit kierroksen (%s €)." % _eur(_raahe.paid))
	if _raahe.quiz >= 0:
		parts.append("Visassa %d/3 oikein." % _raahe.quiz)
	if _raahe.karaoke >= 0.0:
		parts.append("Karaoke Kellarissa %d %%." % roundi(_raahe.karaoke * 100.0))
	if _raahe.get("kicked", false):
		parts.append("Baarimikko heitti sinut ulos omien juomien takia.")
	if _raahe.caught:
		parts.append("Päivi löysi sinut baarista ja raahasi kotiin.")
	elif _raahe.get("paivi_came", false):
		parts.append("Päivi tuli etsimään, mutta livahdit taksiin.")
	if parts.is_empty():
		parts.append("Ilta Kapteenin Kulmassa.")
	var fare := "Rekkakyyti ilmaiseksi." if _raahe_fare < 0.0 else "Taksi %s €." % _eur(_raahe_fare)
	var stats := "%s %s\nMielihyvä %d · Maine %d" % [" ".join(parts), fare, roundi(mielihyva), roundi(maine)]
	_day_end = "raahe"
	cutscene.taxi_home(home_zone, stats, func() -> void:
		_new_day(home_zone + Vector3(0, 0, 4), false, "Pää on kipeä Raahen reissusta.\n"))


## Päivi löysi: ilta loppuu, stressi ja moraali kärsivät, kotimatkalla kuunnellaan saarnaa.
func _on_raahe_paivi_caught() -> void:
	_raahe.caught = true
	tilat.add("stressi", -0.3)
	tilat.add("moraali", -0.2)
	maine = clampf(maine - 10.0, 0.0, 100.0)
	Sfx.play("lose", -4.0)
	raahe_int.walker.controls_enabled = false
	_show_message("Päivi löysi sinut! \"Täällähän sää oot! Kotiin, heti!\" Ruukin porukka nauraa.", 3.0)
	get_tree().create_timer(2.5).timeout.connect(func() -> void:
		if state == "in_raahe":
			_on_raahe_exited())


func _on_raahe_acted(kind: String) -> void:
	match kind:
		"kapteeni":
			_hanhikivi_kapteeni()
		"tiski":
			_talk_open("raahe", null, "Mitäs laitetaan?")
		"tero":
			_raahe_wrestle()
		"visa":
			if _raahe.quiz >= 0:
				_quiz.clear()
				_talk_open("visa", null, "Tämän illan visa on jo räknätty. Tuu huomenna uudestaan!")
				return
			_quiz.clear()
			var pool := RAAHE_QUIZ.duplicate()
			pool.shuffle()
			for q in pool.slice(0, 3):
				var opts: Array = (q[1] as Array).duplicate()
				opts.shuffle()
				_quiz.append([q[0], opts, q[1][0]])
			_quiz_i = 0
			_quiz_right = 0
			_talk_open("visa", null, "Illan visa! Kolme kysymystä Raahesta. Kaikki oikein, niin visajuoma on talon.\n\n"
				+ _quiz_question())
		"karaoke":
			if money < RAAHE_KARAOKE_PRICE:
				_show_message("Karaoke maksaa %s €. Rahat ei riitä." % _eur(RAAHE_KARAOKE_PRICE), 2.5)
				return
			money -= RAAHE_KARAOKE_PRICE
			_raahe_karaoke()


## Kädenvääntö Teron kanssa (bar_game.gd) ruukin porukan pöydässä; häviäjä tarjoaa kierroksen.
func _raahe_wrestle() -> void:
	raahe_int.busy = true
	raahe_int.walker.controls_enabled = false
	_hud.visible = false
	var bar := BarGame.new()
	bar.position = BAR_POS
	add_child(bar)
	bar.finished.connect(func(won: bool) -> void:
		bar.queue_free()
		_hud.visible = true
		raahe_int.busy = false
		raahe_int.walker.controls_enabled = true
		raahe_int.walker.activate()
		raahe_int.block_interact()
		if won:
			tilat.first("tero_voitto", 0.3)
		if _raahe.won < 0:
			tilat.add("moraali", 0.2 if won else -0.1)
			maine = clampf(maine + (15.0 if won else -5.0), 0.0, 100.0)
		_raahe.won = 1 if won else 0
		if won:
			raahe_int.tero_say("Perkele, sää oot vahva! Skooli, mää tarjoan.")
			tilat.add("humala", 0.14)
			_show_message("Voitit Teron! Ruukin porukka hakkaa pöytää. Tero tarjoaa tuopin.", 3.5)
		else:
			var paid := minf(BAR_ROUND, money)
			money -= paid
			_raahe.paid += paid
			tilat.add("humala", 0.14)
			raahe_int.tero_say("Heh. Masuunilla nostellaan isompia. Sää tarjoot.")
			_show_message("Hävisit. Tarjosit ruukin porukalle kierroksen (%s €)." % _eur(paid), 3.5))


func _quiz_question() -> String:
	return "Kysymys %d/3: %s" % [_quiz_i + 1, _quiz[_quiz_i][0]]


## Visan vastaus keskusteluikkunassa: oikein/väärin, seuraava kysymys tai tulos.
func _quiz_answer(k: int) -> void:
	var q: Array = _quiz[_quiz_i]
	var pick: String = q[1][k]
	var res := ""
	if pick == q[2]:
		_quiz_right += 1
		Sfx.play("win_small", -8.0)
		res = "Oikein! %s" % q[2]
	else:
		Sfx.play("lose", -10.0)
		res = "Väärin! Oikea vastaus: %s" % q[2]
	if not res.right(1) in [".", "!", "?"]:
		res += "."
	_quiz_i += 1
	if _quiz_i < _quiz.size():
		_talk_box.reply(res + "\n\n" + _quiz_question(), _talk_options())
		return
	_raahe.quiz = _quiz_right
	_quiz.clear()
	tilat.first("pubivisa", 0.3)
	tilat.add("keskittyminen", 0.05 * _quiz_right)
	if _quiz_right == 3:
		tilat.first("pubivisa_kaikki", 0.2)
		tilat.add("moraali", 0.2)
		tilat.add("humala", 0.14)
		_talk_box.reply(res + " Kaikki oikein! Visajuoma talon piikkiin.", _talk_options(),
			"Visa 3/3! Ruukin porukka: \"Saloisista ja tietää Raahen!\"")
	else:
		_talk_box.reply(res + " Huomenna uudestaan!", _talk_options(), "Visa %d/3." % _quiz_right)


## Karaoke Kapteenin Kellarissa: "Ruukin valot".
func _raahe_karaoke() -> void:
	raahe_int.to_stage()
	_hud.visible = false
	var game := KaraokeGame.new()
	game.song = KaraokeGame.SONG_RAAHE
	game.menu_titles = KaraokeGame.menu_for("Ruukin valot")
	game.drunk = _hand_shake()
	game.line.connect(raahe_int.set_screen)
	game.finished.connect(func(score: float) -> void:
		game.queue_free()
		_hud.visible = true
		if game.cancelled:
			raahe_int.from_stage(false, true)
			money += RAAHE_KARAOKE_PRICE
			_show_message("Et valinnutkaan kappaletta. Rahat takaisin.", 2.5)
			return
		raahe_int.from_stage(score >= 0.5)
		_raahe.karaoke = maxf(_raahe.karaoke, score)
		tilat.first("karaoke_raahe", 0.3)
		var pct := roundi(score * 100.0)
		if score >= KARAOKE_RAIKUU:
			_ending("karaoke")
			Sfx.play("win", -4.0)
			tilat.add("moraali", 0.25)
			mielihyva = clampf(mielihyva + 10.0, 0.0, 100.0)
			_show_message("Karaoke %d %%: Kellari raikuu! \"Skooli laulajalle!\"" % pct, 3.5)
		elif score >= KARAOKE_KELPO:
			Sfx.play("win_small", -6.0)
			tilat.add("moraali", 0.1)
			_show_message("Karaoke %d %%: kelpo veto. Joku ruukkilainen taputti." % pct, 3.0)
		else:
			Sfx.play("lose", -6.0)
			tilat.add("moraali", -0.1)
			_show_message("Karaoke %d %%: nuotin vierestä. Kellarissa ei räknätä, mutta kuultiin kyllä." % pct, 3.5))
	add_child(game)


## Juoma Kapteenin Kulman tiskiltä: palauttaa [baarimikon repliikki, inforivi].
func _on_raahe(id: String) -> Array:
	var m: Array = RAAHE_MENU[id]
	if money < m[1]:
		return ["Rahat ei riitä.", "Rahaa %s €." % _eur(money)]
	money -= m[1]
	if id == "kahvi":
		_coffee()
	tilat.add("humala", m[2])
	tilat.add("stressi", m[3])
	tilat.add("moraali", m[4])
	Sfx.play("glass" if m[2] > 0.0 else "pickup", -6.0, 0.9)
	tilat.first("raahe_" + id, 0.1)
	return [RAAHE_LINES.pick_random(), "%s, −%s €." % [m[0], _eur(m[1])]]


## Naapurit (Arto, Pekka, Sinikka): lähellä puhevihje, E avaa keskusteluikkunan.
func _neighbor_logic() -> void:
	if _hint.text != "":
		return
	for v in [sinikka, pekka, arto]:
		if v.distance_to_player() > 4.2:
			continue
		_talk_hint(_villager_id(v), v, player != bike)
		return


func _villager_id(v: Node) -> String:
	return "arto" if v == arto else ("pekka" if v == pekka else "sinikka")


# --- Keskustelut (dialogue_box.gd, talk_prompt.gd) ---------------------------------------------------------
# Kaikki hahmot samalla mallilla: _talk_hint näyttää puhevihjeen ja avaa E:llä, _talk_options antaa hahmon kaikki
# asiat (mahdottomat harmaana syyn kanssa), _talk_choose toteuttaa valinnan ja hahmo vastaa samaan ikkunaan.

## Puhevihje hahmolle (talk_prompt.gd) ja E avaa keskustelun. Vihjeriville jää välilyönti, joka estää muut vihjeet
## (vanha vihjerivi ei näy, puhevihje on sen paikalla). on_foot = false: kehotus nousta pyörän selästä.
func _talk_hint(who: String, node: Node3D, on_foot := true) -> void:
	_hint.text = " "
	var nm: String = TALKERS[who][0]
	if not on_foot:
		_talk_prompt.show_for(node, Settings.action_key("mount"), "Nouse pyörältä", nm, TALKERS[who][1], "jutellaksesi")
		return
	var can: Array = _talk_options(who).filter(func(o: Dictionary) -> bool:
		return o.enabled and not o.id in ["juttu", "lopeta"])
	var sub := " · ".join(can.slice(0, 2).map(func(o: Dictionary) -> String: return String(o.text).get_slice(" (", 0)))
	if can.size() > 2:
		sub += " …"
	var hot := can.any(func(o: Dictionary) -> bool: return o.get("hot", false))
	_talk_prompt.show_for(node, Settings.action_key("interact"), "Puhu", nm, TALKERS[who][1], sub, hot)
	if Input.is_action_just_pressed("interact") and Engine.get_process_frames() != _talk_end_frame \
			and not (_active_walker().has_method("is_stunned") and _active_walker().is_stunned()):
		_talk_open(who, node)


## Baarien puhuttavat pisteet (tiski, visa, Sinikka): puhevihje vihjerivin tilalle. E:n käsittelee sisätila itse
## (acted-signaali), joka avaa keskustelun.
func _bar_prompt(bar: Node, talkers: Dictionary) -> void:
	if bar.busy or _talk_box.is_open() or not talkers.has(bar.spot):
		return
	var who: String = talkers[bar.spot]
	var sub: String = {"raahe": "Juomat ja kahvit", "siitari": "Juomat ja kahvit", "visa": "Illan pubivisa",
		"vastaanotto": "Huoneet · Meteli", "dingo": "Nimmari · Huikka · Telkkari", "apteekki": "Käsikauppa · Reseptit"}.get(who, "Tanssi · Tarjoa lonkero")
	_hint.text = " "
	_talk_prompt.show_for(null, Settings.action_key("interact"), "Puhu", TALKERS[who][0], TALKERS[who][1], sub)


func _talk_state_kind() -> String:
	return "ulko" if state == "ulkona" else state


## Avaa keskustelun: ohjattava hahmo pysähtyy, sisätilan toimintopisteet ja hahmon omat repliikit tauolle.
func _talk_open(who: String, node: Node3D, hello := "") -> void:
	_talk_who = who
	_mopo_menu(true)  # Vaalan ovikeskustelu: valinnan E ei saa avata ovea (ja keskustelua) uudelleen
	if who in ["pekka", "arto", "sinikka"]:
		tilat.first(who, 0.0)  # naapuri tavattu: kartan laskuri ja tehtävien ehdot (first:sinikka)
	elif who == "santtu":
		tilat.first("santtu")  # luku 2 alkaa Santun tapaamisesta, valitsipa mitä tahansa
	elif who.begins_with("kolmio_"):
		tilat.first("kolmio_tavattu_" + who.substr(7), 0.0)  # kolmiomittaus päiväkirjaan (quests.gd SIDE)
	_talk_node = node
	_talk_kind = _talk_state_kind()
	var w := _active_walker()
	w.controls_enabled = false
	if "speed" in w:
		w.speed = 0.0
	_interior_busy(true)
	if node != null and "quiet" in node:
		node.quiet = true
		node.say("")
	CamCtl.free_mouse = true
	_msg.text = ""
	_msg_time = 0.0
	if hello == "":
		hello = _talk_hello(who)
	_talk_box.open(TALKERS[who][0], TALKERS[who][1], hello, _talk_options(), _talk_open_info(who))
	# Päivi huomaa, jos juttelet Sinikan kanssa hänen lähellään.
	if who == "sinikka" and is_instance_valid(wife) and wife.visible \
			and wife.global_position.distance_to(player.global_position) < 30.0 and _once_today("sinikka_paivi"):
		tilat.add("stressi", -0.2)
		_show_message("Päivi: \"Mitä sää siellä Sinikan pihalla notkut?!\"", 3.0)


## Santtu lavalle: kun päivän hommat on tehty, Santtu ehdottaa lavaa; suostuttua hän hyppää mopon taakse seuraavalla
## mopomatkalla mökiltä ja tanssii lavalla mukana. Matkan lopuksi (mökille, uusi päivä) hän palaa kannolleen.
var _santtu_lava_day := -1
var _santtu_riding := false
const SANTTU_LAVA_HELLO := "Hommat on tehty! Lähetäänkö illalla Oulujärven lavalle? Humppaveikot soittaa, ja diskopuolella on nuorisoa. Mää hyppään mopon taakse."


## Luku 2: Santun hommat alkavat vasta mökkiyön jälkeen. Siihen asti Santtu kertoo yöpymisestä, ei anna hommavihjettä.
const SANTTU_FIRST_DAY := "Tervetuloa Paapeliin! Jää yöksi, niin aamulla on pihahommia. Kirjoitan listan lappuun."


func _santtu_hommat_later(who: String) -> bool:
	if who != "santtu" or hommat == null or hommat.active:
		return false
	var a: Array = quests.active_step(tilat.firsts, quest_flag)
	return not a.is_empty() and a[1].id == "hommat"


func _santtu_offers_lava() -> bool:
	return hommat.active and hommat.all_done() and _santtu_lava_day != day and not _santtu_riding


func _talk_hello(who: String) -> String:
	if who.begins_with("isanta_"):
		var fk := _farm_by_talker(who)
		return fk.talk_hello() if fk != null else ""
	for r in rikos:
		var rh: String = r.hello(who)
		if rh != "":
			return rh
	if who in HS_TALKERS:
		return _hs_hello(who)
	var sh := _story_hint(who, true)
	if sh != "":
		return sh
	if who.begins_with("sinikka") and drakkar_day == day and _once_today("drakkar_sinikka"):
		tilat.add("moraali", 0.1)
		return "Mmm... onks toi Drakkar Noir? Tuu vähän lähemmäs, komistus. Ihan ku ois -94 ja Zabukin tanssit."
	if _santtu_hommat_later(who):
		return SANTTU_FIRST_DAY
	if who == "santtu" and _santtu_offers_lava():
		return SANTTU_LAVA_HELLO
	if who == "pekka" and story.step in ["pekka_kutsuu", "pekka_avaimet"]:
		return "Hei! Tuu tänne, mulla ois asiaa!"
	if who == "pekka" and is_instance_valid(vaino) and vaino.mode == "follow":
		return "VÄINÖ! Siinähän se on, perkele!"
	if who == "pekka" and laatikko.angry(day):
		return "No? Missä mun puolikas niistä kirppisrahoista, perkele? Ei kyytejä ennen ku tilitetään."
	sh = _ebike_tip(who)
	if sh != "":
		return sh
	if who == "huutaja" and kirppis_int != null and kirppis_int.mode == "bingo":
		return "Illan bingo on pelattu. Ensi tiistaina uudestaan!" if _bingo_day == day else "Bingo alkaa! Lappu kaks euroa, ja kynä mukaan."
	if who == "huutaja" and _auction_day == day:
		return "Tämän päivän huutokauppa on pidetty. Huomenna uusi kohde!"
	if who == "pojat" and _ball_quest == "search" and not has_ball and randf() < 0.4:
		return "Setä, ootko nähny meiän palloa?"
	return TALK_HELLO[who].pick_random() if TALK_HELLO.has(who) else ""


func _talk_open_info(who: String) -> String:
	if who.begins_with("isanta_"):
		var fk := _farm_by_talker(who)
		return fk.talk_info() if fk != null else ""
	match who:
		"santtu":
			if hommat.active:
				return "Santun hermot: %s %s" % [hommat.bar(), hommat.mood()]
		"kauppias":
			return interior.price_note()
		"apteekki":
			return "Rahaa %s €. Reseptejä %d." % [_eur(money), reseptit]
		"apteekki_taka", "apteekki_hoitaja":
			return "Rahaa %s €. Hinnat x10, ei reseptiä." % _eur(money)
		"raahe", "siitari", "zabuki", "gasthaus", "kauppa_auto", "leirintaalue", "kaukalo_teinit", "laavu_teinit":
			return "Rahaa %s €." % _eur(money)
		"mopopojat":
			return "Rahaa %s €. Kisoja voitettu %d." % [_eur(money), _race_wins]
		"nuoret":
			return "Lavalta kuuluu humppa aidan yli. Kaljoja mukana %d." % beers
	return ""


## Keskustelu katkeaa, jos tilanne muuttuu (välianimaatio, tila vaihtui, hahmo meni piiloon tai liian kauas).
func _talk_watch() -> void:
	var stop: bool = cutscene.busy or _talk_state_kind() != _talk_kind
	if not stop and _talk_node != null:
		if not is_instance_valid(_talk_node) or not _talk_node.visible or ("hiding" in _talk_node and _talk_node.hiding):
			stop = true
		else:
			var p := _active_walker().global_position
			var q := _talk_node.global_position
			stop = Vector2(p.x - q.x, p.z - q.z).length() > 7.0
	if stop:
		_talk_box.close()


func _talk_end() -> void:
	_talk_end_frame = Engine.get_process_frames()
	_kesa_valinta = false  # suljettu ilman valintaa: koputus tai paluu uudestaan ovella
	if _talk_who == "apteekki_taka":
		_taka_hatch(false)
		Sfx.play("door_close", -4.0)
	elif _talk_who == "apteekki_hoitaja":
		_hs_hatch(false)
		Sfx.play("door_close", -4.0)
	_mopo_menu(false)
	CamCtl.free_mouse = false
	if is_instance_valid(_talk_node) and "quiet" in _talk_node:
		_talk_node.quiet = false
	# Ohjaus takaisin vain, jos ollaan yhä samassa tilanteessa (välianimaatio tai tilan vaihto hoitaa omansa).
	if not cutscene.busy and _talk_state_kind() == _talk_kind:
		_active_walker().controls_enabled = true
		_interior_busy(false)
		if state == "in_raahe":
			raahe_int.block_interact()
		elif state == "in_siitari":
			siitari_int.block_interact()
		elif state == "in_apteekki":
			apteekki_int.block_interact()
		elif state == "in_kirppis":
			kirppis_int.block_interact()
		elif state == "in_varasto":
			varasto_int.block_interact()
		elif state == "in_retki":
			retki_int.block_interact()
	if _talk_who == "poliisi" and _ratsia_stage in ["puhallus", "tulos"]:
		# Ikkuna suljettiin kesken (Esc): puhaltamatta ei lähdetä, tulos luetaan viestinä ja matka jatkuu.
		if _ratsia_stage == "puhallus":
			var r := _ratsia_blow(false)
			_show_message("Roivainen: \"%s\" %s" % [r[0], r[1]], 5.0)
		_ratsia_release.call_deferred()
	_talk_who = ""
	_talk_node = null


func _opt(id: String, text: String, ok := true, reason := "", hot := false) -> Dictionary:
	return {"id": id, "text": text, "enabled": ok, "reason": reason, "hot": hot}


func _goods_value(buyer: String) -> float:
	var sale := 0.0
	for k in bucket:
		if GOODS[k].buyer == buyer:
			sale += bucket[k] * GOODS[k].price
	return sale


