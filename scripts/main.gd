## Paperikartan Sinikka-merkki (paper_map.gd _sinikka_icon_on): uimaranta x/z, kun lappu on luettu, muuten INF.
func sinikka_map_mark() -> Vector2:
	if not sk.lappu_luettu or world == null or world.uimaranta_pos == Vector3.ZERO:
		return Vector2.INF
	return Vector2(world.uimaranta_pos.x, world.uimaranta_pos.z)


## Sinikka rannalla: näkemisbonus kerran päivässä, jutteleminen (sormuksen voi antaa) ja mummojen kantelu, jos
## jää tuijottamaan. Palauttaa true, jos vihje asetettiin.
func _sinikka_beach(e: bool) -> bool:
	if not _sinikka_swimming() or world.uimaranta_sinikka == null:
		_sinikka_stare_t = 0.0
		return false
	var sp: Vector3 = world.uimaranta_sinikka_pos
	if not _near_xz(sp, 8.0):
		_sinikka_stare_t = 0.0
		return false
	if _sinikka_seen_day != day:
		_sinikka_seen_day = day
		tilat.add("moraali", 0.15)
		tilat.add("vireys", 0.15)
		tilat.add("stressi", 0.15)
		tilat.first("sinikka_ranta", 0.3)
		Sfx.play("water", -14.0, 1.2)
		_show_message("Sinikka nousee vedestä pienissä punaisissa lappubikineissä ja heilauttaa kättä: \"Huomenta naapuri! Vesi on ihanaa.\" "
			+ "Aamu parani heti.", 4.5)
	_sinikka_stare_t += get_process_delta_time()
	if _sinikka_stare_t > 8.0 and _between(clock_min, ORAVA_MUMMOT) and _sinikka_tattle_day != day:
		_sinikka_tattle_day = day
		_show_message("Rannan mummot kuiskuttelee ja katsoo sua pitkään. Tästä kuullaan vielä.", 3.5)
	if _near_xz(sp, 2.5):
		_hint.text = "[E] Juttele Sinikan kanssa (aamu-uinnilla)"
		if e:
			_talk_open("sinikka", world.uimaranta_sinikka, "Huomenta! Mää käyn täällä joka aamu. Älä kerro Päiville, että nähtiin, se on niin mustasukkainen.")
		return true
	return false


## Aurinkoa ottava Sinikka rannalla: 8 m:n päässä lasit otsalle ja pää pelaajaan päin (kerran lähestymistä kohti),
## 2,5 m:n päässä juttelu. Palauttaa true, jos vihje asetettiin.
func _sinikka_sun(e: bool) -> bool:
	var s: Node3D = world.uimaranta_aurinko
	if s == null or not _sinikka_sunbathing():
		_ranta_noticed = false
		return false
	var sp: Vector3 = world.uimaranta_aurinko_pos
	if not _near_xz(sp, 8.0):
		if _ranta_noticed and not _near_xz(sp, 10.0):
			_ranta_noticed = false
			s.relax()
		return false
	if not _ranta_noticed:
		_ranta_noticed = true
		s.notice("No moi naapuri. Tuu vaan lähemmäs, mää en pure.")
	if _near_xz(sp, 2.5):
		_hint.text = "[E] Juttele Sinikan kanssa (ottaa aurinkoa)"
		if e:
			_talk_open("sinikka", s, _ranta_line())
		return true
	return false


## Seuraava repliikki sekoitetusta pakasta (ei toistu ennen kuin pakka on käyty läpi).
func _ranta_line() -> String:
	if _ranta_deck.is_empty():
		_ranta_deck = RantaFlirtti.deck(_ranta_last)
	_ranta_last = _ranta_deck.pop_front()
	return RantaFlirtti.LINES[_ranta_last]


## Kuinka moni rannan perhe tai mummo näkee (näkyvissä, alle 15 m pelaajasta).
func _ranta_witnesses() -> int:
	var n := 0
	for h in world.uimaranta_people:
		if h.is_visible_in_tree() and _near_xz(h.global_position, 15.0):
			n += 1
	return n


## Vastaus rannalla: Sinikka vastaa aina, mittarit kerran päivässä. Flirtti todistajien nähden kantautuu Päiville
## arvalla (RANTA_TATTLE_CHANCE); kerrotaan aamulla _flowers_morning-rivillä.
func _ranta_choose(id: String) -> void:
	var c: Array = RantaFlirtti.CHOICES[id]
	var info := RantaFlirtti.SPENT
	if _once_today("ranta_sinikka"):
		var fx: Dictionary = c[2]
		for k in fx:
			tilat.add(k, fx[k])
		info = "Tilat: %s" % ", ".join(fx.keys().map(func(k): return ("%s %+.2f" % [k, fx[k]]).replace(".", ",")))
	# Arpa kerran päivässä (ensimmäinen flirtti perheiden nähden), ettei toistaminen varmista kantelua.
	if id == "ranta_flirtti" and _ranta_roll_day != day and _ranta_witnesses() > 0:
		_ranta_roll_day = day
		if randf() < _ranta_tattle_chance:
			_sinikka_flirt_tattle_day = day
			info = RantaFlirtti.SEEN
	_talk_box.reply(c[1], _talk_options(), info)


## Testi (--scene=sinikkaranta): aurinkoa ottava Sinikka klo 13. Näkyvyys, vihje, repliikit ilman toistoa (K3),
## mittarit kerran päivässä (K4), kantelu todistajien kanssa ja ilman (K5), piilossa klo 11 ja 18 (K1), ruutuaika (K7).
func _sinikka_sun_test(frames: Callable, snap: Callable) -> void:
	var vika := func(t: String) -> void: print("TESTI VIKA aurinko-Sinikka: " + t)
	var su: Node3D = world.uimaranta_aurinko
	if su == null:
		vika.call("world.uimaranta_aurinko puuttuu")
		return
	clock_min = 13 * 60
	for i in 5:  # näkyvyys _process:ssa ja asento (_place) 0,1 s pelin aikaa myöhemmin
		await get_tree().process_frame
	print("AS klo 13: aurinko %s, uinti %s, piha %s" % [su.visible, world.uimaranta_sinikka.visible, sinikka.visible])
	if not su.visible or world.uimaranta_sinikka.visible or sinikka.visible:
		vika.call("näkyvyys klo 13")
	var ap: Vector3 = world.uimaranta_aurinko_pos
	var side := Vector3(1, 0, 0).rotated(Vector3.UP, su.rotation.y)  # pyyhkeen sivu (paikallinen X)
	walker_out.global_position = ap + side * 6.0 + Vector3(0, 0.3, 0)
	await frames.call(10)
	for i in 3:  # fysiikkaruutuja voi mennä useita yhden piirtoruudun aikana: vihje päivittyy vasta _process:ssa
		await get_tree().process_frame
	print("AS 6 m: huomattu %s, vihje '%s'" % [_ranta_noticed, _hint.text])
	await snap.call("_aurinko_huomaa.png")
	walker_out.global_position = ap + side * 2.0 + Vector3(0, 0.3, 0)
	# Pyörä viereen (alle 2,6 m): Sinikan juttelu on tärkeämpi ja voittaa pyörän selkään nousun vihjeen.
	var bike_was: Vector3 = bike.global_position
	bike.global_position = ap + side * 3.5 + Vector3(0, 0.5, 0)
	await frames.call(25)  # siirron jälkeen pelaaja on hetken lyöty (is_stunned), vihje tulee vasta sen jälkeen
	for i in 3:
		await get_tree().process_frame
	print("AS pyörä %.2f m pelaajasta" % walker_out.global_position.distance_to(bike.global_position))
	print("AS 2 m: vihje '%s', etäisyys %.2f m, korkeus %.2f (maa %.2f), lyöty %s" % [_hint.text,
		Vector2(player.global_position.x - ap.x, player.global_position.z - ap.z).length(), player.global_position.y, ap.y, player.is_stunned()])
	if not "Juttele Sinikan" in _hint.text:
		vika.call("vihje 2 m:ssä puuttuu")
	bike.global_position = bike_was
	_ranta_deck.clear()
	_ranta_last = -1
	_talk_open("sinikka", su, _ranta_line())
	var lines: Array = [_talk_box._line]
	for i in 5:
		_talk_choose("juttu")
		lines.append(_talk_box._line)
	var uniq := {}
	for l in lines:
		uniq[l] = true
	print("AS repliikit %d, eri %d: %s" % [lines.size(), uniq.size(), lines.map(func(l): return (l as String).left(24))])
	if uniq.size() < lines.size():
		vika.call("repliikki toistui samalla juttelukerralla")
	var ids: Array = _talk_options().map(func(o): return o.id)
	print("AS valinnat: %s" % [ids])
	for id in RantaFlirtti.CHOICES:
		if not id in ids:
			vika.call("valinta %s puuttuu" % id)
	# K4 + K5 ilman todistajia: perheet piiloon (synkronisesti, _pohjoiset_visuals palauttaa ne seuraavassa ruudussa).
	for k in ["moraali", "vireys", "stressi"]:
		tilat.values[k] = 0.0
	_today.erase("ranta_sinikka")
	_sinikka_flirt_tattle_day = -1
	_ranta_roll_day = -1
	_ranta_tattle_chance = 1.0
	for h in world.uimaranta_people:
		h.visible = false
	print("AS todistajia piilotettuna %d" % _ranta_witnesses())
	_talk_choose("ranta_flirtti")
	var m1: float = tilat.values["moraali"]
	print("AS flirtti 1: moraali %.2f vireys %.2f stressi %.2f, info '%s'" % [m1, tilat.values["vireys"], tilat.values["stressi"], _talk_box._info])
	if m1 <= 0.0:
		vika.call("mittarit eivät muuttuneet")
	_talk_choose("ranta_vitsi")
	print("AS toinen valinta: moraali %.2f (sama %s), info '%s'" % [tilat.values["moraali"], is_equal_approx(tilat.values["moraali"], m1), _talk_box._info])
	if not is_equal_approx(tilat.values["moraali"], m1):
		vika.call("toinen valinta samana päivänä muutti mittareita")
	print("AS ilman todistajia kantelupäivä %d (päivä %d)" % [_sinikka_flirt_tattle_day, day])
	if _sinikka_flirt_tattle_day == day:
		vika.call("kantelu ilman todistajia")
	_pohjoiset_visuals()
	var w := _ranta_witnesses()
	print("AS todistajia näkyvissä %d" % w)
	if w == 0:
		vika.call("perheitä ei 15 m:n säteellä (todistajatesti ei kata)")
	# Arpa 0: todistajat näkivät, mutta eivät kerro.
	_ranta_roll_day = -1
	_ranta_tattle_chance = 0.0
	_talk_choose("ranta_flirtti")
	print("AS arpa 0: kantelupäivä %d" % _sinikka_flirt_tattle_day)
	if _sinikka_flirt_tattle_day == day:
		vika.call("kantelu, vaikka arpa 0")
	# Arpa 1: kertovat; seuraavana aamuna Päivin rivi.
	_ranta_roll_day = -1
	_ranta_tattle_chance = 1.0
	_talk_choose("ranta_flirtti")
	print("AS arpa 1: kantelupäivä %d, info '%s'" % [_sinikka_flirt_tattle_day, _talk_box._info])
	_talk_box.close()
	_ranta_tattle_chance = RANTA_TATTLE_CHANCE
	day += 1
	var morning := _flowers_morning(false)
	print("AS aamu todistajien jälkeen: rivi %s" % [RantaFlirtti.MORNING in morning])
	if not RantaFlirtti.MORNING in morning:
		vika.call("aamurivi puuttuu todistajien jälkeen")
	day += 1
	if RantaFlirtti.MORNING in _flowers_morning(false):
		vika.call("aamurivi ilman uutta flirttiä")
	# K7: ruutuaika rannalla, aurinko-Sinikka näkyvissä ja piilossa.
	walker_out.global_position = ap + side * 6.0 + Vector3(0, 0.3, 0)
	var ms := []
	var info := []  # [kutsuja, kolmioita] per tila
	for c in [13 * 60, 11 * 60 + 59]:  # 11.59: sama valo, mutta Sinikka piilossa (_pohjoiset_visuals)
		clock_min = c
		await frames.call(8)
		var t0 := Time.get_ticks_usec()
		for i in 12:  # testipiirrossa ruutu voi kestää sekunteja: 12 ruutua riittää keskiarvoon
			await get_tree().process_frame
		ms.append((Time.get_ticks_usec() - t0) / 12000.0)
		info.append([RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME),
			RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME)])
		print("AS piirto klo %d: kutsuja %d, kolmioita %d" % [c / 60, info[-1][0], info[-1][1]])
	print("AS ruutu rannalla %.1f ms (Sinikka piilossa %.1f ms, vain tiedoksi)" % [ms[0], ms[1]])
	# Ruutuaika ohjelmistopiirrossa (llvmpipe) heittelee ±15 % ajosta toiseen, joten raja on piirtomäärissä: Sinikka
	# välineineen saa lisätä enintään 100 piirtokutsua ja 40 000 kolmiota (mitattu 60 ja 11 000; ruudussa 1,2 milj.).
	if info[0][0] - info[1][0] > 100 or info[0][1] - info[1][1] > 40000:
		vika.call("Sinikka lisää %d piirtokutsua ja %d kolmiota" % [info[0][0] - info[1][0], info[0][1] - info[1][1]])
	for c in [11, 18]:
		clock_min = c * 60
		await frames.call(5)
		for i in 3:
			await get_tree().process_frame
		print("AS klo %d: aurinko %s" % [c, su.visible])
		if su.visible:
			vika.call("näkyy klo %d" % c)
	print("AS valmis")


func _orava_families() -> bool:
	return _between(clock_min, ORAVA_PERHEET)


# Saloisten kenttä: rankkarit poikien kanssa ja juoksulenkki.
func _kentta_logic(e: bool) -> void:
	if not _near_xz(world.kentta_spot, 80.0):
		_lenkki.on = false
		return
	tilat.first("kentta", 0.1)
	if _lenkki.on:
		var c: Vector3 = world.kentta_laps[_lenkki.next]
		_hint.text = "Juoksulenkki: kierros %d, seuraava kulma %d/4" % [_lenkki.laps + 1, _lenkki.next + 1]
		if _near_xz(c, 3.5):
			_lenkki.next = (_lenkki.next + 1) % 4
			Sfx.play("step_grass", -4.0, 1.2)
			if _lenkki.next == 0:
				_lenkki.laps += 1
				tilat.add("stamina", -0.04)
				if _once_today("lenkki"):
					tilat.add("vireys", 0.15)
					tilat.add("stressi", 0.15)
					tilat.first("juoksulenkki", 0.2)
				_show_message("Kierros %d juostu! Pojat huutelee: \"Setä hölkkää!\"" % _lenkki.laps if _between(clock_min, RANKKU_OPEN) else
					"Kierros %d juostu! Hiki virtaa." % _lenkki.laps, 2.5)
		return
	if _near_xz(world.kentta_spot, 3.0):
		if not _between(clock_min, RANKKU_OPEN):
			_hint.text = "Rankkaripiste. Pojat pelaa täällä päivisin (10–20)."
		elif _rankku_played("saloinen"):
			_hint.text = "Pojat: \"Huomenna uusiks, setä!\""
		else:
			_hint.text = "[E] Rankkarit poikien kanssa (viisi kumpikin)"
			if e:
				_start_rankku("saloinen")
		return
	if _near_xz(world.kentta_laps[0], 3.0):
		_hint.text = "[E] Juoksulenkki kentän ympäri (kulmasta kulmaan)"
		if e:
			_lenkki = {"on": true, "next": 1, "laps": 0}
			_show_message("Lenkille! Kentän kulmat vastapäivään. Kunto kiittää.", 2.5)


## Kummankin kentän pojat pelaavat kerran päivässä.
func _rankku_played(field: String) -> bool:
	return _rankku_day == day and (_rankku_fields.is_empty() or field in _rankku_fields)


## Rankkarit oikealla kentällä (rankku_game.gd maalin kehyksessä): "saloinen" tai "honganpalo".
func _start_rankku(field: String) -> void:
	if _rankku != null:
		return
	if _rankku_day != day:
		_rankku_fields = []
	_rankku_day = day
	_rankku_fields.append(field)
	walker_out.controls_enabled = false
	walker_out.speed = 0.0
	walker_out.visible = false
	_hud.visible = false
	_minigame_prev = state
	state = "minigame"  # vaarat odottavat, eikä F nosta pyörän selkään pelin aikana
	_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	if is_instance_valid(boys):  # samat pojat pelaavat rankkareita: kivenheittäjät pois pelin ajaksi
		boys.visible = false
		boys.process_mode = Node.PROCESS_MODE_DISABLED
	var g := RankkuGame.new()
	_rankku = g
	g.drunk = _hand_shake()
	g.size = world.hongan_goal_size if field == "honganpalo" else world.kentta_goal_size
	var back: Vector3 = walker_out.global_position
	g.finished.connect(func(mine: int, theirs: int) -> void:
		_rankku = null
		state = _minigame_prev
		_hazards.set_deferred("process_mode", Node.PROCESS_MODE_INHERIT)
		if is_instance_valid(boys):
			boys.visible = true
			boys.process_mode = Node.PROCESS_MODE_INHERIT
		walker_out.global_position = back
		walker_out.velocity = Vector3.ZERO
		walker_out.visible = true
		walker_out.controls_enabled = true
		walker_out.activate_camera()
		_hud.visible = true
		tilat.first("rankkarit", 0.2)
		tilat.add("stamina", -0.05)
		if g.quit:
			tilat.add("stressi", -0.05)
			_show_message("Luovutit rankkarit kesken. Pojat nauraa vielä huomennakin.", 3.0)
		elif mine > theirs:
			tilat.first("rankkarit_voitto", 0.4)
			maine = clampf(maine + 3.0, 0.0, 100.0)
			tilat.add("moraali", 0.15)
			_show_message("Voitit pojat rankkareissa %d–%d! Maine +3.%s" % [mine, theirs,
				" Pojat lupaa olla heittelemättä kiviä... tänään." if field == "saloinen" else ""], 4.0)
		elif mine == theirs:
			_show_message("Tasapeli %d–%d. Pojat haluaa ratkaista huomenna." % [mine, theirs], 3.5)
		else:
			tilat.add("stressi", -0.05)
			_show_message("Rankkarit %d–%d. Pojat nauraa, mutta kutsuu huomenna uudestaan." % [mine, theirs], 3.5)
		_save_game())
	world.add_child(g)
	g.global_transform = world.hongan_goal if field == "honganpalo" else world.kentta_goal


# Oravajärven uimaranta: uinti, löydöt pohjasta, rantagrilli, kalja penkillä ja pukukopin jemma (_stash_logic).
func _uimaranta_logic(e: bool) -> void:
	if not _near_xz(world.uimaranta_pos, 40.0):
		return
	tilat.first("oravajarvi", 0.1)
	if _sinikka_beach(e):
		return
	if _sinikka_sun(e):
		return
	if _near_xz(world.uimaranta_pos, 4.0):
		_hint.text = "[E] Uimaan: Oravajärvi"
		if e:
			_swim("Oravajärvi", Vector3.ZERO)
		return
	if _near_xz(world.grilli_ranta_pos, 2.2):
		if has_sausage and not sausage_done:
			_hint.text = "[E] Paista makkara rantagrillillä"
			if e:
				sausage_done = true
				Sfx.play("whoosh", -6.0, 0.6)
				tilat.first("rantagrilli", 0.2)
				_show_message("Makkara tirisee rantagrillillä. %s" % ("Perheiden lapset tuijottaa nälkäisinä." if _orava_families()
					else "Rauhallista, vain lokit seuraa."), 3.0)
		else:
			_hint.text = "Rantagrilli. Makkara mukaan kaupasta."
		return
	if _near_xz(world.uimaranta_bench, 1.8):
		if beers > 0 and not ("ranta_kalja" in _today):
			_hint.text = "[E] Kalja penkillä rannalla"
			if e:
				_today.append("ranta_kalja")
				beers -= 1
				player.set_carrying(beers > 0)
				_drink(1)
				Sfx.play("glass", -6.0, 0.9)
				if _orava_families():
					tilat.add("stressi", -0.2)
					maine = clampf(maine - 2.0, 0.0, 100.0)
					_show_message("Lapsiperheen äiti katsoo pitkään ja kaivaa puhelimen. Päivi tietää tästä illalla. Maine −2.", 4.0)
				else:
					tilat.add("stressi", 0.25)
					tilat.first("ranta_kalja", 0.2)
					_show_message("Järvi välkkyy, kaislikossa narskuttaa sorsa. Kalja rannalla ilman yleisöä: täydellistä.", 4.0)
		else:
			_hint.text = "Penkki rannalla."


## Oravajärven uinti välianimaationa (Salmisen uinnin kehyksellä) ja joka päivä yksi löytö pohjasta.
func _orava_swim() -> void:
	_act_begin()
	var dir: Vector2 = M.UIMARANTA_DIR
	var bp: Vector3 = world.uimaranta_pos
	var frame := Transform3D(Basis(Vector3.UP, atan2(dir.x, dir.y)), bp)
	var lake := bp + Vector3(dir.x, 0, dir.y) * 12.0
	var wl := Terrain.h(lake.x, lake.z) + 0.01
	var ground := func(g: Vector3) -> float:
		var along := Vector2(g.x - bp.x, g.z - bp.z).dot(dir)
		return Terrain.h(g.x, g.z) - clampf((along - 1.5) * 0.3, 0.0, 1.6)
	var crowd := "Perheet kirkuu matalikossa." if _orava_families() else ("Mummot uivat rintaa jonossa." if _between(clock_min, ORAVA_MUMMOT) else "Rannalla ei ketään.")
	cutscene.swim_dive(frame, wl, ground, func() -> void:
		_act_end()
		var found := ""
		if _orava_find_day != day:
			for f in ORAVA_FINDS:
				if not f[0] in _orava_finds:
					_orava_finds.append(f[0])
					_orava_find_day = day
					found = " " + f[1]
					if f[0] == "aurinkolasit":
						tilat.add("moraali", 0.1)
					break
		_save_game()
		_show_message("Pulahdit Oravajärveen. Turvevetistä mutta raikasta, kunto palautui.%s" % found, 5.0),
		"ORAVAJÄRVI", "Kylän oma uimaranta. %s" % crowd, "Oravajärvi. Kotoa vartti pyörällä.")


# SEO Saloinen 24/7 ja ravintola A+.
func _seo_logic(e: bool) -> void:
	if not _near_xz(world.seo_door, 60.0):
		return
	tilat.first("seo", 0.1)
	if _near_xz(world.seo_door, 2.2):
		_hint.text = "[E] SEO Saloinen: myymälä (auki 24/7)"
		if e:
			_talk_open("seo", null, "Yövuoro. Kahvi on keitetty kolmelta, munkit eiliseltä." if not _between(clock_min, Vector2(6 * 60, 22 * 60)) else "")
		return
	if _near_xz(world.aplus_door, 2.2):
		if _between(clock_min, APLUS_ILTA) or (_weekday() < 5 and _between(clock_min, APLUS_LOUNAS)):
			_hint.text = "[E] Ravintola A+"
			if e:
				_talk_open("aplus", null)
		else:
			_hint.text = "Ravintola A+ on kiinni. Lounas ma–pe 10.30–14, ilta 16–22."
		return
	if world.seo_truck != null and _near_xz(world.seo_truck.global_position, 4.5):
		_hint.text = "Raahen Kuljetuksen rekka. Kuski on myymälässä kahvilla."


func _pohjoiset_options(who: String, o: Array) -> void:
	match who:
		"seo":
			o.append(_opt("kahvi", "Kahvi (%s €)" % _eur(SEO_KAHVI), money >= SEO_KAHVI, "rahat ei riitä"))
			o.append(_opt("munkki", "Munkki (%s €, reppuun)" % _eur(SEO_MUNKKI), money >= SEO_MUNKKI, "rahat ei riitä"))
			var rekka_shut := closed_text("raahe", fposmod(clock_min + HOP_RAAHE, 1440.0))  # kuten taksi: baari auki perillä
			o.append(_opt("rekka", "Kysy rekkakuskilta kyytiä Raaheen", not _in_vaala and _between(clock_min, Vector2(6 * 60, 23 * 60))
				and rekka_shut == "", "baari on kiinni perillä, aukeaa klo %d" % int(OPEN_HOURS.raahe.x / 60.0)
				if rekka_shut != "" and _between(clock_min, Vector2(6 * 60, 23 * 60)) else "kuski nukkuu ohjaamossa (6–23)", true))
		"aplus":
			if _weekday() < 5 and _between(clock_min, APLUS_LOUNAS):
				o.append(_opt("lounas", "Lounas: lihapullat, muusi ja kotikalja (%s €)" % _eur(APLUS_LOUNAS_HINTA),
					money >= APLUS_LOUNAS_HINTA and _lunch_day != day, "jo syöty tänään" if _lunch_day == day else "rahat ei riitä", true))
			if _between(clock_min, APLUS_ILTA):
				o.append(_opt("tuoppi", "Tuoppi tiskiltä (%s €)" % _eur(APLUS_KALJA), money >= APLUS_KALJA, "rahat ei riitä"))
		"katsastaja":
			var why := ""
			if katsastus == "hyvaksytty":
				why = "jo hyväksytty"
			elif not ebike.built():
				why = "ei kasattua sähköpyörää"
			elif oma_mopo.riding:
				why = "sähköpyörä on tallissa, pihassa on mopo"  # pyöräsolmu on mopon ajon aikana mopo
			elif not is_instance_valid(bike) or bike.global_position.distance_to(world.katsastus_door) > 18.0:
				why = "sähköpyörä pitää tuoda pihaan"
			elif money < KATSASTUS_HINTA:
				why = "rahat ei riitä"
			o.append(_opt("katsasta", "Katsasta sähköpyörä (%s €)%s" % [_eur(KATSASTUS_HINTA), "  ✔ hyväksytty" if katsastus == "hyvaksytty" else ""],
				why == "", why, katsastus != "hyvaksytty"))
		"hitsari":
			o.append(_opt("ruuvit", "Osta ruuvipussi (%s €, 4 ruuvia)" % _eur(HITSARI_RUUVIT), money >= HITSARI_RUUVIT, "rahat ei riitä"))
			if ebike.joints.has("akku") and (ebike.joints.akku != "ruuvi" or ebike.loose.has("akku")):
				o.append(_opt("teline", "Hitsaa sähköpyörään akkuteline (%s)" % ("kalja" if beers > 0 else _eur(HITSARI_TELINE) + " €"),
					beers > 0 or money >= HITSARI_TELINE, "ei kaljaa eikä rahaa", true))


func _pohjoiset_choose(id: String) -> void:
	match id:
		"kahvi":
			money -= SEO_KAHVI
			tilat.add("vireys", 0.2)
			tilat.add("stressi", 0.05)
