## laittaa arvon eteisen kaappiin (testit ja loppukohtaus).
var jemma: int:
	get:
		var n := 0
		for id in STASHES:
			if STASHES[id].home:
				n += stash.get(id, 0)
		return n
	set(v):
		for id in STASHES:
			if STASHES[id].home:
				stash[id] = 0
		stash["koti"] = v
