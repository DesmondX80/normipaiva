	_talk_box.reply(["Kiitos! Käteinen on kuningas.", "Tässä, ja kuitti mukaan.", "Ensi viikolla taas, jos auto kestää."].pick_random(),
		_talk_options(), note + "   Rahaa %s €." % _eur(money))


