		"vanhaherra":
			return "sukelluksia %d" % vanhaherra.sukelluksia if vanhaherra.sukelluksia > 0 else ""
		"karhut":
			return "paras kuva %d / 100" % karhut.paras if karhut.yrityksia > 0 else ""
		"hiidenportti":
			return "nousuja %d" % hiidenportti.nousuja if hiidenportti.nousuja > 0 else ""
		"pyhakoski":
			return "tarinat %d / 3" % pyhakoski.kuultu()
		"messenius":
			return "koettu %d / 3" % messenius.kuultu()
		"raate":
			return "käyty %d / 3" % raate.kuultu()
		"kalajoki":
			return "harjoituspelejä voitettu %d" % kalajoki.harjoitus if kalajoki.harjoitus > 0 and kalajoki.voitot == 0 else ""
		"korkit":
			return "kansiossa %d / %d, tuplia %d" % [korkit.distinct(), Korkit.total_slots(), korkit.tuplat()]
		"tikka":
			return "ennätykset: darts %d, mökkitikka %d / 150" % [tikka_ennatys, mtikka_ennatys]
		"tekemiset":
			return "kokeiltu %d / %d" % [TEKEMISET.filter(func(k): return k in tilat.firsts).size(), TEKEMISET.size()]
		"iltakivat":
			var koettu: Array = KOLMIO_KIVAT.filter(func(k: String) -> bool: return ("kiva_" + k) in tilat.firsts)
			return "koettu %d / %d%s" % [koettu.size(), KOLMIO_KIVAT.size(), "" if koettu.size() == KOLMIO_KIVAT.size() else
				" (puuttuu: %s)" % ", ".join(KOLMIO_KIVAT.filter(func(k: String) -> bool: return not k in koettu).map(
				func(k: String) -> String: return KOLMIO_KIVA_NIMET[k]))]
		"hanttihommat":
			var n := 0
			for k in HANTTIHOMMAT:
				if k in tilat.firsts:
					n += 1
			return "kokeiltu %d / %d" % [n, HANTTIHOMMAT.size()]
	if key.begins_with("paivi_"):
		var po: Object = rikos_osa("paivi")  # luku 6 (#326): rikos/paivi.gd progress
		return po.progress(key) if po != null else ""
	return ""


## Päiväkirjan sisältö (journal.gd).
func journal_data() -> Dictionary:
	_quest_ideas()  # juuri tiedoksi tullut tehtävä saa ideaviestinsä ennen kuin build() merkitsee sen tunnetuksi
	var d: Dictionary = quests.build(tilat.firsts, quest_flag, story.list(quest_flag("paapeli"), jemma), quest_progress, day)
	# Onnelliset loput ja legendaariset hetket omina listoinaan (löytämättömät null = ???).
	for kind in ["loppu", "hetki"]:
		var list: Array = []
		var piilossa := 0
		for e in Endings.ENDINGS:
			if (kind == "loppu") != Endings.is_loppu(e[0]):
				continue
			if Settings.get_v("k18_pois") and e[0] in K18_LOPUT:
				piilossa += 1
				continue
			if endings.counts.has(e[0]):
				list.append({"name": e[1], "desc": e[2], "count": endings.counts[e[0]], "day": endings.first_day.get(e[0], 0)})
			else:
				list.append(null)
		var nahty_piilossa: int = K18_LOPUT.filter(func(k): return endings.counts.has(k) and (kind == "loppu") == Endings.is_loppu(k)).size() if piilossa > 0 else 0
		d["loput" if kind == "loppu" else "hetket"] = {"distinct": endings.distinct(kind) - nahty_piilossa, "max": Endings.max_count(kind) - piilossa,
			"total": endings.total(kind), "list": list}
	d["stashes"] = _stash_journal()
	d["riskit"] = _rikos_riskit()
	d["korkit"] = korkit.owned.duplicate()
	d["korkit_piilossa"] = korkit.piilossa
	if Settings.get_v("k18_pois"):
		d.side = d.side.filter(func(q): return not q.id in K18_SIDE)
	for s in d.side:
		s["spot"] = not s.done and not quest_spots(s.id).is_empty()
	_save_game()
	return d


