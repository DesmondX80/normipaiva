					"Marjatta näki: huoneen vahingot −%s €. Maine +3 bändin silmissä." % _eur(paid))
			else:
				_talk_box.reply("YEAH! Suoraan parkkipaikalle! Sää oot kunniajäsen!", _talk_options(),
					"Telkkari lensi ikkunasta. Moraali +, maine +3.")
