			chat = false
			# Hinta ja kesto lähtöpaikan mukaan: Vaalan tolpalta kaikki Raahen seudun kohteet ovat pitkän matkan päässä.
			if not _in_vaala:  # Vaalan tolpalta vain retket
				var raahe_offer := Retket.raahe_tarjous(false)
				var raahe_hop: float = raahe_offer.hop_min
				var raahe_fare: float = raahe_offer.hinta
				var shut := closed_text("raahe", fposmod(clock_min + raahe_hop, 1440.0))
				o.append(_opt("raahe", "Raahen baariin (%s €, meno-paluu)%s" % [_eur(raahe_fare), _late_note(raahe_hop)], money >= raahe_fare and shut == "",
					"baari on kiinni perillä, aukeaa klo %d" % int(OPEN_HOURS.raahe.x / 60.0) if shut != "" else "rahat ei riitä"))
			for rid in Retket.lahdosta("taksi"):
				var r: Dictionary = Retket.LISTA[rid]
				var offer := Retket.tarjous(rid, _in_vaala)
				o.append(_opt("retki_" + rid, "%s (%s €, meno-paluu)%s" % [r.nimi, _eur(offer.hinta), _late_note(offer.hop_min)], money >= offer.hinta, "rahat ei riitä"))
			if not pakkahuone.heard:
				o.append(_opt("pakkahuone_kerro", "Mikä se Pakkahuone oikein on?", true, "", true))
			if not peruskivi.heard:
				o.append(_opt("peruskivi_kerro", "Mikä se Rautaruukin peruskivi oikein on?", true, "", true))
			if not manamansalo.heard:
				o.append(_opt("manamansalo_kerro", "Mikä se Manamansalon kuolemansaari oikein on?", true, "", true))
			if not hanhikivi.heard:
				o.append(_opt("hanhikivi_kerro", "Mikä se Hanhikivi oikein on?", true, "", true))
			if not "matkaopas" in tilat.firsts:
				o.append(_opt("matkaopas", "Onko sulla mitään esitettä näistä retkipaikoista?", true, "", true))
		"leirintaalue":
			chat = false
			o.append(_opt("lupa", "Osta kalalupa (%s €): vuokraonki ja 8 matoa mukana" % _eur(KALALUPA_PRICE), money >= KALALUPA_PRICE and not kalalupa,
				"lupa on jo ostettu" if kalalupa else "rahat ei riitä", not kalalupa))
			o.append(_opt("lampi_kysy", "Mitä lammessa on?"))
		"raahe", "siitari":
			var menu: Dictionary = RAAHE_MENU if who == "raahe" else SIITARI_MENU
			for id in menu:
				var m: Array = menu[id]
				o.append(_opt("juo_" + id, "%s (%s €)" % [m[0], _eur(m[1])], money >= m[1], "rahat ei riitä"))
		"visa":
			chat = false
			if _quiz_i < _quiz.size():
				var q: Array = _quiz[_quiz_i]
				for k in (q[1] as Array).size():
					o.append(_opt("visa_%d" % k, q[1][k]))
		"roivainen":
			if _tutka_stage == "pysaytys":
				chat = false
				var fine := _tutka_fine()
				o.append(_opt("sakko_maksa", "Maksa sakko (%s €)" % _eur(fine), true, "", true))
				o.append(_opt("sakko_selitys", "Mää vaan testasin, kulkeeko tää", true, "", true))
			elif _tutka_stage == "tulos":
				chat = false
				o.append(_opt("jatka", "Jatka matkaa", true, "", true))
		"janttu":
			var jalan := mopo_trip.on_foot != null  # ajaessa ei tarjota
			o.append(_opt("janttu_kalja", "Tarjoa kalja", jalan and beers > 0, "ei kaljaa mukana" if jalan else "ei ajaessa"))
			o.append(_opt("janttu_pontikka", "Tarjoa pontikkaa", jalan and pontikka > 0, "ei pontikkaa" if jalan else "ei ajaessa"))
			o.append(_opt("janttu_viina", "Tarjoa Koskenkorvaa", jalan and viina_pullot > 0, "ei viinaa" if jalan else "ei ajaessa"))
		"poliisi":
			chat = false
			if _ratsia_stage == "puhallus":
				o.append(_opt("puhalla", "Puhalla", true, "", true))
				o.append(_opt("selitys", "Mää en oo juonu ku yhen", true, "", true))
			else:
				o.append(_opt("jatka", "Jatka matkaa", true, "", true))
		"mopopojat":
			_teini_myynti_valinnat(o)
			o.append(_opt("kisa", "Kiihdytys Tunturi-Janin kanssa (panos %s €)" % _eur(RACE_BET), money >= RACE_BET, "rahat ei riitä", true))
			o.append(_opt("kisa_iso", "Kiihdytys Pakoputki-Peteä vastaan (panos %s €, viritetty mopo)" % _eur(RACE_BET_BIG),
				money >= RACE_BET_BIG, "rahat ei riitä", true))
		"nuoret":
			_nuoret_new_day()
			_teini_myynti_valinnat(o)
			o.append(_opt("huikka", "Ota huikka kossu-vissystä", _nuoret_huikat < NUORET_HUIKAT, "pullo on tyhjä"))
			o.append(_opt("tarjoa", "Tarjoa kalja porukalle", beers > 0, "ei kaljaa mukana"))
			if _nuoret_yard:
				var uinti_aika := _between(clock_min, Vector2(12 * 60, 18 * 60))
				o.append(_opt("uinti", "Haasta nuoret uimakilpailuun Oulujoelle (ponkkarilta, päivällä, kerran päivässä)", uinti_aika and _uinti_day != day,
					"uimakisat pidetään iltapäivällä 12–18" if not uinti_aika else "uit jo tänään", true))
				var tappelu_ok: bool = _between(clock_min, Vector2(20 * 60, 24 * 60)) and _lava_tappelu_day != day and tilat.value("humala") >= 0.0
				o.append(_opt("jarkkari", "Haasta lavan järkkäri tappelemaan pihalle (kerran päivässä, illalla)", tappelu_ok,
					"järkkäri on töissä vasta illalla 20–24" if not _between(clock_min, Vector2(20 * 60, 24 * 60)) else "tapeltu jo tänään"))
				if _between(clock_min, Vector2(18 * 60, 23 * 60)):
					o.append(_opt("purkka", "Osta portailla istuville lapsille uutta purukumia (%s €)" % _eur(1.5), money >= 1.5 and _purkka_day != day,
						"lapset on jo ostettu onnellisiksi tänään" if _purkka_day == day else "rahat ei riitä"))
				if not _kasetti:
					o.append(_opt("kasetti_aanita", "Äänitä oma kasetti radiosta (tyhjä kasetti 1 €, 20 min)", money >= 1.0, "rahat ei riitä"))
				else:
					o.append(_opt("kasetti_soita", "Laita oma kasetti soimaan teinien soittimeen", _kasetti_day != day, "kasetti on jo soinut tänään", true))
				var letka_ok: bool = _between(clock_min, Vector2(23 * 60, 3 * 60)) and oma_mopo.running and oma_mopo.fuel >= 0.15 and _letka_day != day
				o.append(_opt("letka", "Lähde mopoletkaan Siitarin pihaan ja keskustaan (yöllä)", letka_ok,
					"letka kokoontuu vasta yöllä 23–03" if not _between(clock_min, Vector2(23 * 60, 3 * 60)) else ("tarvitset toimivan mopon ja bensaa" if not (oma_mopo.running and oma_mopo.fuel >= 0.15) else "ajoit jo tänään")))
			if _nuoret_yard and _between(clock_min, Vector2(18 * 60, 23 * 60)) and "korkki" in tilat.firsts:
				o.append(_opt("korkkilapsy", "Korkkiläpsyä teinien kanssa (panos 3 tuplaa)", korkit.tuplat() >= 3 and _lapsy_day != day,
					"läpsit jo tänään" if _lapsy_day == day else "tarvitset 3 tuplakorkkia", true))
			if _nuoret_yard and _between(clock_min, Vector2(6 * 60, 11 * 60)):
				o.append(_opt("pullot", "Kerää tyhjät pullot ja tölkit aidan takaa (pantti)", _pullot_day != day, "keräsit jo tänään", true))
			if _nuoret_yard:
				var why := "sulla on jo leima kädessä" if _lava_pass_now() == "lippu" else ("teini ei anna enää" if _leima_day == day else "")
				o.append(_opt("leima", "Kopioi tuore leima teinin kädestä", why == "", why, true))
		"kauppa_auto":
			for k in KauppaAuto.MENU:
				var m: Array = KauppaAuto.MENU[k]
				var has: bool = {"makkara": has_sausage, "tikut": has_matches, "sokeri": has_sugar, "turbohiiva": has_turbo}.get(k, false)
				var why := "on jo mukana" if has else ("rahat ei riitä" if money < m[1] else "")
				o.append(_opt("auto_" + k, "%s (%s €)" % [m[0], _eur(m[1])], why == "", why))
		"vastaanotto":
			o.append(_opt("huone", "Saisiko huoneen yöksi?"))
			o.append(_opt("valita", "Huoneesta 12 kuuluu kauhea meteli"))
		"dingo":
			o.append(_opt("nimmari", "Pyydä nimikirjoitus", _dingo_nimmari_day != day, "jo pyydetty tänään", true))
			o.append(_opt("huikka", "Ota huikka bändin Koskenkorvasta", _dingo_huikat < DINGO_HUIKAT, "pullo on tyhjä"))
			o.append(_opt("telkkari", "Auta heittämään telkkari ikkunasta", _dingo_tv_day != day, "telkkari on jo pihalla"))
		"tyokkari":
			o.append(_opt("jonota", "Jonota virkailijalle (puoli tuntia)", _tyokkari_day != day, "kävit jo tänään", true))
			var duuni_aika := _between(clock_min, Vector2(8 * 60, 12 * 60))
			o.append(_opt("kesaduuni", "Kesäduuni voimayhtiöllä: rantojen siivous (4 h, 28 €)", duuni_aika and _kesaduuni_day != day,
				"hommia jaetaan aamulla 8–12" if not duuni_aika else "teit jo päivän työn", true))
		"apteekki":
			for id in APTEEKKI_MENU:
				var am: Array = APTEEKKI_MENU[id]
				var no_rx: bool = am[2] and reseptit <= 0
				o.append(_opt("osta_" + id, "%s (%s €)" % [am[0], _eur(am[1])], money >= am[1] and not no_rx, "ei reseptiä" if no_rx else "rahat ei riitä"))
		"apteekki_taka", "apteekki_hoitaja":
			for id in APTEEKKI_TAKA:
				var price: float = APTEEKKI_MENU[id][1] * APTEEKKI_TAKA_MULT
				o.append(_opt("osta_" + id, "%s (%s €)" % [APTEEKKI_MENU[id][0].trim_suffix(" ▲"), _eur(price)], money >= price, "rahat ei riitä"))
		"zabuki":
			for id in ZABUKI_MENU:
				var m: Array = ZABUKI_MENU[id]
				o.append(_opt("osta_" + id, "%s (%s €)" % [m[0], _eur(m[1])], money >= m[1], "rahat ei riitä"))
			var open_eve := _between(clock_min, Vector2(18 * 60, 23 * 60))
			o.append(_opt("hengaile", "Hengaile kioskin edessä (tunti, vain illalla)", open_eve and _hengailu_day != day,
				"kioskilla hengaillaan vasta illalla 18–23" if not open_eve else "hengailit jo tänään"))
		"gasthaus":
			for id in GASTHAUS_MENU:
				var gm: Array = GASTHAUS_MENU[id]
				o.append(_opt("ruoka_" + id, "%s (%s €)" % [gm[0], _eur(gm[1])], money >= gm[1], "rahat ei riitä"))
			o.append(_opt("yo", "Huone yöksi (%s €, päivä päättyy)" % _eur(GASTHAUS_PRICE), money >= GASTHAUS_PRICE,
				"rahat ei riitä", true))
		"siitari_sinikka":
			o.append(_opt("tanssi", "Tanssitaanko?"))
			var price: float = SIITARI_MENU.lonkero[1]
			o.append(_opt("drinkki", "Tarjoa lonkero (%s €)" % _eur(price), money >= price, "rahat ei riitä"))
		"kauppias":
			chat = false
			if not interior.has_paid and interior.at_till:
				var total: float = interior.till_total()
				o.append(_opt("maksa", "Maksa %s €" % _eur(total), interior.can_pay(),
					"%s € puuttuu" % _eur(total - interior.money)))
				if not interior.can_pay() and interior.own_items():
					o.append(_opt("jata", "Jätä omat ostokset tiskille"))
			o.append(_opt("neuvo", "Mistä löytyy mitäkin?"))
	if who == "mirkku" and has_flowers:
		var ilta := _between(clock_min, MIRKKU_EVENING)
		o.append(_opt("kukat_mirkulle", "Anna kukkakimppu Mirkulle", ilta, "vasta illalla (17–23), Päivi odottaa kimppua", true))
	if who.begins_with("kolmio_"):
		_kolmio_options(who, o)
	if who in HS_TALKERS:
		_hs_options(who, o)
	for r in rikos:
		r.options(who, o)
		if who in r.talkers:
			chat = false  # osan omalla puhujalla ei pelin yleistä "Mitä kuuluu?" -riviä
	if who == "kauppias":
		_kolmio_gift_option(o)
	_mopo_options(who, o)  # oma mopo (#155): Seppo, Huhtala, Simo, Aaro, SEO ja katsastus
	if chat:
		o.append(_opt("juttu", "Mitä kuuluu?"))
	if who != "poliisi" and not (who == "roivainen" and _tutka_stage in ["pysaytys", "tulos"]):  # ratsiasta ja tutkasta ei kävellä pois kesken
		o.append(_opt("lopeta", "Lopeta"))
	return o


func _talk_choose(id: String) -> void:
	if id == "lopeta":
		_talk_box.close()
		return
	for r in rikos:
		if r.choose(id):
			return
	if id.begins_with("mopo_"):
		_mopo_choose(id)
		return
	if id.begins_with("kanttori_"):
		_talk_kanttori(id)
		return
	if id.begins_with("lemmikki_"):
		_talk_lemmikki(id)
		return
	if id.begins_with("kolmio_"):
		_kolmio_choose(id)
		return
	if id.begins_with("paivi_kesa_"):
		_kesaheila_choose(id)
		return
	if id in ["isanta_sato", "isanta_heina", "isanta_kylvo"]:
		var sk := _farm_by_talker(_talk_who)
		_talk_box.close()
		if sk != null:
			_farm_legend(sk, id.substr(7))
		return
	if id.begins_with("isanta_"):
		var fk := _farm_by_talker(_talk_who)
		if fk != null:
			var line: String = fk.talk_choose(id.substr(7))
			_talk_box.reply(line, _talk_options(), fk.talk_info())
		return
	if _talk_who == "kaukalo_teinit" and id == "korkkilapsy":
		_talk_box.close()
		_start_korkkilapsy_kaukalo()
		return
	if _talk_who in HS_TALKERS and (id.begins_with("myy_") or id == "haasta"):
		_hs_choose(id)
		return
	if id.begins_with("ranta_"):
		_ranta_choose(id)
		return
	if id == "juttu":
		var line := _talk_chat_line()
		var heard := _note_places(line)
		_talk_box.reply(line, _talk_options(), ("Kartalle kynällä: %s" % heard) if heard != "" else _talk_chat_info())
		return
	match _talk_who:
		"arto", "pekka", "sinikka":
			_talk_neighbor(id)
		"santtu":
			var r := _on_santtu_menu(id)
			_talk_box.reply(r[0], _talk_options(), r[1])
		"kalle":
			_talk_kalle(id)
		"mirkku":
			if id == "kukat_mirkulle":
				has_flowers = false
				_talk_box.close()
				_show_message("Mirkku: \"Mulleko? Voi että... Mulla on teltta pystyssä laavulla. Tuu, sytytetään nuotio.\"", 3.5)
				_win_mirkku()
		"sulo":
			if id == "tilikirja":
				_tokola_sulo_deal()
				return
			if id == "pannu":
				_pannu_to_sulo()
				return
			if id == "sulo_kaasu":
				_sulo_kaasu()
				return
			_kanister_paid = 0.0 if _sulo_free else _kanister_price()
			_sulo_free = false
			money -= _kanister_paid
			has_kanister = true
			tilat.first("pontikka", 0.5)
			_sulo_sold = true
			walker_out.set_kanister(true)
			Sfx.play("coin", -4.0)
			_talk_box.reply("Tässä. Ja suu suppuun. Ja kanisteri takasin, kun on tyhjä.", _talk_options(),
				"Pontikkakanisteri mukana, vastaa %d kaljaa! Vie se kotiin jemmaan." % _kanister_beers())
		"pojat":
			_talk_pojat(id)
		"taksi":
			if id.begins_with("hanhikivi_"):
				_talk_hanhikivi(id)
				return
			if id == "pakkahuone_kerro":
				_talk_pakkahuone(id)
				return
			if id == "peruskivi_kerro":
				_talk_peruskivi(id)
				return
			if id == "manamansalo_kerro":
				_talk_manamansalo(id)
				return
			if id == "matkaopas":
				_talk_matkaopas()
				return
			_talk_box.close()
			_on_taxi_choice(id)
		"leirintaalue":
			_talk_leirintaalue(id)
		"raahe", "siitari":
			var r: Array = _on_raahe(id.trim_prefix("juo_")) if _talk_who == "raahe" else _on_siitari(id.trim_prefix("juo_"))
			_talk_box.reply(r[0], _talk_options(), r[1] + "   Rahaa %s €." % _eur(money))
		"visa":
			_quiz_answer(int(id.trim_prefix("visa_")))
		"hilkka", "raili", "tauno", "huutaja", "annaliisa", "sinikka_seura":
			_talk_kirppis(id)
		"hoitaja", "suntio", "kynttilanainen":
			if id.begins_with("kuningas_"):
				_talk_kuningas(id)
			else:
				_talk_pyhimys(id)
		"olavi_pappa":
			_talk_olavi(id)
		"aaro":
			if id == "pyhimys_aitta":
				_talk_pyhimys(id)
			else:
				_talk_aaro(id)
		"korkkiraimo":
			_talk_korkkiraimo(id)
		"veksi":
			if id == "korkkilaatikko":
				money -= KORKKI_LAATIKKO
				Sfx.play("rattle", -8.0, 1.6)
				var mita := _korkit_kasa(1)
				if "mmkorkki_legenda" in tilat.firsts and not "mmkorkki_lappu" in tilat.firsts:
					tilat.first("mmkorkki_lappu", 0.1)
					mita += ". Pohjalla Raimon lappu: \"Kultainen MM-korkki -95. Pekka joi. KYSY PEKALTA.\""
				_talk_box.reply(["Korkkeja? Ota vaan, kymmenen senttiä kappale. Kultaisia ei oo, kysyin jo.",
					"Tuolla laatikossa on puoli Pohjois-Suomea. Kaiva syvältä.", "Joku vanha keräilijä toi ne. Korkki-Raimo, taisi olla."].pick_random(),
					_talk_options(), "Laatikosta: %s. Rahaa %s €." % [mita, _eur(money)])
			elif id == "olavi_myy":
				_olavi_sell()
			elif id == "kirves":
				_kertun_sell()
			elif id == "hopeat":
				_aarni_sell()
			elif id == "ukko_myy":
				_ukko_sell()
			elif id == "kekkonen":
				_kekkonen = 2
				money += KEKKONEN_HINTA
				_kertun_sync()
				Sfx.play("coin", -4.0)
				_save_game()
				_talk_box.reply("Kekkonen! Aito, 1960-luvulta. Kolkytä euroa, ja Sepolle ei sanota mitään.", _talk_options(),
					"+%s €." % _eur(KEKKONEN_HINTA))
		"seo", "aplus", "katsastaja", "hitsari":
			_pohjoiset_choose(id)
		"seppo", "saasto":
			_seppo_choose(id)
		"korpela", "simo", "heiskanen", "huhtala":
			_korjaamo_choose(id)
		"rauniot_nuoret":
			if id == "tarjoa":
				_today.append("rauniot_kalja")
				beers -= 1
				player.set_carrying(beers > 0)
				tilat.add("moraali", 0.15)
				tilat.first("rauniot_nuotio", 0.2)
				Sfx.play("glass", -6.0)
				_save_game()
				_talk_box.reply("No nyt! Sää oot ihan ok. Kuule, Jere löys kerran uunin raunioista vanhan valokuvan. Pelkäs ja pani "
					+ "takasin. Sano että talossa kummittelee. Hah.", _talk_options(), "Uunin raunioissa kivijalan nurkassa on jotain.")
		"vahtimestari":
			if id == "keikka":
				_hongan_start_keikka()
		"reippari":
			_talk_reippari(id)
		"siitari_sinikka":
			if id == "tanssi":
				_talk_box.close()
				_on_siitari("sinikka_tanssi")
			else:
				var r := _on_siitari("sinikka_drinkki")
				_talk_box.reply(r[0], _talk_options(), r[1])
		"kauppias":
			_talk_kauppias(id)
		"roivainen":
			if id == "jatka":
				_tutka_stage = "done"
				_talk_box.close()
			else:
				var r := _tutka_result(id == "sakko_selitys")
				_talk_box.reply(r[0], _talk_options(), r[1])
		"janttu":
			var r := _talk_janttu(id)
			_talk_box.reply(r[0], _talk_options(), r[1])
		"poliisi":
			if id == "jatka":
				_talk_box.close()  # _talk_end päästää matkaan (_ratsia_release)
			else:
				var r := _ratsia_blow(id == "selitys")
				_talk_box.reply(r[0], _talk_options(), r[1])
		"mopopojat":
			if id.begins_with("myy_"):
				_teini_myy(id.trim_prefix("myy_"))
				return
			_talk_box.close()
			_start_race(RACE_BET_BIG if id == "kisa_iso" else RACE_BET, id == "kisa_iso")
		"nuoret":
			if id.begins_with("myy_"):
				_teini_myy(id.trim_prefix("myy_"))
				return
			if id == "leima":
				_talk_box.close()
				_start_rakaleima()
				return
			if id == "pullot":
				_pullonkeraus()
				return
			if id == "korkkilapsy":
				_talk_box.close()
				_start_korkkilapsy()
				return
			if id in ["purkka", "kasetti_aanita", "kasetti_soita", "letka"]:
				_nuoret_hupi(id)
				return
			if id == "jarkkari":
				_talk_box.close()
				_start_lava_tappelu()
				return
			if id == "uinti":
				_talk_box.close()
				_start_uinti()
				return
			var r := _on_nuoret(id)
			_talk_box.reply(r[0], _talk_options(), r[1])
		"kauppa_auto":
			_kauppa_auto_buy(id.trim_prefix("auto_"))
		"tyokkari":
			if id == "kesaduuni":
				_kesaduuni()
			else:
				_tyokkari_jonota()
		"vastaanotto", "dingo":
			_talk_hotel(id)
		"apteekki", "apteekki_taka":
			var ar := _on_apteekki(id.trim_prefix("osta_"), _talk_who == "apteekki_taka")
			_talk_box.reply(ar[0], _talk_options(), ar[1] + "   Rahaa %s €." % _eur(money))
		"apteekki_hoitaja":
			_hs_osta(id.trim_prefix("osta_"))
		"zabuki":
			if id == "hengaile":
				_hengaile_kioskilla()
				return
			var r := _on_zabuki(id.trim_prefix("osta_"))
			_talk_box.reply(r[0], _talk_options(), r[1] + "   Rahaa %s €." % _eur(money))
		"gasthaus":
			if id.begins_with("ruoka_"):
				var gm: Array = GASTHAUS_MENU[id.trim_prefix("ruoka_")]
				if money < gm[1]:
					_talk_box.reply("Ei riitä, kulta.", _talk_options(), "Rahaa %s €." % _eur(money))
					return
				money -= gm[1]
				_eat(1.0 - tilat.value("nalka"))
				tilat.add("stressi", gm[2])
				tilat.add("moraali", gm[3])
				Sfx.play("pickup", -6.0, 0.6)
				_talk_box.reply("Emäntä: \"Hyvää ruokahalua.\"", _talk_options(),
					"%s, −%s €. Nälkä lähti. Rahaa %s €." % [gm[0], _eur(gm[1]), _eur(money)])
				return
			_talk_box.close()
			_gasthaus_sleep()


func _talk_neighbor(id: String) -> void:
	if id == "mmkorkki_kysy":
		tilat.first("mmkorkki_pekka", 0.2)
		_talk_box.reply("Perkele, se Raimo vieläkin siitä. Joo, mää join sen. Saunan jälkeen istuttiin tossa päädyssä, ja mää " +
			"heitin korkin olan yli kivikkoon. Kultanen se oli, ja nyt se on varmaan ruostunu. Kato talon päädystä, jos huvittaa.",
			_talk_options())
		return
	match id:
		"myy":
			var sale := _goods_value(_talk_who)
			money += sale
			tilat.add("moraali", 0.1)
			var sold := {}
			for k in bucket.keys():
				if GOODS[k].buyer == _talk_who:
					sold[k] = bucket[k]
					bucket.erase(k)
			Sfx.play("register", -4.0)
			var line := "Kiitti! Tästä tulee hyvää puuroa." if _talk_who == "arto" else \
				"No perkele, hyviä sieniä! Näistä tulee saatanan hyvä kastike kyyhkyille."
			var was_done: bool = story.done.puolukat
			var note := _story_sold(_talk_who, sold)
			if _talk_who == "arto" and story.done.puolukat and not was_done:
				line = "Nyt riittää hilloon! Pekka on kyllä koko kesän puhunu siitä Paapelista."
			_talk_box.reply(line, _talk_options(), "+%s €%s" % [_eur(sale), "   ·   " + note if note != "" else ""])
		"laatikko":
			laatikko.give()
			tilat.first("pekan_laatikko", 0.2)
			Sfx.play("pickup", -4.0)
			_save_game()
			_talk_box.say_lines(["Vintillä on laatikollinen romua. Levyjä, äijän pilkkipokaali, karvalakki ja vanha vieherasia.",
				"Ja se Itkevä poika -taulu, ei Päivi sitä ikinä huolinu. Vie kirppikselle, puolet mulle, perkele. Ja tilitä samana päivänä."],
				_talk_options(), "Pekan romulaatikko repussa (%d tavaraa): myy omalla kirppispöydällä, puolet Pekalle." % laatikko.count())
		"laatikko_tilita":
			var tili: Dictionary = laatikko.pay(day)
			money -= tili.amount
			Sfx.play("coin", -4.0)
			tilat.first("pekan_laatikko_tilitetty", 0.0)
			if tili.on_time:
				maine = clampf(maine + PekanLaatikko.ON_TIME_REP, 0.0, 100.0)
				tilat.add("moraali", 0.05)
				_talk_box.reply("Rehti mies, perkele! Seuraava kyyti mökille on mun piikkiin.", _talk_options(),
					"Pekalle %s €. Maine +%d, seuraava kyyti ilmainen." % [_eur(tili.amount), int(PekanLaatikko.ON_TIME_REP)])
			else:
				_talk_box.reply("No vihdoin. Kyllä mää jo ehdin miettiä, perkele. No, kyydit taas auki.", _talk_options(),
					"Pekalle %s €. Pekka leppyi, kyyti mökille taas auki." % _eur(tili.amount))
			_save_game()
		"akku":
			var need := EBIKE_AKKU_SIENET
			for k in ["kantarelli", "herkkutatti"]:
				var take := mini(need, bucket.get(k, 0))
				need -= take
				bucket[k] = bucket.get(k, 0) - take
				if bucket[k] <= 0:
					bucket.erase(k)
			ebike.parts["akku"] = true
			Sfx.play("pickup", -4.0)
			_save_game()
			_talk_box.reply("Makitan akut, perkele, ne kestää! Neljä kappaletta, kytke sarjaan. Sienet tänne.", _talk_options(),
				"Sähköpyörän akku mukana.%s" % _ebike_parts_note())
		"johdot":
			beers -= 1
			player.set_carrying(beers > 0)
			ebike.parts["johdot"] = true
			Sfx.play("pickup", -4.0)
			_save_game()
			_talk_box.reply("Autotallissa on laatikollinen johtoja ja liittimiä. Ota vaan, kalja kelpaa. Sähköpyörä? Kova jätkä.",
				_talk_options(), "Johdot ja liittimet mukana.%s" % _ebike_parts_note())
		"varaosa":
			money -= LAWN_PART_PRICE
			has_mower_part = true
			Sfx.play("register", -4.0)
			_save_game()
			_talk_box.reply("Vanhasta Husqvarnasta irtos. Kivikkoon ajoit, vai?", _talk_options(),
				"Varaosa mukana. Vielä kalja, niin leikkuri korjataan.")
		"paikat":
			world.forage_revealed = true
			_save_game()
			_talk_box.reply("Lähekkö puolukkaan? Merkkaan sulle karttaan parhaat paikat!", _talk_options(),
				"Arto merkitsi marja- ja sienipaikat karttaan (M).")
		"haava":
			if beers > 0:
				beers -= 1
				player.set_carrying(beers > 0)
			else:
				money -= PEKKA_CARE
			var big := wound_big
			_heal()
			Sfx.play("groan", -4.0, 1.2)
			_talk_box.reply("Karhu?! No nyt tarvitaan koko pullo." if big else "Ei tää oo mitään, kyyhkyt purree pahemmin.",
				_talk_options(), "Pekka sitoi haavan ja kaatoi päälle koskenkorvaa. Kirvelee!")
		"vaino":
			vaino.queue_free()
			vaino = null
			money += VAINO_MONEY
			var beer := beers < CARRY_FOOT
			if beer:
				beers += 1
				player.set_carrying(true)
			Sfx.play("win_small")
			_task_done(true)
			tilat.first("vaino", 0.5)
			_talk_box.reply("Hyvä poika! Siis Väinö. Tässä vitonen%s." % (" ja kalja" if beer else ""), _talk_options(),
				"Väinö kotona! Pekka antoi %s €%s." % [_eur(VAINO_MONEY), " ja kaljan" if beer else ""])
		"kyyti":
			_talk_box.close()
			pekka.say("Hyppää kyytiin perkele, lähetään!")
			_pekka_ride()
		"tarina":
			match story.step:
				"pekka_kutsuu":
					_story_step("tehtavat")
					_talk_box.say_lines(Story.PEKKA_TASKS, _talk_options(),
						"Uudet tehtävät repussa (R): sienet Pekalle, puolukat Artolle ja Sinikan nurmikko.")
				"pekka_avaimet":
					_story_step("avaimet")
					_talk_box.say_lines(Story.PEKKA_KEYS, _talk_options(), "Hae autonavaimet kodalta (lintutornin luota).")
				"avaimet":
					_talk_box.reply(["Avaimet on kodalla, lintutornin luona! Mää en pääse ilman autoa.",
						"Kodalla ne on, perkele. Laavulta polkua etelään."].pick_random(), _talk_options())
				"avaimet_mukana":
					_story_step("valmis")
					_talk_box.reply(Story.PEKKA_THANKS, _talk_options(), "Pekan kyyti Paapeliin on nyt auki!")
		"taimet":
			sinikka_taimet = 2
			_has_taimet = false
			food["pulla"] = food.get("pulla", 0) + 2
			tilat.add("moraali", 0.15)
			tilat.first("sinikka_taimet", 0.3)
			_rikos_event("paivi_hyvitys", {"why": "taimet"})
			Sfx.play("pickup", -4.0)
			_save_game()
			_talk_box.reply("Tomaatintaimet! Ja vielä niitä hyviä, säästöpihan omia. Ota pullaa, kaks kappaletta. Ja Päiville ei "
				+ "tarvi kertoa, että kävit täällä.", _talk_options(), "Kaksi korvapuustia reppuun.")
		"sormus":
			_sormus_given = true
			money += 20.0
			tilat.add("moraali", 0.2)
			tilat.first("sormus_sinikalle", 0.3)
			Sfx.play("win_small", -4.0)
			_save_game()
			_talk_box.reply("Mun sormus! Se lipes sormesta aamu-uinnilla viime kesänä. Voi kiitos... Tässä kakskymppiä. Ja älä kerro "
				+ "Päiville, että mää halasin sua.", _talk_options(), "+20 €. Sinikka on ikuisesti kiitollinen.")
		"mustikat":
			bucket["mustikka"] = int(bucket.get("mustikka", 0)) - SINIKKA_BERRIES
			if bucket["mustikka"] <= 0:
				bucket.erase("mustikka")
			_sinikka_piirakka_palkka()
			_talk_box.reply(SINIKKA_THANKS.pick_random(), _talk_options(), "Sait uunituoreen mustikkapiirakan (T syö).")
		"apu":
			sinikka_task = 1
			_save_game()
			_talk_box.reply(SINIKKA_ASK.pick_random(), _talk_options(),
				"Tehtävä: poimi metsästä %d l mustikoita ja vie ne Sinikalle." % SINIKKA_BERRIES)


