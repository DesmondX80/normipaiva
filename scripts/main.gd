func _on_vaala_shop_exited(bought: bool) -> void:
	interior.leave()
	interior.vaala = false
	_shop_vaala = false
	Sfx.play("door_close", -3.0)
	var got: Array[String] = []
	if interior.has_paid:
		has_sausage = has_sausage or interior.cart.has("makkara")
