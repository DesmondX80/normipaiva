func _restore_today() -> bool:
	var t := _saved_today
	_saved_today = {}
	var list: Array = t.get("kauppalista", [])
	if list.is_empty():
		return false
	shopping_list = list
	paivi_bag = t.get("kassi", {})
	paivi_placed = t.get("paikoillaan", {})
	_list_done = t.get("lista_valmis", false)
