func _mopo_virit_menu() -> void:
	if not oma_mopo.running:
		_show_message("Mopo ei ole vielä ajokunnossa: virittäminen vasta kun se käy.", 3.0)
		return
	var items: Array = []
	for k in OmaMopo.VIRIT:
		var v: Dictionary = OmaMopo.VIRIT[k]
		if oma_mopo.virit.has(k):
			continue
		items.append([k, "%s (+%.1f m/s) – %s €%s" % [v.name, v.bonus, _eur(v.price), "" if money >= v.price else " (rahat ei riitä)"]])
	if items.is_empty():
		_show_message("Mopo on viritetty täysin. Huippu %.1f m/s, ennätys %.1f m/s. Katsastus ei tykkää." % [oma_mopo.max_speed(), oma_mopo.top_best], 4.0)
		return
	items.append(["takaisin", "Takaisin"])
	var w := _active_walker()
	w.controls_enabled = false
	_interior_busy(true)
	_menu_mode = "virit"
	_item_menu.open(items, "Mopon viritys")


func _on_virit_menu(id: String) -> void:
	_interior_busy(false)
	_active_walker().controls_enabled = true
	_menu_mode = "give"
	if id == "takaisin" or not OmaMopo.VIRIT.has(id):
		return
	var v: Dictionary = OmaMopo.VIRIT[id]
	if money < v.price:
		_show_message("Osa maksaa %s €, rahat ei riitä." % _eur(v.price), 3.0)
		return
	money -= v.price
	oma_mopo.virit[id] = true
	_advance_clock(30.0)
	tilat.first("mopo_viritys", 0.3)
	tilat.add("moraali", 0.05)
	Sfx.play("rattle_hard", -4.0, 1.1)
	_save_game()
	_show_message("%s Huippunopeus nyt %.1f m/s." % [v.msg, oma_mopo.max_speed()], 5.0)


func _mopo_garage() -> void:
	if not oma_mopo.assembled:
		var miss: Array = oma_mopo.missing_run()
		if not miss.is_empty():
			_show_message("Hopeanuoli seisoo tallissa ilman: %s. Hae %s." % [", ".join(miss.map(func(k): return OmaMopo.PARTS[k].low)),
				", ".join(miss.map(func(k): return OmaMopo.PARTS[k].where))], 5.0)
			return
		oma_mopo.assembled = true
		oma_mopo.valo_on = oma_mopo.parts.has("valo")
		_advance_clock(60.0)
		tilat.first("mopo_koottu", 0.3)
		tilat.add("moraali", 0.1)
		Sfx.play("rattle_hard", -4.0, 0.9)
		_save_game()
		_show_message("Ketju paikalleen, sytytys kiinni ja satula päälle. Tunti meni, ja kolme ruuvia jäi yli. Ne on varmaan varaosia.", 5.0)
		return
	if oma_mopo.parts.has("valo") and not oma_mopo.valo_on:
		oma_mopo.valo_on = true
		Sfx.play("rattle", -4.0, 1.2)
		_save_game()
		_show_message("Ajovalo ja vilkut kiinni. Vilkut vilkkuu molemmat yhtä aikaa, mutta se on tyylikysymys.", 4.0)
		return
	if not oma_mopo.carb_ok:
		_start_carb(true)
		return
	if oma_mopo.fuel <= 0.05:
		if not oma_mopo.kanisteri:
			_show_message("Tankki kumisee tyhjyyttään. Seppo: \"Bensaa ei kuulu kauppaan.\" Kanisteri täyteen SEO:lta.", 4.0)
			return
		oma_mopo.kanisteri = false
		oma_mopo.fuel = 1.0
		Sfx.play("water", -6.0, 1.4)
		_save_game()
		_show_message("Glug glug. Kaksitahtiöljy sekaan silmämääräisesti. Päivi haistaa tämän eteisessä asti.", 4.0)
		return
	if not oma_mopo.running:
		_start_kick()
		return
	if not bike_in_garage:
		_show_message("Pyörä on pihalla. Tuo se ensin talliin: kaksi ajopeliä pihalla, ja Päivi alkaa laskea, paljonko ne maksoi.", 4.5)
		return
	oma_mopo.riding = true
	bike.set_mopo(true)
	garage_int.set_mopo(false)
	_on_garage_exited(true)
	_show_message("Hopeanuoli pärisee pihalle. Naapurin verhot heilahtaa.", 3.0)


func _mopo_rajoitin() -> void:
	if not oma_mopo.rajoitin_have:
		_show_message("Pakoputkessa lukee \"SEPPO 79\". Siihen aikaan rajoittimet oli suosituksia.", 3.0)
		return
	oma_mopo.rajoitin = not oma_mopo.rajoitin
	Sfx.play("rattle", -4.0, 1.1)
	_save_game()
	if oma_mopo.rajoitin:
		_show_message("Rajoitin paikallaan. Nyt Hopeanuoli kulkee juuri ja juuri pyörää lujempaa. Katsastusmies tykkää.", 4.0)
	else:
		_show_message("Rajoitin pois. Laki on laki, mutta Saloisten mäet on Saloisten mäet.", 3.5)


## Mopon kaasari säädetty (sama minipeli kuin SLN-73:lla, _start_carb).
func _mopo_carb_done(ok: bool) -> void:
	if ok:
		oma_mopo.carb_ok = true
		tilat.first("mopo_kaasari", 0.3)
		Sfx.play("win_small", -4.0)
		_save_game()
		_show_message("Kaasarista valui 70-luvun bensaa, joka oli muuttunut hilloksi. Nyt se on puhdas ja säädetty.", 4.5)
	else:
		_show_message("Kaasari jäi vielä vähän sinne päin. Huomenna uusiks.", 2.5)


## Potkukäynnistys (mopo_kick_game.gd).
func _start_kick() -> void:
	garage_int.busy = true
	garage_int.walker.controls_enabled = false
	_hud.visible = false
	var g := MopoKickGame.new()
	g.drunk = _hand_shake()
	g.mopo = garage_int._mopo  # pelataan tallin oikealla mopolla
	g.walker = garage_int.walker
	g.finished.connect(func(ok: bool) -> void:
		garage_int.busy = false
		garage_int.walker.controls_enabled = true
		garage_int.walker.activate()  # tallin kamera takaisin
		_hud.visible = true
		if ok:
			oma_mopo.running = true
			oma_mopo.fuel = maxf(0.0, oma_mopo.fuel - 0.02)
			garage_int.set_mopo(true, true)
			tilat.first("mopo_kaynnissa", 0.6)
			tilat.add("moraali", 0.2)
			maine = clampf(maine + 2.0, 0.0, 100.0)
			Sfx.play("win", -4.0)
			_save_game()
			_show_message("HOPEANUOLI KÄY! Talli on sininen kuin savusauna, ja Päivi lähti yskien sisälle. Maine +2.", 5.0)
		else:
			tilat.add("stressi", -0.05)
			_show_message("Mopo ei lähtenyt. Nilkka on hellä, mutta ylpeys vielä hellempi. Huomenna uusiks.", 3.5))
	garage_int.add_child(g)


## Mopon valinnat kylän ihmisillä (_talk_options lisää ne loppuun).
func _mopo_options(who: String, o: Array) -> void:
	var m := oma_mopo
	match who:
		"seppo":
			if _kekkonen == 1:
				o.append(_opt("mopo_kekkonen", "Näytä Kekkosen rintamerkki", true, "", true))
			if not m.owned:
				o.append(_opt("mopo_kysy", "Entäs se mopo pressun alla?"))
				if m.trust >= OmaMopo.TRUST_NEED and _seppo_day.get("mopo", -1) == day:
					var p: float = _mopo_price()
					o.append(_opt("mopo_osta", "Osta Hopeanuoli (%s €)" % _eur(p), money >= p - 0.001, "rahat ei riitä", true))
			elif not m.parts.has("satula"):
				o.append(_opt("mopo_satula", "Mopon satula (%s €)" % _eur(OmaMopo.SATULA_HINTA), money >= OmaMopo.SATULA_HINTA,
					"rahat ei riitä", true))
		"huhtala":
			if m.owned and not m.parts.has("ketju"):
				o.append(_opt("mopo_ketju", "Mopon ketju ja ratas romuista (%s)" % ("kalja" if beers > 0 else _eur(OmaMopo.KETJU_HINTA) + " €"),
					beers > 0 or money >= OmaMopo.KETJU_HINTA, "ei kaljaa eikä rahaa", true))
		"simo":
			if m.owned and not m.parts.has("sytytys"):
				o.append(_opt("mopo_sytytys", "Sytytyspuola ja tulppa mopoon (%s €)" % _eur(OmaMopo.SYTYTYS_HINTA),
					money >= OmaMopo.SYTYTYS_HINTA, "rahat ei riitä", true))
		"aaro":
			if m.owned and not m.parts.has("valo"):
				o.append(_opt("mopo_valo", "Reipparin taululla luki sähkömopon osista", true, "", true))
		"seo":
			var full: float = OmaMopo.TANK_L * OmaMopo.BENSA_L
			if m.owned and not m.kanisteri:
				o.append(_opt("mopo_kanisteri", "Bensaa kanisteriin mopolle (%s €)" % _eur(full), money >= full, "rahat ei riitä",
					m.fuel <= 0.05))
			if m.riding and is_instance_valid(bike) and bike.global_position.distance_to(world.seo_door) < 30.0:
				var need: float = snappedf((1.0 - m.fuel) * full, 0.1)
				o.append(_opt("mopo_tankkaa", "Tankkaa mopo (%s €)" % _eur(need), m.fuel < 0.98 and money >= need,
					"tankki täynnä" if m.fuel >= 0.98 else "rahat ei riitä", m.fuel < 0.3))
		"katsastaja":
			if m.running:
				var why := ""
				if m.katsastettu:
					why = "jo hyväksytty"  # maine +5 vain kerran, kuten sähköpyörällä
				elif not m.riding or not is_instance_valid(bike) or bike.global_position.distance_to(world.katsastus_door) > 18.0:
					why = "mopo pitää tuoda pihaan"
				elif money < KATSASTUS_HINTA:
					why = "rahat ei riitä"
				o.append(_opt("mopo_katsasta", "Katsasta mopo (%s €)%s" % [_eur(KATSASTUS_HINTA), "  ✔ hyväksytty" if m.katsastettu else ""],
					why == "", why, not m.katsastettu))


## Sepon mopohinta: perushinta mielialan ja päivän kehun mukaan (Kekkosen merkin jälkeen puolet).
func _mopo_price() -> float:
	return oma_mopo.price(float(_seppo_mood()[1]) * (_seppo_kehu if _seppo_day.get("kehu", -1) == day else 1.0))


func _mopo_choose(id: String) -> void:
	var m := oma_mopo
	match id:
		"mopo_kysy":
			if m.trust < OmaMopo.TRUST_NEED:
				var line: String = ["Mopo? Mikä mopo? Ei täällä mitään mopoa oo.",
					"Se on Hopeanuoli. Ajoin sillä Raahen Rantatorille vuonna 79. Kolme kertaa. Kerran perille asti. Ei oo myytävänä.",
					"No... ehkä. Mää en myy Hopeanuolta kenelle tahansa. Pitää tuntea ihminen. Ja ihmisen marjat."][mini(int(m.trust / 2.0), 2)]
				_talk_box.reply(line, _talk_options(), "Seppo ei vielä luota (%d / %d). Ostokset, marjat ja vanhat löydöt auttaa."
					% [m.trust, OmaMopo.TRUST_NEED])
				return
			_seppo_day["mopo"] = day
			_talk_box.reply(("...No. Sää oot käyny täällä niin monta kertaa, että sää oot melkein perhettä. Hopeanuoli on sun %s eurolla. "
				% _eur(_mopo_price())) + "Hinta riippuu siitä, miten mun selkä tänään jaksaa.", _talk_options(), _seppo_mood()[0] + ".")
		"mopo_osta":
			money -= _mopo_price()
			m.owned = true
			m.rajoitin_have = true
			m.trust += 1
			_mopo_tarp_sync()
			tilat.first("mopo_ostettu", 0.5)
			Sfx.play("register", -4.0)
			_save_game()
			_talk_box.reply("Kaupat on kaupat. Satula maksaa erikseen, koska se on muistoesine. Rajoitin on tässä laatikossa, mää "
				+ "irrotin sen 1979. Bensaa ei kuulu kauppaan. Ketjun ja rattaan löydät Huhtalan romuista, sytytyksen saa " \
				+ "Autosähkö-Simolta, ja Tokolan Aarolla on vanhan sähkömopon valot. Tuon Hopeanuolen illalla peräkärryllä teidän talliin.", _talk_options(),
				"Mopo talliin! Puuttuu ketju (Huhtala), sytytys (Autosähkö-Simo), satula (Seppo) ja ajovalo (Tokolan Aaro).")
		"mopo_satula":
			money -= OmaMopo.SATULA_HINTA
			m.parts["satula"] = true
			Sfx.play("register", -6.0)
			_save_game()
			_talk_box.reply("Satula. Tällä on istunu Raahen Rantatorilla yks jos toinenkin. Älä kysy enempää.", _talk_options(),
				"Mopon satula mukana.%s" % _mopo_parts_note())
		"mopo_kekkonen":
			_kekkonen = 3
			m.seppo_kekkonen = true
			m.trust = maxi(m.trust, OmaMopo.TRUST_NEED) + 2
			_kertun_sync()
			tilat.first("kekkonen_sepolle", 0.4)
			tilat.add("moraali", 0.15)
			Sfx.play("win_small", -4.0)
			_save_game()
			_talk_box.reply("Tää on... isävainaan merkki! Mää oon ettiny tätä kakskytä vuotta. Se oli siinä YLLÄTYSLAATIKOSSA? "
				+ "No voi perkele. ...Kuule. Jos sää joskus haluat sen mopon, puoleen hintaan.", _talk_options(),
				"Seppo liikuttui. Luottamus täynnä, ja Hopeanuoli puoleen hintaan.")
		"mopo_ketju":
			if beers > 0:
				beers -= 1
				player.set_carrying(beers > 0)
			else:
				money -= OmaMopo.KETJU_HINTA
			m.parts["ketju"] = true
			Sfx.play("rattle_hard", -4.0, 0.8)
			_save_game()
			_talk_box.reply("Ketju? Tuolla Datsunin alla on mopon ketju ja ratas. Se Datsun ei oo liikkunu sitten Kekkosen. "
				+ "Ketju on vähän ruosteessa, mutta niin on Huhtalakin.", _talk_options(), "Ketju ja ratas mukana.%s" % _mopo_parts_note())
		"mopo_sytytys":
			money -= OmaMopo.SYTYTYS_HINTA
			m.parts["sytytys"] = true
			Sfx.play("register", -6.0)
			_save_game()
			_talk_box.reply("Sytytyspuola ja tulppa seitkytluvun mopoon? Mulla on pakussa kaikkea, mitä ihminen ei tarvii. Tässä. "
				+ "Jos se ei syty, vika on kuskissa.", _talk_options(), "Sytytys mukana.%s" % _mopo_parts_note())
		"mopo_valo":
			m.parts["valo"] = true
			Sfx.play("pickup", -4.0)
			_save_game()
			_talk_box.reply("Ai se. Poika rakensi sähkömopon vuonna kasikaks. Akku painoi enemmän ku mopo, ja se kulki kakskytä metriä. "
				+ "Ajovalo ja vilkut toimi aina. Ota ne, ne on ainoot ehjät osat.", _talk_options(),
				"Ajovalo ja vilkut mukana (katsastukseen).%s" % _mopo_parts_note())
		"mopo_kanisteri":
			money -= OmaMopo.TANK_L * OmaMopo.BENSA_L
			m.kanisteri = true
			Sfx.play("register", -6.0)
			_save_game()
			_talk_box.reply("Kakskasi ja kaksitahtiöljy. Yks pullo per kanisteri. Tai silmämääräisesti, kuten kaikki muutkin.", _talk_options(),
				"Bensakanisteri talliin (mopon tankkiin tallissa).")
		"mopo_tankkaa":
			money -= snappedf((1.0 - m.fuel) * OmaMopo.TANK_L * OmaMopo.BENSA_L, 0.1)
			m.fuel = 1.0
			Sfx.play("register", -6.0)
			_save_game()
			_talk_box.reply("Hopeanuoli! Mun isä ajo tommosella kirkkoon. Kerran. Sitten se ajo kirkon aitaan.", _talk_options(), "Tankki täynnä.")
		"mopo_katsasta":
			_katsasta_mopo()


func _mopo_parts_note() -> String:
	var miss: Array = OmaMopo.PARTS.keys().filter(func(k): return not oma_mopo.parts.has(k))
	if miss.is_empty():
		return "   ·   Kaikki mopon osat koossa: autotalliin!"
	return "   ·   Mopolta puuttuu: %s" % ", ".join(miss.map(func(k): return OmaMopo.PARTS[k].low))


## Mopon katsastus: ajovalo, rajoitin ja bensa. Hyväksytty mopo saa leiman ja mainetta.
func _katsasta_mopo() -> void:
	money -= KATSASTUS_HINTA
	var faults: Array = oma_mopo.faults()
	tilat.first("katsastus", 0.2)
	Sfx.play("register", -6.0)
	if faults.is_empty():
		oma_mopo.katsastettu = true
		maine = clampf(maine + 5.0, 0.0, 100.0)
		tilat.first("mopo_katsastettu", 0.5)
		_save_game()
		_talk_box.reply("Hmm. Valot palaa, rajoitin paikallaan, jarrut... jarruttaa. HYVÄKSYTTY. Ja kuule: jos se rajoitin sattuu "
			+ "joskus irtoamaan, mää en oo nähny mitään.", _talk_options(), "HYVÄKSYTTY! Leima mopon kilpeen. Maine +5.")
	else:
		_save_game()
		var f0: String = faults[0]
		_talk_box.reply("%s. HYLÄTTY.%s Korjaa ja tuo uudestaan." % [f0.left(1).to_upper() + f0.substr(1),
			(" Lisäksi " + ", ".join(faults.slice(1)) + ".") if faults.size() > 1 else ""], _talk_options(),
			"Hylkäyslista: %s." % ", ".join(faults))


## Pressu mopoineen Sepon pihalta pois, kun mopo on ostettu.
func _mopo_tarp_sync() -> void:
	if world != null and world.seppo_tarp_node != null:
		world.seppo_tarp_node.visible = not oma_mopo.owned


## Sähköpyörä autotallin työpöydällä (pyörä tallissa): kasaus, kun osat on koossa, ja korjaus, jos liitos on irti
## tai johdoissa oikosulku. false = ei kasattavaa (tavallinen huolto, viestiin _ebike_bench_note()).
func _ebike_bench() -> bool:
	var todo: Array = ebike.todo()
	if todo.is_empty() or (not ebike.built() and not ebike.has_all_parts()):
		return false
	_start_ebike_game(todo)
	return true


## Huollon viestin perään: ensimmäisellä kerralla sähköpyörän idea (ja työkalutaulun teippi ja ruuvit), sitten
## puuttuvat osat, kunnes pyörä on kasattu.
func _ebike_bench_note() -> String:
	if ebike.built():
		return ""
	if not ebike.started or not ebike.board_taken:
		ebike.started = true
		ebike.board_taken = true
		ebike.supplies.teippi += 1
		ebike.supplies.ruuvit += 2
		Sfx.play("pickup", -6.0)
		_save_game()
		return "\nTästähän sais sähköpyörän! Osat sieltä täältä: napamoottori, akku, ohjain ja johdot. Pekalla oli vanhoja " \
			+ "porakoneen akkuja, ja Seppo tietää kylän romut. Työkalutaululta puolikas rulla jeesusteippiä ja purkki ruuveja. " \
			+ "Osalista repussa (R)."
	var miss := PackedStringArray()
	for k in ebike.missing_parts():
		miss.append(EBike.PARTS[k].low)
	return "\nSähköpyörästä puuttuu vielä: %s." % ", ".join(miss)


func _start_ebike_game(todo: Array) -> void:
	garage_int.busy = true
	garage_int.walker.controls_enabled = false
	_hud.visible = false
	CamCtl.free_mouse = true
	var g := EBikeGame.new()
	g.todo = todo
	g.supplies = ebike.supplies.duplicate()
	g.drunk = _hand_shake()
	g.finished.connect(func(results: Dictionary) -> void:
		CamCtl.free_mouse = false
		garage_int.busy = false
		garage_int.walker.controls_enabled = true
		_hud.visible = true
		for k in g.used:
			ebike.supplies[k] = maxi(0, ebike.supplies[k] - g.used[k])
		var was_built: bool = ebike.built()
		for j in results:
			ebike.fasten(j, results[j])
		bike.set_ebike({"joints": ebike.joints, "loose": ebike.loose})
		_save_game()
		if ebike.built() and not was_built:
			tilat.first("sahkopyora", 0.5)
			_ending("sahkopyora")
			tilat.add("moraali", 0.3)
			Sfx.play("win_small", -4.0)
			_show_message("SÄHKÖPYÖRÄ VALMIS! Ruuveilla, teipillä ja toivolla. Akku %d %%. Kaasu pohjaan ja Saloisten teille!" % roundi(ebike.battery * 100.0), 5.0)
		elif ebike.todo().is_empty():
			Sfx.play("win_small", -6.0)
			_show_message("Sähköpyörä korjattu. Avustus toimii taas.", 3.0)
		elif not results.is_empty():
			_show_message("Liitoksia tehty %d. Jäljellä: %s." % [results.size(), ", ".join(ebike.todo().map(func(j): return EBike.JOINT_SHORT[j]))], 3.5))
	add_child(g)


## Kaupan rautahyllyn tarvikkeet ostoskassista sähköpyörän tarvikkeiksi (kassalla maksetut).
func _ebike_cart(cart: Dictionary) -> void:
	for k in ShopInterior.TARVIKE:
		if cart.has(k):
			ebike.supplies[k] += ShopInterior.TARVIKE[k][2]
			ebike.started = true


func _ebike_parts_note() -> String:
	var miss: Array = ebike.missing_parts()
	if miss.is_empty():
		return "   ·   Kaikki osat koossa! Pyörä talliin ja työpöydälle."
	return "   ·   Puuttuu: %s" % ", ".join(miss.map(func(k): return EBike.PARTS[k].low))


## Sähköpyörän ajo: avustus, akku, irtoavat liitokset ja oikosulku pelaajan ajaessa; tallissa akku latautuu.
## Osat näkyvät pyörässä aina (parkissakin).
func _ebike_tick(delta: float) -> void:
	if bike_in_garage:
		ebike.charge(delta)
	if oma_mopo.riding:  # oma mopo: bensa kuluu, sähköpyörän osat odottavat tallissa
		bike.assist = 0.0
		bike.heavy = false
		if player == bike and not bike.autopilot and not bike.car:  # kaapatulla autolla mopon tankki ei kulu
			var mmsg: String = oma_mopo.ride_tick(bike, delta)
			if mmsg != "":
				_show_message(mmsg, 4.0)
				_save_game()
		return
	if player == bike and not bike.autopilot:
		var msg: String = ebike.ride_tick(bike, delta)
		if msg != "":
			Sfx.play("rattle_hard", -2.0, 0.9)
			_show_message(msg, 3.5)
			_save_game()
	else:
		bike.assist = 0.0
		bike.set_ebike({"joints": ebike.joints, "loose": ebike.loose} if ebike.built() else {})


## Jalan pyörän vieressä: irronnut liitos teipataan takaisin repun jeesusteipillä.
func _ebike_logic() -> void:
	if _hint.text != "" or player != walker_out or not ebike.built() or bike_in_garage or oma_mopo.riding:
		return
	if ebike.loose.is_empty() and not ebike.shorted:
		return
	var bp := bike.global_position
	var p := player.global_position
	if Vector2(p.x - bp.x, p.z - bp.z).length() > 2.2:
		return
	if ebike.loose.is_empty():
		_hint.text = "Johdoissa oikosulku. Sähköteippiä ja korjaus autotallin työpöydällä, tai Autosähkö-Simolle."
		return
	var j: String = ebike.loose.keys()[0]
	if ebike.supplies.teippi <= 0:
		_hint.text = "%s on irti. Jeesusteippiä K-Marketin rautahyllystä." % EBike.JOINT_SHORT[j].capitalize()
		return
	_hint.text = "[E] Teippaa %s takaisin (jeesusteippiä %d)" % [EBike.JOINT_SHORT[j], ebike.supplies.teippi]
	if Input.is_action_just_pressed("interact"):
		ebike.tape_loose()
		Sfx.play("whoosh", -8.0, 1.6)
		bike.set_ebike({"joints": ebike.joints, "loose": ebike.loose})
		_save_game()
		_show_message(["Jeesusteippi korjaa kaiken. Melkein.", "Kolme kierrosta teippiä ja homma pelittää.",
			"Pekka sanois: teippi riittää, perkele."].pick_random(), 2.5)


## --- Saloisten seuraintalo: kirpputori ja huutokauppa (#114) ---------------------------------------------------
## Auki klo 10–18. Myyjät tinkivät: tarjous voi mennä läpi (maine auttaa), muuten vastatarjous, ja liika tinkiminen
## suututtaa myyjän loppupäiväksi. Tavarat uusiutuvat päivittäin. Huutokauppa kerran päivässä: napamoottori, kunnes
## se on ostettu, sitten muuta rihkamaa.
const KIRPPIS_OPEN := Vector2(10 * 60, 18 * 60)
const KIRPPIS_STOCK := {
	"ruuvipurkki": {"seller": "tauno", "name": "Ruuvipurkki", "price": 3.0},
	"rautalanka": {"seller": "tauno", "name": "Rautalankakerä", "price": 2.5},
	"teippi": {"seller": "tauno", "name": "Puolikas jeesusteippi", "price": 1.5},
	"liina": {"seller": "hilkka", "name": "Virkkuuliina", "price": 5.0},
	"vhs": {"seller": "raili", "name": "VHS: Uuno Turhapuro", "price": 2.0},
	"koira": {"seller": "raili", "name": "Posliinikoira", "price": 6.0},
	"virveli": {"seller": "tauno", "name": "Virveli ja lusikkauistin", "price": 15.0},
	"bambuonki": {"seller": "raili", "name": "Bambuonki", "price": 4.0},
	"lusikka": {"seller": "tauno", "name": "Isän kuparilusikka", "price": UkkoLegenda.LUSIKKA_HINTA},
	"drakkar": {"seller": "raili", "name": "Drakkar Noir, puolillaan", "price": 12.0},
	"haalari": {"seller": "raili", "name": "Neonpinkki hiihtohaalari", "price": 6.0},
	"slabarit": {"seller": "raili", "name": "90-luvun släbärit", "price": 3.0},
	"terva": {"seller": "tauno", "name": "Tervatuoppi (Olavinmarkkinat)", "price": 4.0},
	"voi": {"seller": "hilkka", "name": "Talonpojan voita (Olavinmarkkinat)", "price": 3.0},
	"makkara": {"seller": "raili", "name": "Markkinamakkara (Olavinmarkkinat)", "price": 3.5},
}
## Drakkar Noir: ysärin legendaarinen tuoksu Railin pöydältä (ensimmäinen löytö legendaarinen hetki; uusi pullo tulee
## pöydälle, kun edellinen on loppu). Pullossa DRAKKAR_SPRAYS
## suihkausta, suihkaus T-valikosta. Tuoksu kestää päivän: moraali ja mielihyvä nousevat, Sinikka ja Päivi huomaavat,
## ja tansseissa (seuraintalo, lava) tulos paranee DRAKKAR_DANCE.
const DRAKKAR_SPRAYS := 10
const DRAKKAR_DANCE := 0.15
var drakkar := 0  # suihkauksia jäljellä
var drakkar_found := false
var has_haalari := false  # kirppikseltä ostettu hiihtohaalari kodin vaatekaapissa (Looks.OUTFITS "hiihtohaalari")
var has_slabarit := false  # kirppikseltä ostetut släbärit (ja Päivin villasukat) kodin vaatekaapissa (Looks.feet)
var has_liivi := false  # Pentin nahkaliivi kodin vaatekaapissa (Looks.OUTFITS "nahkaliivi"), Pentin kiertueen jälkeen
var has_koppa := false  # Karhu-kutosen pahvikoppa hattuna (Looks.hat "koppa"), ensimmäisestä kaupasta ostetusta kutosesta
var drakkar_day := -1  # päivä, jona tuoksuu
var _kirppis_prev := "ulkona"
var _kirppis_sold := {}  # tuote -> päivä, jolloin ostettu
var _kirppis_angry := {}  # myyjä -> päivä, jolloin suuttui tinkimisestä
var _haggle := {}  # tuote -> {"ask", "patience", "day"}
var _auction_day := -1
var _myynti_day := -1  # päivä, jona oma pöytäpaikka on vuokrattu (#128)
var _myynti_ban := -1  # Hilkan myyntikielto: pöytäpaikkaa ei vuokrata ennen tätä päivää


func _kirppis_logic() -> void:
	if _hint.text != "" or world.kirppis_door == Vector3.ZERO:
		return
	var p := player.global_position
	if Vector2(p.x - world.kirppis_door.x, p.z - world.kirppis_door.z).length() > 3.0:
		return
	if player == bike:
		_hint.text = "[F] Pyörältä pois, niin pääset seuraintaloon"
		return
	var mode := _seura_mode()
	var e: bool = Input.is_action_just_pressed("interact") and not player.is_stunned()
	match mode:
		"kirppis":
			_hint.text = "[E] Seuraintaloon: kirpputori ja huutokauppa"
		"bingo":
			_hint.text = "[E] Seuraintaloon: BINGO (lappu 2 € sisällä)"
		"tanssit":
			if _tanssi_paid_day == day:
				_hint.text = "[E] Tansseihin (lippu maksettu)"
			elif money < TANSSI_LIPPU:
				_hint.text = "Tanssit! Lippu %s €, rahat ei riitä." % _eur(TANSSI_LIPPU)
				return
			else:
				_hint.text = "[E] Tansseihin: Saloisten Saapasjalat (lippu %s €)" % _eur(TANSSI_LIPPU)
				if e:
					money -= TANSSI_LIPPU
					_tanssi_paid_day = day
					Sfx.play("coin", -6.0)
		_:
			_hint.text = "Seuraintalo on kiinni. Kirppis joka päivä 10–18 · bingo ti 18–20 · tanssit la 21–01."
			return
	if e:
		_enter_kirppis(mode)


## Seuraintalon tilaisuus kellon ja viikonpäivän mukaan: "kirppis" 10–18, "bingo" tiistaina 18–20, "tanssit"
## lauantaina 21–01 (yli puolenyön sama päivä, koska päivä vaihtuu vasta nukkuessa); "" = kiinni.
func _seura_mode() -> String:
	if _between(clock_min, KIRPPIS_OPEN):
		return "kirppis"
	var wd := _weekday()
	if wd == 1 and _between(clock_min, BINGO_OPEN):
		return "bingo"
	if wd == 5 and _between(clock_min, TANSSI_OPEN):
		return "tanssit"
	return ""


## Viikonpäivä: päivä 1 on maanantai (0 = ma … 6 = su).
func _weekday() -> int:
	return (day - 1) % 7


func _enter_kirppis(mode := "kirppis") -> void:
	_kirppis_prev = state
	player.controls_enabled = false
	player.speed = 0.0
	_hazards.set_deferred("process_mode", Node.PROCESS_MODE_DISABLED)
	state = "in_kirppis"
	Sfx.play("door", -3.0)
	tilat.first("kirppis", 0.2)
	if _markkinat_paiva() and mode == "kirppis" and _once_today("markkinat_avaus"):
		_show_message("OLAVINMARKKINAT! Olavi-pappa avaa markkinat: kojuilla tervaa, voita ja makkaraa, huutokauppa lavalla.", 5.0)
	kirppis_int.lot_visible = _auction_lot().get("id", "") == "moottori"
	kirppis_int.auction_done = _auction_day == day
	kirppis_int.drakkar.visible = drakkar <= 0
	kirppis_int.haalari.visible = not has_haalari
	kirppis_int.slabarit.visible = not has_slabarit
	kirppis_int.weekday = _weekday()  # Korkki-Raimo vain lauantaisin
	kirppis_int.enter(mode)
	if Looks.outfit == "hiihtohaalari" and mode != "bingo" and _once_today("haalari_seura"):
		kirppis_int.say_id("annaliisa", ["Voi taivas, onko se hiihtokeli sisällä? Hahhah!",
			"Pinkki haalari keskellä kesää! Nyt mää kerron kaikille.", "Hahhah! Lähdeksää Leville vai seuraintaloon?"].pick_random(), 4.5)
	if mode != "kirppis":
		tilat.first("seura_" + mode, 0.3)


func _on_kirppis_exited() -> void:
	kirppis_int.leave()
	Sfx.play("door_close", -3.0)
	state = _kirppis_prev
	var to: Vector3 = world.kirppis_door
	player.global_position = Vector3(to.x, Terrain.h(to.x, to.z) + 0.3, to.z)
	player.controls_enabled = true
	player.activate_camera()
	_hazards.process_mode = Node.PROCESS_MODE_INHERIT


## Sulkemisaika: Hilkka ilmoittaa ja ohjaa ulos (ei heitetä heti).
func _kirppis_closing() -> void:
	if _seura_mode() == kirppis_int.mode or _talk_box.is_open() or kirppis_int.busy:
		return
	var bye := {"kirppis": "Kirpputori sulki ovensa. Tervetuloa huomenna uudestaan.",
		"bingo": "Bingo loppui. Mummot lähtee kotiin kinkkujensa kanssa.",
		"tanssit": "Saapasjalat soitti viimeisen valssin. Tanssit on ohi, valot syttyy."}
	_on_kirppis_exited()
	_show_message(bye.get(kirppis_int.mode, ""), 3.5)


func _on_kirppis_acted(kind: String) -> void:
	if kind == "takahuone":
		_talk_open("veksi", null)
		return
	if kind == "takaovi":
		_seura_ukot()
		kirppis_int.block_interact()
		return
	if kind == "poyta":
		_oma_poyta()
		kirppis_int.block_interact()
		return
	if not kind.begins_with("hlo"):
		return
	var who: String = KirppisInterior.PEOPLE[int(kind.substr(3))].id
	_talk_open(who, null)


## --- Seuraintalon tanssit ja bingo (#129) --------------------------------------------------------------------
const WEEKDAYS := ["maanantai", "tiistai", "keskiviikko", "torstai", "perjantai", "lauantai", "sunnuntai"]
const BINGO_OPEN := Vector2(18 * 60, 20 * 60)
const TANSSI_OPEN := Vector2(21 * 60, 60)  # yli puolenyön
const TANSSI_LIPPU := 8.0
const BINGO_LAPPU := 2.0
const SEURA_KAHVI := 2.0
const BINGO_PRIZES := [["kahvipaketti", "Kahvipaketti! Juhla Mokka, Päivi tykkää."], ["liina", "Virkkuuliina Hilkan pöydältä."],
	["lahjakortti", "K-Marketin lahjakortti, 10 €!"], ["kinkku", "JÄTTIPOTTI: joulukinkku! Mummot ei ikinä anna anteeks."]]
var _tanssi_paid_day := -1
var _danced := {}  # pari -> päivä
var _bingo_day := -1
var _ukot_day := -1


func _seura_options(who: String, o: Array) -> void:
	var mode: String = kirppis_int.mode
	if who == "raili":
		o.append(_opt("kahvi", "Kahvi ja munkki (%s €)" % _eur(SEURA_KAHVI), money >= SEURA_KAHVI, "rahat ei riitä"))
	if mode == "tanssit" and who in ["hilkka", "annaliisa", "sinikka_seura"]:
		var nm: String = TALKERS[who][0]
		o.append(_opt("tanssi", "Hae %s tanssiin" % nm, _danced.get(who, -1) != day, "tanssittu jo tänään", true))
	if mode == "bingo" and who == "huutaja":
		o.append(_opt("bingo", "Osta bingolappu (%s €)" % _eur(BINGO_LAPPU), money >= BINGO_LAPPU and _bingo_day != day,
			"tämän illan bingo pelattu" if _bingo_day == day else "rahat ei riitä", true))


func _seura_act(id: String) -> bool:
	match id:
		"kahvi":
			money -= SEURA_KAHVI
			tilat.add("vireys", 0.25)
			_eat(0.25)
			Sfx.play("coin", -6.0)
			_talk_box.reply("Tässä, kahvi ja lämmin munkki. Hillo on pohjalla.", _talk_options(), "Vireys ja nälkä paranee. Rahaa %s €." % _eur(money))
		"tanssi":
			var who := _talk_who
			_talk_box.close()
			_start_tanssi(who)
		"bingo":
			_talk_box.close()
			_start_bingo()
		_:
			return false
	return true


func _start_tanssi(who: String) -> void:
	_danced[who] = day
	kirppis_int.busy = true
	kirppis_int.walker.controls_enabled = false
	_hud.visible = false
	var g := TanssiGame.new()
	g.partner = who
	g.drunk = _hand_shake()
	g.interior = kirppis_int  # tanssitaan salin lattialla salin omien ihmisten kanssa
	g.finished.connect(func(score: float) -> void: _tanssi_done(who, score, g.quit))
	kirppis_int.add_child(g)


## Tanssin tulos: moraali ja maine, Sinikan kanssa Päivi kuulee, Anna-Liisa juoruaa varpaista.
func _tanssi_done(who: String, score: float, quit := false) -> void:
	kirppis_int.busy = false
	kirppis_int.walker.controls_enabled = true
	kirppis_int.walker.activate()
	kirppis_int.block_interact()
	_hud.visible = true
	if quit:
		_show_message("Lopetit tanssin kesken. Pari jäi seisomaan lattialle.", 3.0)
		return
	score = _drakkar_dance(score)
	var good := score >= 0.65
	tilat.first("tanssit", 0.3)
	if who != "sinikka_seura":
		_rikos_event("paivi_hyvitys", {"why": "tanssit"})
	if good:
		tilat.add("moraali", 0.2)
		tilat.add("stressi", 0.15)
		maine = clampf(maine + 3.0, 0.0, 100.0)
		_ending("tanssit")
	else:
		tilat.add("stressi", -0.05)
	match who:
		"sinikka_seura":
			_sinikka_flirt()  # Päivi kuulee siitä pian puhelimessa
			_show_message("Tanssi Sinikan kanssa (%d %%). %s" % [roundi(score * 100.0),
				"Sinikka hymyilee pitkään. Joku näki." if good else "Sinikka nauraa varpailleen. Joku näki silti."], 4.0)
		"annaliisa":
			_show_message("Tanssi Anna-Liisan kanssa (%d %%). %s" % [roundi(score * 100.0),
				"Anna-Liisa on niin hämillään, että unohtaa juoruta tänään." if good else "Anna-Liisa kertoo varpaistaan koko kylälle."], 4.0)
			if not good:
				maine = clampf(maine - 2.0, 0.0, 100.0)
		_:
			_show_message("Tanssi Hilkan kanssa (%d %%). %s" % [roundi(score * 100.0),
				"Hilkka: \"Niin sitä viiskytluvulla tanssittiin!\" Mummot taputtaa." if good else "Hilkka: \"Harjoittele, nuori mies.\""], 4.0)


func _start_bingo() -> void:
	money -= BINGO_LAPPU
	_bingo_day = day
	kirppis_int.busy = true
	kirppis_int.walker.controls_enabled = false
	_hud.visible = false
	CamCtl.free_mouse = true
	var g := BingoGame.new()
	g.drunk = _hand_shake()
	g.rival_at = randi_range(29, 41)  # tarkka merkitsijä ehtii ensin noin joka neljännellä illalla (simuloitu)
	g.interior = kirppis_int  # bingopöydässä salin mummojen kanssa
	g.finished.connect(func(won: bool, false_calls: int) -> void:
		CamCtl.free_mouse = false
		kirppis_int.busy = false
		kirppis_int.walker.controls_enabled = true
		kirppis_int.walker.activate()
		kirppis_int.block_interact()
		_hud.visible = true
		maine = clampf(maine - 2.0 * false_calls, 0.0, 100.0)
		if g.quit:
			_show_message("Lähdit kesken bingon.%s" % (" Väärät huudot nolottaa silti." if false_calls > 0 else ""), 3.0)
			return
		tilat.first("bingo", 0.3)
		if not won:
			_show_message("Mummo Elvi vei bingon.%s Ensi tiistaina uudestaan." % (" Ja väärät huudot nolottaa." if false_calls > 0 else ""), 3.5)
			return
		var prize: Array = BINGO_PRIZES[3] if randf() < 0.15 else BINGO_PRIZES[randi() % 3]
		match prize[0]:
			"kahvipaketti":
				tilat.add("vireys", 0.2)
				tilat.add("stressi", 0.1)
			"liina":
				tilat.add("moraali", 0.15)
			"lahjakortti":
				money += 10.0
			"kinkku":
				_ending("kinkku")
				tilat.add("moraali", 0.3)
				tilat.add("stressi", 0.3)
				maine = clampf(maine + 5.0, 0.0, 100.0)
		Sfx.play("win_small", -4.0)
		_show_message("BINGO! " + prize[1], 4.5)
		_save_game())
	kirppis_int.add_child(g)


## Tanssien takaovi: ukot ryyppäävät pihalla auton takakontilla. Huikka kerran illassa; Anna-Liisa voi nähdä.
func _seura_ukot() -> void:
	if _ukot_day == day:
		_show_message("Ukot: \"Ei enää, pullo on tyhjä. Mee tanssiin!\"", 2.5)
		return
	_ukot_day = day
	_drink(1)
	tilat.add("moraali", 0.1)
	Sfx.play("glass", -6.0)
	if randf() < 0.3:
		tilat.add("stressi", -0.1)
		_show_message("Takakontista huikka kossua. Anna-Liisa näki ikkunasta. Huomenna Päivi tietää.", 4.0)
	else:
		_show_message("Takakontista huikka kossua ukkojen kanssa. \"Nuorisoseuran talolla ei juoda!\" Hah.", 3.5)


func _kirppis_ask(k: String) -> float:
	var h: Dictionary = _haggle.get(k, {})
	if h.get("day", -1) != day:
		return KIRPPIS_STOCK[k].price
	return h.ask


## Tarjous: noin 60 % pyyntihinnasta puolen euron tarkkuudella, mutta ei alle 40 %:n tuotteen hinnasta.
func _kirppis_offer(k: String, ask: float) -> float:
	var floor_p: float = snappedf(KIRPPIS_STOCK[k].price * 0.4, 0.5)
	return maxf(floor_p, maxf(0.5, snappedf(ask * 0.6, 0.5)))


func _talk_kirppis(id: String) -> void:
	var who := _talk_who
	if id == "huuto":
		_talk_box.close()
		_start_auction()
		return
	if id == "korkit_poyta":
		var n: int = korkit.tuplat()
		korkit.take_tuplat(n)
		var tulo := snappedf(n * KORKKI_POYTA_HINTA, 0.05)
		money += tulo
		_advance_clock(20.0)
		Sfx.play("coin", -4.0)
		_talk_box.reply("Korkkeja? No, pikkupojat ostaa. Kymmenen senttiä kappale, ei enempää.", _talk_options(),
			"Myit %d tuplakorkkia pöydältä, +%s €. Kansion korkit jäivät." % [n, _eur(tulo)])
		return
	if id == "poyta_vuokraa" or id == "poyta_mene":
		if id == "poyta_vuokraa":
			money -= MYYNTI_PAIKKA
			_myynti_day = day
			Sfx.play("coin", -4.0)
		_talk_box.close()
		_start_myynti()
		return
	if _seura_act(id):
		return
	if id == "romu":
		_pannu_scrap()
		return
	if id == "ukko":
		ukko.heard = true
		tilat.first("ukko_legenda", 0.2)
		_save_game()
		_talk_box.reply("Tekojärvessä? No kuule. Mun isä kalasti siinä jo ennen patoa, kun se oli vielä peltoa ja Haapajärven "
			+ "latoja. Kun vesi nousi, ladon raunioille jäi asumaan hauki. Ukoksi sitä sanottiin. Se vei isältä uistimen joka "
			+ "kesä, ja kerran se kisko soutuveneen kaislikkoon. Kaikki nauraa. Mutta heitä virvelillä sinne, niin näet.",
			_talk_options(), "Legenda: Tekojärven Ukko. Haapajärven tekojärvi on kylän eteläpuolella, Kaitasaari keskellä.")
		return
	if id == "kanttori_legenda":
		_talk_kanttori(id)
		return
	if id == "olavi_legenda":
		olavi.heard = true
		tilat.first("olavi_legenda", 0.2)
		_save_game()
		_talk_box.reply("Markkinat? No kuule. Saloinen sai vuonna 1616 vapaat markkinat Olavinpäivästä kahdeksi viikoksi. Kauppiaita tuli "
			+ "joka kaupungista, talonpojat myi tervaa ja voita. Kun Raahe perustettiin, markkinat vietiin sinne. Yksi saloislainen "
			+ "kauppias ei suostunut: kätki markkinarahansa ja vannoi, että markkinat palaa, kun hopea löytyy. Olavinpäivän yönä "
			+ "Kirkkoluodontiellä kulkee lyhty. Käy Pirtissä kyselemässä kirjeitä.", _talk_options(),
			"Legenda: Olavinmarkkinoiden hopea. Kysy kauppiaan kirjettä Saloisten Pirtistä.")
		return
	if id == "aarnivalkea":
		aarni.heard = true
		tilat.first("aarni_legenda", 0.2)
		_save_game()
		_talk_box.reply("Lapinraunio? No kuule. Mun mummo kertoi: Isonvihan aikaan, kun kasakat tuli, talolliset kätki hopeansa "
			+ "raunion lähelle. Ja sen jälkeen siellä on palanu öisin aarnivalkea, sininen liekki aarteen päällä. Kaikki nauraa, "
			+ "mutta mää näin sen kerran tyttönä. Mene yöllä kattomaan, jos uskallat.", _talk_options(),
			"Legenda: Lapinraunion aarnivalkea. Raunio on Kiilinlammen pohjoispuolella. Yöllä (22–4) kannattaa käydä.")
		return
	if id == "markat":
		tokola.markat = false
		money += TOKOLA_MARKAT
		Sfx.play("coin", -4.0)
		_save_game()
		_talk_box.reply("Kuusikymmentäluvun markkoja, kauppiaan leimalla! Keräilijät maksaa näistä. Mistä sää nää sait?",
			_talk_options(), "+%s €. Rahaa %s €." % [_eur(TOKOLA_MARKAT), _eur(money)])
		return
	if id.begins_with("osta_"):
		var k := id.trim_prefix("osta_")
		var ask := _kirppis_ask(k)
		money -= ask
		_kirppis_sold[k] = day
		_haggle.erase(k)
		Sfx.play("coin", -4.0)
		_talk_box.reply(["Kiitos kaupasta!", "Hyvä ostos, usko pois.", "Tuu toistekin!"].pick_random(), _talk_options(),
			_kirppis_give(k) + "   Rahaa %s €." % _eur(money))
		_save_game()
		return
	if id.begins_with("tingi_"):
		var k := id.trim_prefix("tingi_")
		var ask := _kirppis_ask(k)
		var offer := _kirppis_offer(k, ask)
		var h: Dictionary = _haggle.get(k, {})
		if h.get("day", -1) != day:
			h = {"ask": ask, "patience": 2 + int(maine / 40.0), "day": day, "deals": 0}
		# Maine kovana jätkänä auttaa, Tauno joustaa sähköpyörän rakentajalle; jokainen myönnytys tekee seuraavasta
		# vaikeamman, eikä alle 40 %:n mennä.
		var chance := (0.2 + maine / 150.0 + (0.15 if who == "tauno" and ebike.started else 0.0)) * pow(0.5, h.deals)
		if offer >= ask - 0.001:
			chance = 0.0
		if randf() < chance:
			h.deals += 1
			h.ask = offer
			_haggle[k] = h
			tilat.first("tinkiminen", 0.2)
			_talk_box.reply(["No olkoon, %s euroa. Ryöstöä, mutta olkoon." % _eur(offer),
				"Hmph. %s euroa sitten. Älä kerro muille." % _eur(offer)].pick_random(), _talk_options())
		else:
			h.patience -= 1
			if h.patience <= 0:
				_kirppis_angry[who] = day
				_haggle.erase(k)
				_talk_box.reply("Nyt riittää! Ei myydä sulle tänään mitään tinkimällä. Täyteen hintaan kyllä.", _talk_options())
			else:
				h.ask = maxf(offer, snappedf((ask + offer) / 2.0, 0.5))
				_haggle[k] = h
				_talk_box.reply("Ei käy. %s euroa, ja se on viimeinen hinta. Melkein." % _eur(h.ask), _talk_options())
		if randf() < 0.35:
			kirppis_int.say_id("annaliisa", ["Kyllä mää kerron Päiville, että sää tingit mummoilta.",
				"Pihi kuin Pekka, ja Pekka on pihi.", "Hah! Ei se tollasella tarjouksella."].pick_random())
		return


## Kalastusvälineet myydään vain kerran (omistettuna pois hyllystä); Taunon isän lusikka vasta, kun Ukon legenda
## on kuultu ja vihjeitä on tarpeeksi (ukko_legenda.gd clues).
func _kirppis_hidden(k: String) -> bool:
	match k:
		"virveli":
			return has_virveli
		"bambuonki":
			return has_onki
		"lusikka":
			return ukko.lusikka or not ukko.heard or not ukko.clues()
		"drakkar":
			return drakkar > 0  # uusi pullo Railin pöydälle, kun edellinen on loppu
		"haalari":
			return has_haalari
		"slabarit":
			return has_slabarit
		"terva", "voi", "makkara":
			return not (_markkinat_paiva() and _between(clock_min, MARKKINA_OPEN))
	return false


## Ostettu tavara käyttöön: palauttaa lisätiedon keskusteluikkunaan.
