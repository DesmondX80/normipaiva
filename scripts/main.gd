var _race: Node3D
var _race_bet := 0.0
var _race_wins := 0


func _start_race(bet: float, big: bool) -> void:
	if _race != null or money < bet:
		return
	var vl: Node3D = mopo_trip.vaala
	var track: Array[Vector3] = vl.race_track()
	if track.size() < 2:
		_show_message("Suora on tänään täynnä rekkoja. Ei kisata.", 2.5)
