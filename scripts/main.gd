				if ka.wait_t <= 0.0:
					ka.say("No, eipä tänään kauppa käy. Ensi kertaan!")
					ka.leave()
					return
			if near and _hint.text == "" and not player.is_stunned():
				_talk_hint("kauppa_auto", ka.seller)


